---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Direction 4 — Warm Lifestyle | GoAustralia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: #fff; color: #18181b; -webkit-font-smoothing: antialiased; }
    a { text-decoration: none; color: inherit; }
    .shell { max-width: 1100px; margin: 0 auto; padding: 0 40px; }

    .back-bar { background: rgba(0,0,0,0.5); padding: 9px 40px; font-size: 13px; position: relative; z-index: 20; }
    .back-bar a { color: rgba(255,255,255,0.6); display: inline-flex; align-items: center; gap: 5px; }
    .back-bar a:hover { color: #fff; }

    /* HERO — photo first */
    .hero-wrap { position: relative; }
    nav { position: absolute; top: 0; left: 0; right: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 20px 40px; }
    .logo { font-size: 1rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 7px; }
    .nav-links { display: flex; align-items: center; gap: 20px; }
    .nav-links a { font-size: 13px; color: rgba(255,255,255,0.7); font-weight: 400; }
    .nav-links a:hover { color: #fff; }
    .nav-cta { background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.25); color: #fff !important; font-size: 13px; font-weight: 500; padding: 8px 18px; border-radius: 20px; }

    .hero { height: 540px; position: relative; overflow: hidden; display: flex; align-items: flex-end; }
    .hero-bg { position: absolute; inset: 0; background: linear-gradient(160deg, #1a3d2b 0%, #2d6a4f 30%, #40916c 65%, #74c69d 100%); }
    .hero-bg::before { content:''; position:absolute; inset:0; background: radial-gradient(ellipse at 20% 30%, rgba(255,255,255,0.06) 0%, transparent 60%), radial-gradient(ellipse at 80% 70%, rgba(0,0,0,0.15) 0%, transparent 50%); }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0.1) 100%); }
    .hero-content { position: relative; z-index: 2; padding: 0 40px 44px; width: 100%; display: grid; grid-template-columns: 1fr 200px; gap: 24px; align-items: flex-end; }
    .hero-text { }
    .hero-eye { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px; }
    .hero h1 { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 800; color: #fff; line-height: 1.1; max-width: 580px; margin-bottom: 14px; }
    .hero-sub { font-size: 1rem; color: rgba(255,255,255,0.7); max-width: 480px; line-height: 1.6; margin-bottom: 24px; font-weight: 300; }
    .hero-btns { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .btn-white { background: #fff; color: #1a3d2b; font-size: 14px; font-weight: 600; padding: 12px 26px; border-radius: 6px; }
    .btn-ghost { font-size: 14px; color: rgba(255,255,255,0.75); display: flex; align-items: center; gap: 6px; }

    /* Social proof float */
    .social-proof { background: rgba(255,255,255,0.1); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 16px; }
    .sp-label { font-size: 10px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
    .sp-faces { display: flex; margin-bottom: 8px; }
    .sp-face { width: 28px; height: 28px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); margin-left: -8px; }
    .sp-face:first-child { margin-left: 0; }
    .sp-stat { font-size: 1rem; font-weight: 700; color: #fff; }
    .sp-sub { font-size: 11px; color: rgba(255,255,255,0.45); }

    /* INTRO STRIP */
    .intro { background: #f9f9f7; border-bottom: 1px solid #eee; padding: 20px 0; }
    .intro-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
    .intro-stat { text-align: center; flex: 1; }
    .intro-stat strong { display: block; font-size: 1.2rem; font-weight: 700; color: #1a3d2b; }
    .intro-stat span { font-size: 11px; color: #9ca3af; margin-top: 2px; display: block; }
    .intro-divider { width: 1px; height: 32px; background: #e5e5e0; flex-shrink: 0; }

    /* FEATURED STORY */
    .featured { padding: 52px 0 0; }
    .featured-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; margin-bottom: 40px; }
    .feat-img { height: 340px; border-radius: 10px; overflow: hidden; position: relative; }
    .feat-img-bg { position: absolute; inset: 0; background: linear-gradient(160deg, #0f2745, #18528f); }
    .feat-img-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent); }
    .feat-img-tag { background: #16a34a; color: #fff; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 3px 8px; border-radius: 3px; display: inline-block; margin-bottom: 6px; }
    .feat-img-caption { font-size: 12px; color: rgba(255,255,255,0.65); }
    .feat-content { }
    .feat-eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #40916c; margin-bottom: 12px; }
    .feat-content h2 { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-weight: 800; color: #18181b; line-height: 1.2; margin-bottom: 14px; }
    .feat-content p { font-size: 15px; color: #6b7280; line-height: 1.7; margin-bottom: 20px; font-weight: 300; }
    .feat-author { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .feat-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #a8edea, #fed6e3); flex-shrink: 0; }
    .feat-author-name { font-size: 13px; font-weight: 600; color: #18181b; }
    .feat-author-meta { font-size: 11px; color: #9ca3af; }
    .read-btn { display: inline-flex; align-items: center; gap: 8px; background: #18181b; color: #fff; font-size: 14px; font-weight: 500; padding: 12px 22px; border-radius: 6px; }

    /* STORY GRID */
    .stories { padding: 0 0 52px; }
    .stories-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #9ca3af; margin-bottom: 20px; }
    .stories-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .story-card { border-radius: 10px; overflow: hidden; border: 1px solid #f0f0ef; }
    .story-img { height: 150px; }
    .story-body { padding: 18px; }
    .story-kicker { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #40916c; margin-bottom: 8px; display: block; }
    .story-body h3 { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: #18181b; line-height: 1.3; margin-bottom: 8px; }
    .story-body p { font-size: 13px; color: #6b7280; line-height: 1.5; }
    .story-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; }
    .story-meta { font-size: 11px; color: #9ca3af; }
    .story-link { font-size: 12px; font-weight: 600; color: #40916c; }

    /* TOOLS */
    .tools-section { background: #f9f9f7; border-top: 1px solid #eee; padding: 48px 0; }
    .tools-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 28px; }
    .tools-head h2 { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 800; color: #18181b; }
    .tools-head a { font-size: 13px; color: #40916c; font-weight: 500; }
    .tools-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .tool-item { background: #fff; border: 1px solid #eee; border-radius: 8px; padding: 20px; }
    .tool-item:hover { border-color: #d1fae5; }
    .tool-icon { font-size: 1.4rem; margin-bottom: 10px; }
    .tool-item h3 { font-size: 14px; font-weight: 600; color: #18181b; margin-bottom: 5px; }
    .tool-item p { font-size: 12px; color: #9ca3af; line-height: 1.5; }
    .tool-item a { display: inline-block; margin-top: 10px; font-size: 12px; font-weight: 600; color: #40916c; }

    /* SUBSCRIBE */
    .subscribe { padding: 56px 0; }
    .subscribe-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    .subscribe h2 { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 800; color: #18181b; margin-bottom: 10px; }
    .subscribe p { color: #6b7280; font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; }
    .sub-list { list-style: none; display: flex; flex-direction: column; gap: 9px; margin-bottom: 24px; }
    .sub-list li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #374151; }
    .sub-list li::before { content: '✓'; color: #40916c; font-weight: 700; }
    .sub-price { font-size: 2rem; font-weight: 700; color: #1a3d2b; margin-bottom: 4px; }
    .sub-price span { font-size: 0.95rem; font-weight: 400; color: #9ca3af; }
    .sub-form { background: #f9f9f7; border-radius: 12px; padding: 28px; }
    .sub-form h3 { font-size: 0.95rem; font-weight: 700; color: #18181b; margin-bottom: 18px; }
    .sub-input { width: 100%; border: 1px solid #e5e5e0; border-radius: 6px; padding: 12px 14px; font-size: 14px; font-family: 'DM Sans', sans-serif; outline: none; margin-bottom: 10px; }
    .sub-input:focus { border-color: #40916c; }
    .sub-btn { display: block; width: 100%; background: #1a3d2b; color: #fff; text-align: center; font-size: 15px; font-weight: 600; padding: 14px; border-radius: 6px; }
    .sub-terms { font-size: 11px; color: #9ca3af; text-align: center; margin-top: 10px; }

    /* FOOTER */
    footer { background: #1a1a18; padding: 48px 0; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
    .footer-brand { font-size: 1rem; font-weight: 700; color: rgba(255,255,255,0.7); margin-bottom: 8px; }
    .footer-desc { font-size: 12px; color: rgba(255,255,255,0.25); line-height: 1.6; }
    .footer-col h4 { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.25); margin-bottom: 14px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-col a { font-size: 13px; color: rgba(255,255,255,0.3); }
    .footer-col a:hover { color: rgba(255,255,255,0.65); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding-top: 20px; }
    .footer-bottom p { font-size: 11px; color: rgba(255,255,255,0.15); }

    @media (max-width: 760px) {
      .hero h1 { font-size: 2rem; }
      .hero-content { grid-template-columns: 1fr; }
      .social-proof { display: none; }
      .featured-inner, .subscribe-inner { grid-template-columns: 1fr; }
      .stories-grid, .tools-grid { grid-template-columns: 1fr 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      nav { position: relative; }
      .hero-wrap .back-bar { position: relative; }
    }
  </style>
</head>
<body>

<div class="hero-wrap">
  <div class="back-bar"><a href="/designs">← Back to all designs</a></div>

  <nav>
    <div class="logo">🦘 GoAustralia</div>
    <div class="nav-links">
      <a href="#">Visa Tools</a>
      <a href="#">Guides</a>
      <a href="#">Suburbs</a>
      <a href="#">Blog</a>
    </div>
    <a href="#" class="nav-cta">Get Access</a>
  </nav>

  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-eye">For New Zealanders moving to Australia</div>
        <h1>The move you've<br/>been thinking about.</h1>
        <p class="hero-sub">Visa, tax, renting, jobs, suburbs — all of it, in one place. Built by Kiwis who've already made the leap.</p>
        <div class="hero-btns">
          <a href="#" class="btn-white">Get the full guide →</a>
          <a href="#" class="btn-ghost">Browse free tools →</a>
        </div>
      </div>
      <div class="social-proof">
        <div class="sp-label">Kiwis helped</div>
        <div class="sp-faces">
          <div class="sp-face" style="background:linear-gradient(135deg,#fbc2eb,#a18cd1);"></div>
          <div class="sp-face" style="background:linear-gradient(135deg,#a1c4fd,#c2e9fb);"></div>
          <div class="sp-face" style="background:linear-gradient(135deg,#fd7043,#ff8a65);"></div>
          <div class="sp-face" style="background:linear-gradient(135deg,#abecd6,#fbed96);"></div>
        </div>
        <div class="sp-stat">12,400+</div>
        <div class="sp-sub">rated us 4.9 / 5 ★</div>
      </div>
    </div>
  </div>
</div>

<div class="intro">
  <div class="shell intro-inner">
    <div class="intro-stat"><strong>12,400+</strong><span>Kiwis helped</span></div>
    <div class="intro-divider"></div>
    <div class="intro-stat"><strong>4.9 / 5</strong><span>Average rating</span></div>
    <div class="intro-divider"></div>
    <div class="intro-stat"><strong>3 PDF guides</strong><span>Step-by-step</span></div>
    <div class="intro-divider"></div>
    <div class="intro-stat"><strong>$1.99 /mo</strong><span>Full access</span></div>
    <div class="intro-divider"></div>
    <div class="intro-stat"><strong>Updated</strong><span>Weekly</span></div>
  </div>
</div>

<section class="featured">
  <div class="shell">
    <div class="featured-inner">
      <div class="feat-img">
        <div class="feat-img-bg"></div>
        <div class="feat-img-overlay">
          <span class="feat-img-tag">Featured</span>
          <div class="feat-img-caption">Photography: Sydney Harbour, NSW</div>
        </div>
      </div>
      <div class="feat-content">
        <div class="feat-eyebrow">Visa & Immigration · 2025 Guide</div>
        <h2>The Complete Guide to Moving from New Zealand to Australia</h2>
        <p>Most Kiwis don't realise the Special Category Visa gives them less than they think — until they need Medicare or try to sponsor a family member. Here's what you actually get, and how to get more.</p>
        <div class="feat-author">
          <div class="feat-avatar"></div>
          <div>
            <div class="feat-author-name">GoAustralia Editorial</div>
            <div class="feat-author-meta">Updated May 2025 · 12 min read</div>
          </div>
        </div>
        <a href="#" class="read-btn">Read the guide →</a>
      </div>
    </div>

    <div class="stories">
      <div class="stories-label">More from the blog</div>
      <div class="stories-grid">
        {[
          {kicker:'Real Story', title:'"We moved to Brisbane with $8k — here\'s what happened"', desc:'Sarah and James share everything — what they planned, what surprised them, and what they\'d do differently.', img:'linear-gradient(135deg,#431407,#9a3412)'},
          {kicker:'Tax & Finance', title:'Your TFN, super & first tax return in plain English', desc:'Everything NZ arrivals need to know before their first Australian pay slip.', img:'linear-gradient(135deg,#1e1b4b,#312e81)'},
          {kicker:'Renting', title:'How to rent in Australia without local rental history', desc:'The market is competitive. Here\'s how Kiwis get ahead of it before they even land.', img:'linear-gradient(135deg,#14532d,#065f46)'},
        ].map(s=>(
          <div class="story-card">
            <div class="story-img" style={`background:${s.img};`}></div>
            <div class="story-body">
              <span class="story-kicker">{s.kicker}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <div class="story-footer">
                <span class="story-meta">May 2025 · 5 min</span>
                <span class="story-link">Read →</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="tools-section">
  <div class="shell">
    <div class="tools-head">
      <h2>Free tools to plan your move</h2>
      <a href="#">See all tools →</a>
    </div>
    <div class="tools-grid">
      {[
        {icon:'🛂', title:'Visa Checker', desc:'Confirm your pathway in seconds — free, no signup'},
        {icon:'💰', title:'Cost Calculator', desc:'Full moving cost estimate — shipping, bond, living'},
        {icon:'📋', title:'Moving Checklist', desc:'70-step tracker from notice to first day in Aus'},
        {icon:'🏘️', title:'Suburb Finder', desc:'Compare 200+ suburbs on cost, commute & schools'},
      ].map(t=>(
        <div class="tool-item">
          <div class="tool-icon">{t.icon}</div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
          <a href="#">Use free →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="subscribe">
  <div class="shell subscribe-inner">
    <div>
      <h2>Everything for $1.99/month</h2>
      <p>All guides, all tools, weekly newsletter. The most affordable moving resource for Kiwis.</p>
      <div class="sub-price">$1.99 <span>/ month NZD</span></div>
      <ul class="sub-list">
        <li>All 3 PDF guides — download instantly</li>
        <li>Full access to all tools and calculators</li>
        <li>70-step interactive moving checklist</li>
        <li>Weekly policy updates & tips</li>
      </ul>
    </div>
    <div>
      <div class="sub-form">
        <h3>Create your account</h3>
        <input type="email" placeholder="Your email address" class="sub-input" />
        <input type="password" placeholder="Choose a password" class="sub-input" />
        <a href="#" class="sub-btn">Start for $1.99/month →</a>
        <div class="sub-terms">Secure payment via Stripe · Cancel anytime</div>
      </div>
    </div>
  </div>
</section>

<footer><div class="shell">
  <div class="footer-grid">
    <div>
      <div class="footer-brand">🦘 GoAustralia</div>
      <div class="footer-desc">Independent resource for New Zealanders moving to Australia. Not affiliated with any government.</div>
    </div>
    <div class="footer-col"><h4>Tools</h4><ul>{['Visa Checker','Cost Calculator','Checklist','Suburb Finder'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
    <div class="footer-col"><h4>Guides</h4><ul>{['All Guides','Tax & Finance','Renting','Jobs'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
    <div class="footer-col"><h4>Site</h4><ul>{['About','Pricing','Privacy','Contact'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
  </div>
  <div class="footer-bottom"><p>© 2025 GoAustralia.co.nz — Independent, not part of any government.</p></div>
</div></footer>

</body>
</html>
