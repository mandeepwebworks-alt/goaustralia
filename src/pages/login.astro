---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Log In — GoAustralia.co.nz" description="Log in to access your moving guides, suburb finder and full checklist.">
<style is:global>
  /* ── LOGIN PAGE ── */
  .login-wrap {
    min-height: calc(100vh - 250px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 48px 16px 64px;
    background: var(--surface);
  }
  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 36px 32px;
    box-shadow: 0 4px 20px rgba(0,32,92,0.07);
  }
  .login-logo {
    text-align: center;
    margin-bottom: 24px;
  }
  .login-logo-eye {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--blue);
    display: block;
    margin-bottom: 2px;
  }
  .login-logo-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .login-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--navy);
    text-align: center;
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }
  .login-subtitle {
    font-size: 13px;
    color: var(--txt3);
    text-align: center;
    margin-bottom: 28px;
  }
  .login-field {
    margin-bottom: 14px;
  }
  .login-field label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: var(--txt3);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 5px;
  }
  .login-input {
    width: 100%;
    border: 1.5px solid var(--border);
    border-radius: 4px;
    padding: 11px 13px;
    font-size: 14px;
    color: var(--txt);
    background: var(--white);
    outline: none;
    transition: border-color 0.12s;
  }
  .login-input:focus {
    border-color: var(--blue);
    outline: 3px solid rgba(0,94,165,0.15);
    outline-offset: 0;
  }
  .login-forgot {
    text-align: right;
    margin-top: -8px;
    margin-bottom: 20px;
  }
  .login-forgot a {
    font-size: 12px;
    color: var(--blue);
  }
  .login-forgot a:hover {
    text-decoration: underline;
  }
  .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
    color: var(--txt3);
    font-size: 12px;
  }
  .login-divider::before,
  .login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-lt);
  }
  .login-secondary {
    text-align: center;
  }
  .login-secondary a {
    font-size: 14px;
    color: var(--blue);
    font-weight: 600;
  }
  .login-secondary a:hover {
    text-decoration: underline;
  }
  .login-disclaimer {
    text-align: center;
    margin-top: 28px;
    font-size: 11px;
    color: var(--txt3);
    line-height: 1.6;
  }
</style>

<!-- PAGE HERO (minimal) -->
<section class="page-hero" style="padding: 24px 0 20px;">
  <div class="shell">
    <div class="breadcrumb"><a href="/">← Back to home</a></div>
  </div>
</section>

<!-- LOGIN FORM -->
<div class="login-wrap">
  <div>
    <div class="login-card">
      <div class="login-logo">
        <span class="login-logo-eye">GoAustralia.co.nz</span>
        <span class="login-logo-name">Moving Guides for Kiwis</span>
      </div>

      <h1 class="login-title">Welcome back</h1>
      <p class="login-subtitle">Log in to access your guides and tools</p>

      <form method="post" action="/api/login" novalidate>
        <div class="login-field">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            class="login-input"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
        </div>

        <div class="login-field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            class="login-input"
            placeholder="Your password"
            autocomplete="current-password"
            required
          />
        </div>

        <div class="login-forgot">
          <a href="/forgot-password">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          Log in
        </button>
      </form>

      <div class="login-divider">or</div>

      <div class="login-secondary">
        <a href="/signup">Create an account →</a>
      </div>
    </div>

    <p class="login-disclaimer">
      GoAustralia.co.nz — independent resource, not affiliated with any government
    </p>
  </div>
</div>

</Layout>
