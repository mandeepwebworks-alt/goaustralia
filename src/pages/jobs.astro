    tags: ["QCT registration", "Relocation support", "Faith-based school"],
    desc: "We're seeking experienced Maths/Science teachers from NZ. QLD Teacher Registration (QCT) is required but your NZ qualifications are fully recognised.",
    url: "https://www.seek.com.au"
  },
  // Finance & Accounting
  {
    id: 12, title: "Senior Accountant — Tax", company: "KPMG Australia", logo: "KP",
    location: "Melbourne, VIC", state: "VIC", salary: "$90,000 – $120,000 AUD", type: "Full-time",
    industry: "Finance", posted: "2 days ago", featured: false,
    tags: ["CA/CPA required", "NZ experience valued", "Big 4"],
