    url: "https://www.seek.com.au"
  },
  // Hospitality
  {
    id: 14, title: "Executive Chef", company: "Crown Resorts", logo: "CR",
    location: "Melbourne, VIC", state: "VIC", salary: "$95,000 – $125,000 AUD", type: "Full-time",
