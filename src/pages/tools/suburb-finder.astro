---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Australian Suburb Finder for Kiwis — GoAustralia.co.nz"
  description="Compare Australian suburbs on rent, commute, lifestyle and Kiwi community. Find the best suburb for your move from New Zealand."
>

<div class="page-hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">Home</a> › <a href="/tools/visa-checker">Tools</a> › Suburb Finder</div>
    <h1>Suburb Finder</h1>
    <p class="page-hero-sub">Compare Australian suburbs on rent, commute, lifestyle and Kiwi community — find your perfect base.</p>
  </div>
</div>

<!-- Filters Band -->
<div class="sf-filters-band">
  <div class="shell">
    <div class="sf-filters-inner">
      <div class="sf-filter-group">
        <label class="sf-filter-label" for="f-city">City</label>
        <select class="field-input field-select sf-select" id="f-city">
          <option value="all">All cities</option>
          <option value="Sydney">Sydney</option>
          <option value="Melbourne">Melbourne</option>
          <option value="Brisbane">Brisbane</option>
          <option value="Perth">Perth</option>
          <option value="Adelaide">Adelaide</option>
        </select>
      </div>
      <div class="sf-filter-group">
        <label class="sf-filter-label" for="f-budget">Weekly rent (AUD)</label>
        <select class="field-input field-select sf-select" id="f-budget">
          <option value="all">Any budget</option>
          <option value="under450">Under $450</option>
          <option value="450-600">$450–$600</option>
          <option value="600-800">$600–$800</option>
          <option value="800plus">$800+</option>
        </select>
      </div>
      <div class="sf-filter-group">
        <label class="sf-filter-label" for="f-lifestyle">Lifestyle</label>
        <select class="field-input field-select sf-select" id="f-lifestyle">
          <option value="all">Any lifestyle</option>
          <option value="city">City centre</option>
          <option value="inner">Inner suburbs</option>
          <option value="family">Family-friendly</option>
          <option value="beach">Beach</option>
          <option value="quiet">Quiet/affordable</option>
        </select>
      </div>
      <button class="btn btn-primary sf-btn" id="sf-search-btn">Show Suburbs →</button>
    </div>
  </div>
</div>

<!-- Results Table -->
<div class="section">
  <div class="shell">
    <div class="sf-results-header">
      <span class="sf-results-count" id="sf-results-count">Showing all 20 suburbs</span>
      <span class="sf-results-hint">Click a column header to sort</span>
    </div>

    <div class="sf-table-wrap">
      <table class="sf-table" id="sf-table">
        <thead>
          <tr>
            <th class="sortable" data-col="suburb">Suburb <span class="sort-arrow">↕</span></th>
            <th class="sortable" data-col="city">City <span class="sort-arrow">↕</span></th>
            <th class="sortable" data-col="rent">Weekly Rent <span class="sort-arrow">↕</span></th>
            <th class="sortable" data-col="commute">Train to CBD <span class="sort-arrow">↕</span></th>
            <th>Vibe</th>
            <th class="sortable" data-col="kiwi">Kiwi Score <span class="sort-arrow">↕</span></th>
            <th></th>
          </tr>
        </thead>
        <tbody id="sf-tbody">
          <!-- Rows injected by JS from data below -->
        </tbody>
      </table>
    </div>

    <div class="sf-no-results" id="sf-no-results" style="display:none">
      <p>No suburbs match your current filters. Try widening your search.</p>
    </div>

  </div>
</div>

<!-- Spotlight Cards -->
<div class="section section-alt">
  <div class="shell">
    <div class="sec-eye">Featured Picks</div>
    <h2 class="sec-h2">Top Suburb Spotlights for Kiwis</h2>
    <p class="sec-sub">Three of the most popular choices for New Zealanders — a beach lifestyle, family favourite and inner-city option.</p>

    <div class="spotlight-grid">

      <div class="spotlight-card">
        <div class="spotlight-badge beach">Beach & Lifestyle</div>
        <h3 class="spotlight-name">Manly, Sydney</h3>
        <div class="spotlight-rent">$750–$900 / week</div>
        <div class="spotlight-stars" aria-label="Kiwi score 5 out of 5">★★★★★</div>
        <div class="spotlight-divider"></div>
        <div class="spotlight-row">
          <span class="spotlight-label">Commute to CBD</span>
          <span class="spotlight-val">30 min (ferry)</span>
        </div>
        <div class="spotlight-row">
          <span class="spotlight-label">Best for</span>
          <span class="spotlight-val">Surfers, outdoor lovers, young professionals</span>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title">Pros</p>
          <ul class="spotlight-list">
            <li>Iconic beach lifestyle — surfing, coastal walks</li>
            <li>Strong Kiwi community, very welcoming</li>
            <li>Great cafés, restaurants and nightlife</li>
            <li>Feels like home for most Kiwis</li>
          </ul>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title cons">Cons</p>
          <ul class="spotlight-list cons-list">
            <li>Among the priciest suburbs in Sydney</li>
            <li>Ferry-dependent — can be slow in bad weather</li>
          </ul>
        </div>
      </div>

      <div class="spotlight-card">
        <div class="spotlight-badge family">Family-Friendly</div>
        <h3 class="spotlight-name">Box Hill, Melbourne</h3>
        <div class="spotlight-rent">$420–$520 / week</div>
        <div class="spotlight-stars" aria-label="Kiwi score 4 out of 5">★★★★☆</div>
        <div class="spotlight-divider"></div>
        <div class="spotlight-row">
          <span class="spotlight-label">Commute to CBD</span>
          <span class="spotlight-val">35 min (train)</span>
        </div>
        <div class="spotlight-row">
          <span class="spotlight-label">Best for</span>
          <span class="spotlight-val">Families, first-time renters, good value</span>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title">Pros</p>
          <ul class="spotlight-list">
            <li>Great value for a Melbourne suburb</li>
            <li>Good schools and family amenities</li>
            <li>Large parks and green spaces nearby</li>
            <li>Multicultural food scene — excellent dining</li>
          </ul>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title cons">Cons</p>
          <ul class="spotlight-list cons-list">
            <li>Less of a Kiwi concentration than coastal areas</li>
            <li>Busy main road traffic</li>
          </ul>
        </div>
      </div>

      <div class="spotlight-card">
        <div class="spotlight-badge city">Inner City</div>
        <h3 class="spotlight-name">South Brisbane, Brisbane</h3>
        <div class="spotlight-rent">$500–$650 / week</div>
        <div class="spotlight-stars" aria-label="Kiwi score 4 out of 5">★★★★☆</div>
        <div class="spotlight-divider"></div>
        <div class="spotlight-row">
          <span class="spotlight-label">Commute to CBD</span>
          <span class="spotlight-val">8 min (bus/walk)</span>
        </div>
        <div class="spotlight-row">
          <span class="spotlight-label">Best for</span>
          <span class="spotlight-val">Young professionals, city lifestyle lovers</span>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title">Pros</p>
          <ul class="spotlight-list">
            <li>Walkable to CBD — South Bank, galleries, river</li>
            <li>Excellent dining and bar scene</li>
            <li>More affordable than Sydney equivalent</li>
            <li>Fast-growing area with good investment potential</li>
          </ul>
        </div>
        <div class="spotlight-section">
          <p class="spotlight-section-title cons">Cons</p>
          <ul class="spotlight-list cons-list">
            <li>Traffic congestion getting worse</li>
            <li>Limited green space within the suburb itself</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Upgrade CTA -->
<div class="section">
  <div class="shell">
    <div class="sf-upgrade-card">
      <div class="sf-upgrade-left">
        <div class="sec-eye">Full Access</div>
        <h2 class="sec-h2">Want suburb-by-suburb details?</h2>
        <p class="sec-sub" style="margin-bottom:0">Full Access unlocks school ratings, transport maps, rental trend charts, Kiwi community density data and side-by-side suburb comparisons for every major Australian city.</p>
      </div>
      <div class="sf-upgrade-right">
        <div class="sf-upgrade-price">$1.99<span>/month</span></div>
        <ul class="feature-list" style="margin-bottom:20px">
          <li>School ratings by suburb</li>
          <li>Rental trend charts (3 years)</li>
          <li>Kiwi community density maps</li>
          <li>Side-by-side suburb compare</li>
          <li>Printable suburb fact sheets</li>
        </ul>
        <a href="/pricing" class="btn btn-primary btn-block">View Full Access Plans</a>
      </div>
    </div>
  </div>
</div>

<!-- CTA Band -->
<div class="cta-band">
  <div class="shell">
    <h2>Ready to find your perfect Aussie suburb?</h2>
    <p>Get the complete suburb guide with school ratings, rental data and Kiwi community scores for every suburb.</p>
    <a href="/pricing" class="cta-band-btn">Get Full Access — $1.99/month</a>
  </div>
</div>

</Layout>

<style is:global>

/* ── FILTERS BAND ── */
.sf-filters-band {
  background: var(--blue-tint);
  border-bottom: 1px solid #b8d4f0;
  padding: 22px 0;
}
.sf-filters-inner {
  display: flex;
  align-items: flex-end;
  gap: 16px;
  flex-wrap: wrap;
}
.sf-filter-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
  min-width: 160px;
}
.sf-filter-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--navy);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}
.sf-select {
  background-color: var(--white);
  min-width: 160px;
}
.sf-btn {
  height: 42px;
  padding: 0 28px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── RESULTS HEADER ── */
.sf-results-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  flex-wrap: wrap;
  gap: 8px;
}
.sf-results-count {
  font-size: 14px;
  font-weight: 600;
  color: var(--navy);
}
.sf-results-hint {
  font-size: 12px;
  color: var(--txt3);
}

/* ── TABLE ── */
.sf-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border-lt);
  border-radius: 6px;
}
.sf-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.sf-table thead th {
  background: var(--surface);
  padding: 12px 14px;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  color: var(--txt3);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  border-bottom: 1px solid var(--border-lt);
  white-space: nowrap;
}
.sf-table thead th.sortable {
  cursor: pointer;
  user-select: none;
}
.sf-table thead th.sortable:hover {
  color: var(--blue);
}
.sf-table thead th.sort-asc .sort-arrow::after { content: '↑'; }
.sf-table thead th.sort-desc .sort-arrow::after { content: '↓'; }
.sort-arrow {
  color: var(--border);
  margin-left: 3px;
}
.sf-table tbody tr {
  border-bottom: 1px solid var(--border-lt);
  transition: background 0.1s;
}
.sf-table tbody tr:last-child {
  border-bottom: none;
}
.sf-table tbody tr:hover {
  background: var(--surf2);
}
.sf-table td {
  padding: 13px 14px;
  color: var(--txt);
  vertical-align: middle;
}
.sf-suburb-name {
  font-weight: 700;
  color: var(--navy);
}
.city-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 3px;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.city-syd  { background: #dbeafe; color: #1d4ed8; }
.city-mel  { background: #ede9fe; color: #5b21b6; }
.city-bris { background: #dcfce7; color: #166534; }
.city-per  { background: #fff7ed; color: #c2410c; }
.city-adl  { background: #fdf2f8; color: #86198f; }
.vibe-tag {
  display: inline-block;
  background: var(--surface);
  color: var(--txt2);
  font-size: 11px;
  padding: 4px 9px;
  border-radius: 3px;
  border: 1px solid var(--border-lt);
}
.kiwi-stars {
  color: var(--gold);
  font-size: 0.85rem;
  letter-spacing: -1px;
}
.details-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--blue);
  white-space: nowrap;
}
.details-link:hover {
  text-decoration: underline;
}
.sf-no-results {
  text-align: center;
  padding: 48px;
  color: var(--txt2);
  font-size: 14px;
  border: 1px solid var(--border-lt);
  border-radius: 6px;
  background: var(--surf2);
}

/* ── SPOTLIGHT CARDS ── */
.spotlight-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 4px;
}
.spotlight-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0,32,92,0.05);
}
.spotlight-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 3px;
  margin-bottom: 12px;
}
.spotlight-badge.beach  { background: var(--blue-tint); color: var(--blue); }
.spotlight-badge.family { background: #dcfce7; color: #166534; }
.spotlight-badge.city   { background: #ede9fe; color: #5b21b6; }
.spotlight-name {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--navy);
  margin-bottom: 4px;
  letter-spacing: -0.02em;
}
.spotlight-rent {
  font-size: 13px;
  color: var(--txt2);
  margin-bottom: 4px;
}
.spotlight-stars {
  color: var(--gold);
  font-size: 0.9rem;
  letter-spacing: -1px;
  margin-bottom: 12px;
}
.spotlight-divider {
  height: 1px;
  background: var(--border-lt);
  margin: 12px 0;
}
.spotlight-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 6px;
  font-size: 13px;
}
.spotlight-label {
  color: var(--txt3);
  font-weight: 600;
  flex-shrink: 0;
}
.spotlight-val {
  color: var(--txt);
  text-align: right;
}
.spotlight-section {
  margin-top: 14px;
}
.spotlight-section-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--green-ok);
  margin-bottom: 7px;
}
.spotlight-section-title.cons {
  color: #b91c1c;
}
.spotlight-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.spotlight-list li {
  font-size: 13px;
  color: var(--txt2);
  padding-left: 16px;
  position: relative;
  line-height: 1.4;
}
.spotlight-list li::before {
  content: '✓';
  color: var(--green-ok);
  font-weight: 700;
  position: absolute;
  left: 0;
  font-size: 12px;
}
.cons-list li::before {
  content: '✗';
  color: #b91c1c;
}

/* ── UPGRADE CARD ── */
.sf-upgrade-card {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 48px;
  align-items: start;
  background: var(--surface);
  border: 1px solid var(--border-lt);
  border-radius: 8px;
  padding: 36px;
}
.sf-upgrade-right {
  min-width: 240px;
}
.sf-upgrade-price {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--navy);
  margin-bottom: 16px;
}
.sf-upgrade-price span {
  font-size: 1rem;
  font-weight: 400;
  color: var(--txt2);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .spotlight-grid {
    grid-template-columns: 1fr 1fr;
  }
  .sf-upgrade-card {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .sf-upgrade-right {
    min-width: unset;
  }
}
@media (max-width: 640px) {
  .sf-filters-inner {
    flex-direction: column;
    align-items: stretch;
  }
  .sf-btn {
    width: 100%;
  }
  .spotlight-grid {
    grid-template-columns: 1fr;
  }
  .sf-table { font-size: 12px; }
  .sf-table td, .sf-table thead th { padding: 10px 10px; }
}
</style>

<script>
(function() {

  // ── SUBURB DATA ──
  const suburbs = [
    // Sydney
    { suburb: 'Manly',           city: 'Sydney',    rentMin: 750, rentMax: 900,  rentLabel: '$750–$900',  commute: 30, commuteLabel: '30 min (ferry)', vibe: 'Beach & cafés',      lifestyle: 'beach',  kiwi: 5 },
    { suburb: 'Bondi Beach',     city: 'Sydney',    rentMin: 800, rentMax: 1050, rentLabel: '$800–$1,050',commute: 35, commuteLabel: '35 min (bus)',   vibe: 'Beach & bars',        lifestyle: 'beach',  kiwi: 5 },
    { suburb: 'Newtown',         city: 'Sydney',    rentMin: 600, rentMax: 750,  rentLabel: '$600–$750',  commute: 12, commuteLabel: '12 min (train)', vibe: 'Trendy & alternative',lifestyle: 'inner',  kiwi: 3 },
    { suburb: 'Chatswood',       city: 'Sydney',    rentMin: 580, rentMax: 700,  rentLabel: '$580–$700',  commute: 20, commuteLabel: '20 min (train)', vibe: 'Family-friendly',     lifestyle: 'family', kiwi: 3 },
    { suburb: 'Parramatta',      city: 'Sydney',    rentMin: 420, rentMax: 520,  rentLabel: '$420–$520',  commute: 38, commuteLabel: '38 min (train)', vibe: 'Affordable & diverse', lifestyle: 'quiet',  kiwi: 2 },
    // Melbourne
    { suburb: 'St Kilda',        city: 'Melbourne', rentMin: 550, rentMax: 720,  rentLabel: '$550–$720',  commute: 22, commuteLabel: '22 min (tram)',  vibe: 'Beach & nightlife',   lifestyle: 'beach',  kiwi: 4 },
    { suburb: 'Fitzroy',         city: 'Melbourne', rentMin: 580, rentMax: 720,  rentLabel: '$580–$720',  commute: 15, commuteLabel: '15 min (tram)',  vibe: 'Young professionals', lifestyle: 'inner',  kiwi: 3 },
    { suburb: 'Box Hill',        city: 'Melbourne', rentMin: 420, rentMax: 520,  rentLabel: '$420–$520',  commute: 35, commuteLabel: '35 min (train)', vibe: 'Family-friendly',     lifestyle: 'family', kiwi: 4 },
    { suburb: 'Footscray',       city: 'Melbourne', rentMin: 380, rentMax: 480,  rentLabel: '$380–$480',  commute: 18, commuteLabel: '18 min (train)', vibe: 'Affordable & up-coming',lifestyle: 'quiet', kiwi: 2 },
    { suburb: 'Southbank',       city: 'Melbourne', rentMin: 650, rentMax: 850,  rentLabel: '$650–$850',  commute: 5,  commuteLabel: '5 min (walk)',   vibe: 'City centre',         lifestyle: 'city',   kiwi: 3 },
    // Brisbane
    { suburb: 'South Brisbane',  city: 'Brisbane',  rentMin: 500, rentMax: 650,  rentLabel: '$500–$650',  commute: 8,  commuteLabel: '8 min (bus)',    vibe: 'City edge & arts',    lifestyle: 'city',   kiwi: 4 },
    { suburb: 'New Farm',        city: 'Brisbane',  rentMin: 520, rentMax: 680,  rentLabel: '$520–$680',  commute: 10, commuteLabel: '10 min (bus)',   vibe: 'River & boutiques',   lifestyle: 'inner',  kiwi: 4 },
    { suburb: 'Wynnum',          city: 'Brisbane',  rentMin: 380, rentMax: 490,  rentLabel: '$380–$490',  commute: 30, commuteLabel: '30 min (train)', vibe: 'Beach & quiet',       lifestyle: 'beach',  kiwi: 3 },
    { suburb: 'Chermside',       city: 'Brisbane',  rentMin: 360, rentMax: 450,  rentLabel: '$360–$450',  commute: 25, commuteLabel: '25 min (bus)',   vibe: 'Family-friendly',     lifestyle: 'family', kiwi: 2 },
    // Perth
    { suburb: 'Fremantle',       city: 'Perth',     rentMin: 450, rentMax: 580,  rentLabel: '$450–$580',  commute: 28, commuteLabel: '28 min (train)', vibe: 'Beach & heritage',    lifestyle: 'beach',  kiwi: 5 },
    { suburb: 'Cottesloe',       city: 'Perth',     rentMin: 600, rentMax: 780,  rentLabel: '$600–$780',  commute: 22, commuteLabel: '22 min (train)', vibe: 'Premium beach',       lifestyle: 'beach',  kiwi: 4 },
    { suburb: 'Subiaco',         city: 'Perth',     rentMin: 500, rentMax: 650,  rentLabel: '$500–$650',  commute: 15, commuteLabel: '15 min (train)', vibe: 'Trendy inner suburb', lifestyle: 'inner',  kiwi: 3 },
    // Adelaide
    { suburb: 'Glenelg',         city: 'Adelaide',  rentMin: 400, rentMax: 520,  rentLabel: '$400–$520',  commute: 28, commuteLabel: '28 min (tram)',  vibe: 'Beach & relaxed',     lifestyle: 'beach',  kiwi: 3 },
    { suburb: 'Norwood',         city: 'Adelaide',  rentMin: 360, rentMax: 480,  rentLabel: '$360–$480',  commute: 12, commuteLabel: '12 min (bus)',   vibe: 'Café & culture',      lifestyle: 'inner',  kiwi: 2 },
    { suburb: 'Prospect',        city: 'Adelaide',  rentMin: 320, rentMax: 420,  rentLabel: '$320–$420',  commute: 18, commuteLabel: '18 min (bus)',   vibe: 'Affordable & family', lifestyle: 'family', kiwi: 2 },
  ];

  const cityColors = {
    Sydney:    'city-syd',
    Melbourne: 'city-mel',
    Brisbane:  'city-bris',
    Perth:     'city-per',
    Adelaide:  'city-adl',
  };

  function stars(n) {
    return '★'.repeat(n) + '☆'.repeat(5 - n);
  }

  function rentBucket(min) {
    if (min < 450)  return 'under450';
    if (min < 600)  return '450-600';
    if (min < 800)  return '600-800';
    return '800plus';
  }

  function renderRows(data) {
    const tbody = document.getElementById('sf-tbody');
    const noResults = document.getElementById('sf-no-results');
    const countEl = document.getElementById('sf-results-count');

    tbody.innerHTML = '';

    if (data.length === 0) {
      noResults.style.display = '';
      countEl.textContent = 'No suburbs found';
      return;
    }

    noResults.style.display = 'none';
    countEl.textContent = 'Showing ' + data.length + ' suburb' + (data.length !== 1 ? 's' : '');

    data.forEach(function(s) {
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td class="sf-suburb-name">' + s.suburb + '</td>' +
        '<td><span class="city-badge ' + cityColors[s.city] + '">' + s.city + '</span></td>' +
        '<td>' + s.rentLabel + '</td>' +
        '<td>' + s.commuteLabel + '</td>' +
        '<td><span class="vibe-tag">' + s.vibe + '</span></td>' +
        '<td><span class="kiwi-stars" title="Kiwi score: ' + s.kiwi + '/5">' + stars(s.kiwi) + '</span></td>' +
        '<td><a href="#" class="details-link">Details →</a></td>';
      tbody.appendChild(tr);
    });
  }

  function applyFilters() {
    const city      = document.getElementById('f-city').value;
    const budget    = document.getElementById('f-budget').value;
    const lifestyle = document.getElementById('f-lifestyle').value;

    const filtered = suburbs.filter(function(s) {
      if (city !== 'all' && s.city !== city) return false;
      if (budget !== 'all' && rentBucket(s.rentMin) !== budget) return false;
      if (lifestyle !== 'all' && s.lifestyle !== lifestyle) return false;
      return true;
    });

    renderRows(filtered);
  }

  // Initial render
  renderRows(suburbs);

  // Filter button
  document.getElementById('sf-search-btn').addEventListener('click', applyFilters);

  // Also filter on Enter key inside selects
  ['f-city', 'f-budget', 'f-lifestyle'].forEach(function(id) {
    document.getElementById(id).addEventListener('keydown', function(e) {
      if (e.key === 'Enter') applyFilters();
    });
  });

  // Sorting
  let sortCol   = null;
  let sortDir   = 1; // 1 = asc, -1 = desc

  const sortKeys = {
    suburb:  function(s) { return s.suburb.toLowerCase(); },
    city:    function(s) { return s.city.toLowerCase(); },
    rent:    function(s) { return s.rentMin; },
    commute: function(s) { return s.commute; },
    kiwi:    function(s) { return s.kiwi; },
  };

  document.querySelectorAll('.sf-table thead th.sortable').forEach(function(th) {
    th.addEventListener('click', function() {
      const col = th.dataset.col;
      if (sortCol === col) {
        sortDir *= -1;
      } else {
        sortCol = col;
        sortDir = 1;
      }
      // Update header classes
      document.querySelectorAll('.sf-table thead th').forEach(function(h) {
        h.classList.remove('sort-asc', 'sort-desc');
      });
      th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');

      // Get current visible rows from filtered data
      const city      = document.getElementById('f-city').value;
      const budget    = document.getElementById('f-budget').value;
      const lifestyle = document.getElementById('f-lifestyle').value;

      let data = suburbs.filter(function(s) {
        if (city !== 'all' && s.city !== city) return false;
        if (budget !== 'all' && rentBucket(s.rentMin) !== budget) return false;
        if (lifestyle !== 'all' && s.lifestyle !== lifestyle) return false;
        return true;
      });

      data = data.slice().sort(function(a, b) {
        const va = sortKeys[col](a);
        const vb = sortKeys[col](b);
        if (va < vb) return -1 * sortDir;
        if (va > vb) return  1 * sortDir;
        return 0;
      });

      renderRows(data);
    });
  });

})();
</script>
