<script>
(function() {
  const TOTAL = 70;
  const checks = document.querySelectorAll('.cl-check');
  const fill = document.getElementById('progress-fill');
  const doneCount = document.getElementById('done-count');
  const pct = document.getElementById('progress-pct');
  const resetBtn = document.getElementById('reset-btn');

  // Category metadata: [sectionId, total]
  const categories = [
    { id: 'before-you-decide',   total: 5  },
    { id: 'three-months-before', total: 12 },
    { id: 'one-three-months',    total: 15 },
    { id: 'two-four-weeks',      total: 12 },
    { id: 'moving-week',         total: 8  },
    { id: 'first-week',         total: 10 },
    { id: 'first-month',         total: 8  },
  ];

  function loadState() {
    checks.forEach(function(cb) {
      const idx = cb.dataset.index;
      const saved = localStorage.getItem('checklist_item_' + idx);
      if (saved === 'true') {
        cb.checked = true;
      }
    });
  }

  function updateProgress() {
    let done = 0;
    checks.forEach(function(cb) {
      if (cb.checked) done++;
    });
    const p = Math.round((done / TOTAL) * 100);
    fill.style.width = p + '%';
    doneCount.textContent = done;
    pct.textContent = p + '% complete';

    // Update category counts
    categories.forEach(function(cat) {
      const catChecks = document.querySelectorAll('.cl-check[data-section="' + cat.id + '"]');
      let catDone = 0;
      catChecks.forEach(function(c) { if (c.checked) catDone++; });
      const el = document.getElementById('cnt-' + cat.id);
      if (el) el.textContent = catDone + '/' + cat.total;
    });
  }

  function saveItem(index, checked) {
    localStorage.setItem('checklist_item_' + index, checked ? 'true' : 'false');
  }

  checks.forEach(function(cb) {
    cb.addEventListener('change', function() {
      saveItem(cb.dataset.index, cb.checked);
      updateProgress();
    });
  });

  resetBtn && resetBtn.addEventListener('click', function() {
    if (!confirm('Reset all checklist progress?')) return;
    checks.forEach(function(cb) {
      cb.checked = false;
      localStorage.removeItem('checklist_item_' + cb.dataset.index);
    });
    updateProgress();
  });

  // Sidebar active on scroll
  const sections = document.querySelectorAll('.cl-section');
  const sidebarLinks = document.querySelectorAll('.sidebar-link');

  const io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        sidebarLinks.forEach(function(link) {
          link.classList.toggle('is-active', link.dataset.section === id);
        });
      }
    });
  }, { rootMargin: '-60px 0px -60% 0px', threshold: 0 });

  sections.forEach(function(s) { io.observe(s); });

  loadState();
  updateProgress();
})();
</script>
