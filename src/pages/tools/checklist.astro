<Layout
  title="Kiwi Moving to Australia Checklist — 122 Steps | GoAustralia.co.nz"
  description="122 Kiwi-specific steps for moving to Australia — in the right order. TFN, Medicare, KiwiSaver transfer, AU super, driving licence, all 8 states covered. Official links and NZ-specific advice."
>
<style is:global>

/* ══════════════════════════════════════════════════════════
   CHECKLIST — Full Redesign
══════════════════════════════════════════════════════════ */

/* ── HERO ── */
.ck-hero {
  background: #0D2137;
  padding: 52px 0 0;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.ck-hero-inner { max-width: 780px; margin-bottom: 36px; }
.ck-hero-eye {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.12em; color: #7ED3EF;
  margin-bottom: 16px; display: block;
}
.ck-hero h1 {
  font-family: 'Inter', sans-serif; font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800; color: #fff; line-height: 1.15;
  letter-spacing: -0.03em; margin-bottom: 12px;
}
.ck-hero-sub {
  font-family: 'Inter', sans-serif; font-size: 15px;
  color: rgba(255,255,255,0.4); line-height: 1.7;
}

/* State bar */
.ck-state-bar {
  border-top: 1px solid rgba(255,255,255,0.07);
  padding: 14px 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.ck-state-label {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.25); white-space: nowrap;
}
.ck-state-btn {
  font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600;
  padding: 6px 14px; border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.45); background: transparent; cursor: pointer; transition: all 0.15s;
}
.ck-state-btn:hover { border-color: #7ED3EF; color: #7ED3EF; }
.ck-state-btn.active { background: #00698F; border-color: #00698F; color: #fff; font-weight: 700; }

/* Situation bar */
.ck-sit-bar { border-top: 1px solid rgba(255,255,255,0.05); }
.ck-sit-btn {
  font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600;
  padding: 6px 14px; border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.45); background: transparent; cursor: pointer; transition: all 0.15s;
}
.ck-sit-btn:hover { border-color: #00698F; color: #7ED3EF; }
.ck-sit-btn.active { background: #00698F; border-color: #00698F; color: #fff; font-weight: 700; }
/* Situation-specific step highlight */
.ck-step[data-sit-match="extra"] { border-left: 3px solid #00698F; }
.ck-sit-badge {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  color: #0369A1; background: #E0F2FE;
  padding: 2px 6px; border-radius: 3px;
}

/* ── PROGRESS STICKY BAR ── */
.ck-progress {
  background: #0A1628;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  padding: 12px 0; position: sticky; top: 64px; z-index: 50;
}
.ck-progress-inner {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.ck-progress-label {
  font-family: 'Inter', sans-serif; font-size: 12px;
  color: rgba(255,255,255,0.4); white-space: nowrap;
}
.ck-progress-label strong { color: #fff; }
.ck-progress-track {
  flex: 1; min-width: 80px; height: 5px;
  background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden;
}
.ck-progress-fill {
  height: 100%; background: linear-gradient(90deg, #004F6D, #7ED3EF);
  border-radius: 3px; transition: width 0.4s ease;
}
.ck-progress-pct {
  font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700;
  color: #7ED3EF; white-space: nowrap; min-width: 34px;
}
.ck-reset {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
  color: rgba(255,255,255,0.2); background: none; border: none; cursor: pointer;
  padding: 4px 0; transition: color 0.12s;
}
.ck-reset:hover { color: rgba(255,255,255,0.5); }

/* ── LAYOUT ── */
.ck-page { background: #F8FAFC; min-height: 100vh; }
.ck-layout {
  max-width: 1160px; margin: 0 auto; padding: 0 28px;
  display: grid; grid-template-columns: 240px 1fr; gap: 28px;
  padding-top: 32px; padding-bottom: 80px; align-items: start;
}

/* ── SIDEBAR ── */
.ck-sidebar { position: sticky; top: 128px; }
.ck-sidebar-card {
  background: #0D2137;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px; overflow: hidden;
}
.ck-sidebar-head {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: rgba(255,255,255,0.25); padding: 14px 16px 10px;
}
.ck-sidebar-nav { display: flex; flex-direction: column; }
.ck-sidebar-link {
  font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 500;
  color: rgba(255,255,255,0.45); padding: 10px 16px;
  border-top: 1px solid rgba(255,255,255,0.05);
  transition: all 0.12s; display: flex; justify-content: space-between; align-items: center;
  text-decoration: none;
}
.ck-sidebar-link:hover { color: #fff; background: rgba(255,255,255,0.03); }
.ck-sidebar-link.active { color: #7ED3EF; background: rgba(0,105,143,0.12); font-weight: 600; }
.ck-sidebar-count {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 600;
  color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.06);
  padding: 2px 6px; border-radius: 10px;
}
.ck-sidebar-link.active .ck-sidebar-count { color: #7ED3EF; background: rgba(0,105,143,0.2); }

.ck-sidebar-upgrade {
  background: #00698F; margin: 12px;
  border-radius: 8px; padding: 16px; text-align: center;
}
.ck-sidebar-upgrade h4 {
  font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 800;
  color: #fff; margin-bottom: 4px;
}
.ck-sidebar-upgrade p {
  font-family: 'Inter', sans-serif; font-size: 11px; color: rgba(255,255,255,0.7);
  margin-bottom: 12px; line-height: 1.4;
}
.ck-sidebar-upgrade a {
  display: block; background: #000; color: #fff;
  font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700;
  padding: 9px; border-radius: 5px; transition: background 0.12s;
}
.ck-sidebar-upgrade a:hover { background: #1E293B; }

/* ── SECTIONS ── */
.ck-section { margin-bottom: 8px; }
.ck-section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 0 12px;
}
.ck-section-title {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em; color: #6B7280;
}
.ck-section-count {
  font-family: 'Inter', sans-serif; font-size: 11px; color: #9CA3AF;
}

/* ── STEP CARD ── */
.ck-step {
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  margin-bottom: 8px;
  transition: border-color 0.15s, box-shadow 0.15s;
  overflow: hidden;
}
.ck-step:hover { border-color: #D1D5DB; }
.ck-step.ck-done { border-color: #BBF7D0; background: #F0FDF4; }
.ck-step.ck-in-progress { border-color: #CCE7F0; background: #E6F2F7; }
.ck-step.ck-open { box-shadow: 0 4px 20px rgba(0,0,0,0.07); border-color: #D1D5DB; }
.ck-step.ck-locked { background: #F9FAFB; cursor: default; }
.ck-step.ck-locked:hover { border-color: #E5E7EB; }

/* Step header */
.ck-step-header {
  display: flex; align-items: center; gap: 12px;
  padding: 16px 18px; cursor: pointer; user-select: none;
}
.ck-step.ck-locked .ck-step-header { cursor: default; }

.ck-step-num {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 800;
  color: rgba(0,0,0,0.2); min-width: 20px; flex-shrink: 0;
}
.ck-step.ck-done .ck-step-num { color: #22C55E; }

.ck-step-check-circle {
  width: 24px; height: 24px; border-radius: 50%;
  border: 2px solid #D1D5DB; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; background: transparent;
  cursor: pointer;
}
.ck-step.ck-done .ck-step-check-circle {
  background: #22C55E; border-color: #22C55E; color: #fff;
  font-size: 13px;
}
.ck-step.ck-in-progress .ck-step-check-circle {
  border-color: #00698F; background: rgba(0,105,143,0.1);
}
.ck-step-check-circle:hover { border-color: #22C55E; background: rgba(34,197,94,0.08); }

.ck-step-title-wrap { flex: 1; min-width: 0; }
.ck-step-title-text {
  font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600;
  color: #111827; line-height: 1.35;
}
.ck-step.ck-done .ck-step-title-text { color: #6B7280; text-decoration: line-through; text-decoration-color: #BBF7D0; }
.ck-step.ck-locked .ck-step-title-text { color: #9CA3AF; }

.ck-step-badges { display: flex; gap: 5px; margin-top: 4px; flex-wrap: wrap; }
.ck-step-cat-badge {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 600;
  color: #9CA3AF; background: #F3F4F6;
  padding: 2px 6px; border-radius: 3px;
}
.ck-kiwi-badge {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  color: #004F6D; background: #E6F2F7;
  padding: 2px 6px; border-radius: 3px;
}

.ck-step-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.ck-lock-icon { font-size: 13px; color: #D1D5DB; }
.ck-chevron {
  font-size: 10px; color: #D1D5DB; transition: transform 0.2s;
  font-family: 'Inter', sans-serif;
}
.ck-step.ck-open .ck-chevron { transform: rotate(180deg); }

/* Step body */
.ck-step-body { display: none; padding: 0 18px 20px 54px; }
.ck-step.ck-open .ck-step-body { display: block; }

.ck-step-desc {
  font-family: 'Inter', sans-serif; font-size: 13.5px; color: #4B5563;
  line-height: 1.75; margin-bottom: 18px;
}

.ck-step-details {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px; margin-bottom: 18px;
}
.ck-detail-block {
  background: #F8FAFC; border: 1px solid #E5E7EB; border-radius: 8px; padding: 12px 14px;
}
.ck-detail-label {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; margin-bottom: 5px;
}
.ck-detail-val {
  font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; color: #111827;
  line-height: 1.4;
}
.ck-detail-block.docs { grid-column: 1 / -1; }
.ck-docs-list { list-style: none; display: flex; flex-direction: column; gap: 4px; }
.ck-docs-list li {
  font-family: 'Inter', sans-serif; font-size: 12.5px; color: #4B5563;
  display: flex; align-items: center; gap: 7px; line-height: 1.4;
}
.ck-docs-list li::before { content: '📄'; font-size: 11px; flex-shrink: 0; }

.ck-step-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600;
  color: #00698F; text-decoration: none; margin-bottom: 16px;
  border: 1px solid rgba(0,105,143,0.3); padding: 8px 14px; border-radius: 6px;
  background: rgba(0,105,143,0.05); transition: all 0.12s;
}
.ck-step-link:hover { background: rgba(0,105,143,0.1); border-color: #00698F; }

/* Status buttons */
.ck-status-row {
  display: flex; gap: 6px; padding-top: 14px;
  border-top: 1px solid #F3F4F6; flex-wrap: wrap;
}
.ck-status-label {
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF;
  display: flex; align-items: center; margin-right: 4px; white-space: nowrap;
}
.ck-status-btn {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
  padding: 5px 11px; border-radius: 5px; border: 1.5px solid #E5E7EB;
  color: #6B7280; background: #fff; cursor: pointer; transition: all 0.12s;
}
.ck-status-btn:hover { border-color: #D1D5DB; color: #111827; }
.ck-status-btn[data-status="done"]:hover,
.ck-status-btn[data-status="done"].active { background: #DCFCE7; border-color: #86EFAC; color: #166534; }
.ck-status-btn[data-status="in-progress"]:hover,
.ck-status-btn[data-status="in-progress"].active { background: #FEF3C7; border-color: #FCD34D; color: #92400E; }
.ck-status-btn[data-status="na"]:hover,
.ck-status-btn[data-status="na"].active { background: #F3F4F6; border-color: #D1D5DB; color: #374151; }

/* ── PAYWALL ── */
.ck-paywall {
  background: #fff; border: 1.5px solid #E5E7EB; border-radius: 12px;
  overflow: hidden; margin-bottom: 8px; position: relative;
}
.ck-paywall-ghost { padding: 16px 18px; filter: blur(3px); user-select: none; pointer-events: none; }
.ck-paywall-ghost-row {
  display: flex; align-items: center; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid #F3F4F6;
}
.ck-paywall-ghost-row:last-child { border-bottom: none; }
.ck-pg-num { width: 24px; height: 10px; background: #E5E7EB; border-radius: 3px; }
.ck-pg-circle { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #E5E7EB; flex-shrink: 0; }
.ck-pg-bar { height: 10px; border-radius: 3px; background: #F3F4F6; flex: 1; }
.ck-paywall-cta-block {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.75) 35%, rgba(255,255,255,0.98) 60%);
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  padding-bottom: 40px; padding-top: 0;
}
.ck-paywall-box {
  background: #fff; border: 1.5px solid #E5E7EB;
  border-radius: 12px; padding: 28px 32px; text-align: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.08); max-width: 420px; width: 90%;
}
.ck-paywall-box h3 {
  font-family: 'Inter', sans-serif; font-size: 1.15rem; font-weight: 800;
  color: #111827; letter-spacing: -0.02em; margin-bottom: 6px;
}
.ck-paywall-box p {
  font-family: 'Inter', sans-serif; font-size: 13px; color: #6B7280;
  margin-bottom: 20px; line-height: 1.6;
}
.ck-paywall-btn {
  display: block; background: #00698F; color: #fff;
  font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700;
  padding: 13px 28px; border-radius: 7px; transition: background 0.15s; margin-bottom: 8px;
}
.ck-paywall-btn:hover { background: #004F6D; }
.ck-paywall-note { font-family: 'Inter', sans-serif; font-size: 11px; color: #9CA3AF; }

/* ── RESPONSIVE ── */
@media (max-width: 860px) {
  .ck-layout { grid-template-columns: 1fr; gap: 0; }
  .ck-sidebar { display: none; }
  .ck-step-body { padding-left: 18px; }
  .ck-step-details { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 540px) {
  .ck-step-details { grid-template-columns: 1fr; }
  .ck-step-header { padding: 14px 14px; }
  .ck-step-body { padding: 0 14px 16px; }
}
</style>

<!-- HERO -->
<div class="ck-hero">
  <div class="shell">
    <div class="ck-hero-inner">
      <div class="ck-hero-inner">
        <span class="ck-hero-eye">The Kiwi Checklist — 122 Steps</span>
        <h1>Your complete moving checklist — built for New Zealanders</h1>
        <p class="ck-hero-sub">Every step in the right order — across all 8 states and territories, for every situation. TFN, Medicare, KiwiSaver transfer, AU super, driving licence, pets, kids, business owners and more. Official links and Kiwi-specific advice nobody else covers.</p>
      </div>
    </div>
    <div class="ck-state-bar">
      <span class="ck-state-label">Moving to:</span>
      <button class="ck-state-btn active" data-state="all">All states</button>
      <button class="ck-state-btn" data-state="NSW">NSW</button>
      <button class="ck-state-btn" data-state="VIC">VIC</button>
      <button class="ck-state-btn" data-state="QLD">QLD</button>
      <button class="ck-state-btn" data-state="WA">WA</button>
      <button class="ck-state-btn" data-state="SA">SA</button>
      <button class="ck-state-btn" data-state="TAS">TAS</button>
      <button class="ck-state-btn" data-state="ACT">ACT</button>
      <button class="ck-state-btn" data-state="NT">NT</button>
    </div>
    <div class="ck-state-bar ck-sit-bar">
      <span class="ck-state-label">My situation:</span>
      <button class="ck-sit-btn active" data-sit="all">Everyone</button>
      <button class="ck-sit-btn" data-sit="pets">🐾 Pets</button>
      <button class="ck-sit-btn" data-sit="kids">👨‍👩‍👧 Kids</button>
      <button class="ck-sit-btn" data-sit="business">💼 Business</button>
      <button class="ck-sit-btn" data-sit="student">🎓 Profession</button>
      <button class="ck-sit-btn" data-sit="property">🏠 NZ Property</button>
    </div>
  </div>
</div>

<!-- PROGRESS -->
<div class="ck-progress">
  <div class="shell ck-progress-inner">
    <span class="ck-progress-label">Progress: <strong><span id="done-count">0</span> of <span id="visible-total">{FREE_LIMIT}</span> steps complete</strong></span>
    <div class="ck-progress-track"><div class="ck-progress-fill" id="progress-fill"></div></div>
    <span class="ck-progress-pct" id="progress-pct">0%</span>
    <button class="ck-reset" id="reset-btn">Reset all</button>
  </div>
</div>

<!-- PAGE BODY -->
<div class="ck-page">
<div class="ck-layout">

  <!-- Sidebar -->
  <aside class="ck-sidebar">
    <div class="ck-sidebar-card">
      <div class="ck-sidebar-head">Jump to section</div>
      <nav id="sidebar-nav">
        {categories.map(cat => {
          const count = steps.filter(s => s.cat === cat).length;
          return (
            <a href={`#cat-${cat.replace(/\W+/g,'-')}`} class="ck-sidebar-link" data-cat={cat}>
              <span>{cat}</span>
              <span class="ck-sidebar-count">{count}</span>
            </a>
          );
        })}
      </nav>
      {FREE_LIMIT < 70 && (
        <div class="ck-sidebar-upgrade">
          <h4>60 steps locked</h4>
          <p>Unlock the full checklist with Full Access.</p>
          <a href="/pricing">Get Full Access — $24.99</a>
        </div>
      )}
    </div>
  </aside>

  <!-- Steps -->
  <div>
    {categories.map(cat => {
      const catSteps = steps.filter(s => s.cat === cat);
      return (
        <div class="ck-section" id={`cat-${cat.replace(/\W+/g,'-')}`}>
          <div class="ck-section-header">
            <span class="ck-section-title">{cat}</span>
            <span class="ck-section-count">{catSteps.length} steps</span>
          </div>

          {catSteps.map(step => {
            const isFree = step.id < FREE_LIMIT + 1;
            const kiwiOnly = step.title.toLowerCase().includes('kiwisaver') ||
              step.title.toLowerCase().includes('ird') ||
              step.title.toLowerCase().includes('scv') ||
              step.title.toLowerCase().includes('acc') ||
              step.title.toLowerCase().includes('nz');
            return (
              <div
                class={`ck-step${isFree ? '' : ' ck-locked'}`}
                data-id={step.id}
                data-free={isFree ? 'true' : 'false'}
                data-states={Array.isArray(step.states) ? step.states.join(',') : (step.states || 'all')}
                data-situations={Array.isArray(step.situations) ? step.situations.join(',') : (step.situations || 'all')}
              >
                <div class="ck-step-header">
                  <span class="ck-step-num">{String(step.id).padStart(2,'0')}</span>

                  {isFree ? (
                    <div class="ck-step-check-circle" data-id={step.id} title="Click to mark complete"></div>
                  ) : (
                    <span class="ck-lock-icon">🔒</span>
                  )}

                  <div class="ck-step-title-wrap">
                    <div class="ck-step-title-text">{step.title}</div>
                    {(kiwiOnly || !isFree) && (
                      <div class="ck-step-badges">
                        {kiwiOnly && <span class="ck-kiwi-badge">🥝 Kiwi-specific</span>}
                        {!isFree && <span class="ck-step-cat-badge">Locked</span>}
                      </div>
                    )}
                  </div>

                  <div class="ck-step-right">
                    {isFree && <span class="ck-chevron">▾</span>}
                  </div>
                </div>

                {isFree && (
                  <div class="ck-step-body">
                    <p class="ck-step-desc">{step.desc}</p>

                    <div class="ck-step-details">
                      {step.docs.length > 0 && (
                        <div class="ck-detail-block docs">
                          <div class="ck-detail-label">Documents needed</div>
                          <ul class="ck-docs-list">
                            {step.docs.map(d => <li>{d}</li>)}
                          </ul>
                        </div>
                      )}
                      <div class="ck-detail-block">
                        <div class="ck-detail-label">Cost</div>
                        <div class="ck-detail-val">{step.cost}</div>
                      </div>
                      <div class="ck-detail-block">
                        <div class="ck-detail-label">Time</div>
                        <div class="ck-detail-val">{step.time}</div>
                      </div>
                    </div>

                    {step.link && (
                      <a
                        href={step.link.url}
                        class="ck-step-link"
                        target={step.link.url.startsWith('http') ? '_blank' : '_self'}
                        rel="noopener"
                      >
                        🔗 {step.link.text} →
                      </a>
                    )}

                    <div class="ck-status-row">
                      <span class="ck-status-label">Mark as:</span>
                      <button class="ck-status-btn" data-id={step.id} data-status="done">✓ Done</button>
                      <button class="ck-status-btn" data-id={step.id} data-status="in-progress">⏳ In Progress</button>
                      <button class="ck-status-btn" data-id={step.id} data-status="na">✗ Not applicable</button>
                    </div>
                  </div>
                )}
              </div>
            );
          })}

          {/* Paywall — only show when FREE_LIMIT is less than 70 */}
          {FREE_LIMIT < 70 && cat === '3+ Months Before' && (
            <div class="ck-paywall">
              <div class="ck-paywall-ghost">
                {[...Array(5)].map(() => (
                  <div class="ck-paywall-ghost-row">
                    <div class="ck-pg-num"></div>
                    <div class="ck-pg-circle"></div>
                    <div class="ck-pg-bar" style="width:65%"></div>
                  </div>
                ))}
              </div>
              <div class="ck-paywall-cta-block">
                <div class="ck-paywall-box">
                  <h3>60 more steps</h3>
                  <p>TFN, Medicare, MyGov, KiwiSaver transfer, AU super, driving licence, utilities — every step with documents, cost, time and official links.</p>
                  <a href="/pricing" class="ck-paywall-btn">Get Full Access — $24.99 NZD →</a>
                  <p class="ck-paywall-note">One-time payment · All 3 PDF guides included · Instant access</p>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    })}
  </div>

</div>
</div>

<script>
(function() {
  const STORAGE_KEY = 'ga_checklist_v4';

  function loadStatus(): Record<string, string> {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { return {}; }
  }
  function saveStatus(s: Record<string, string>) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
  }

  // ── Filter logic ──────────────────────────────────────────────────────
  function getActiveState(): string {
    return (document.querySelector('.ck-state-btn.active') as HTMLElement)?.dataset.state || 'all';
  }
  function getActiveSit(): string {
    return (document.querySelector('.ck-sit-btn.active') as HTMLElement)?.dataset.sit || 'all';
  }

  function filterSteps() {
    const activeState = getActiveState();
    const activeSit = getActiveSit();
    let visibleCount = 0;

    document.querySelectorAll('.ck-step').forEach(el => {
      const step = el as HTMLElement;
      const stepStates = step.dataset.states || 'all';
      const stepSits = step.dataset.situations || 'all';

      const stateOk = activeState === 'all'
        || stepStates === 'all'
        || stepStates.split(',').includes(activeState);

      const sitOk = activeSit === 'all'
        || stepSits === 'all'
        || stepSits.split(',').includes(activeSit);

      const visible = stateOk && sitOk;
      step.style.display = visible ? '' : 'none';

      if (visible) {
        visibleCount++;
        // Highlight situation-specific steps when a situation filter is active
        if (activeSit !== 'all' && stepSits !== 'all' && stepSits.split(',').includes(activeSit)) {
          step.dataset.sitMatch = 'extra';
        } else {
          delete step.dataset.sitMatch;
        }
      }
    });

    // Hide sections with no visible steps
    document.querySelectorAll('.ck-section').forEach(sec => {
      const anyVisible = Array.from(sec.querySelectorAll('.ck-step')).some(
        s => (s as HTMLElement).style.display !== 'none'
      );
      (sec as HTMLElement).style.display = anyVisible ? '' : 'none';
    });

    // Update the visible total in the progress bar
    const vtEl = document.getElementById('visible-total');
    if (vtEl) vtEl.textContent = String(visibleCount);
  }

  // ── Apply saved status ─────────────────────────────────────────────────
  function applyStatus(status: Record<string, string>) {
    document.querySelectorAll('.ck-step[data-free="true"]').forEach(el => {
      el.classList.remove('ck-done', 'ck-in-progress', 'ck-na');
    });
    document.querySelectorAll('.ck-status-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.ck-step-check-circle').forEach(c => { (c as HTMLElement).textContent = ''; });

    Object.entries(status).forEach(([id, st]) => {
      const step = document.querySelector(`.ck-step[data-id="${id}"]`);
      if (!step) return;
      if (st === 'done') {
        step.classList.add('ck-done');
        const circle = step.querySelector('.ck-step-check-circle');
        if (circle) circle.textContent = '✓';
      } else if (st === 'in-progress') {
        step.classList.add('ck-in-progress');
      }
      const btn = step.querySelector(`.ck-status-btn[data-status="${st}"]`);
      if (btn) btn.classList.add('active');
    });

    const allFree = document.querySelectorAll('.ck-step[data-free="true"]');
    const doneCount = Object.values(status).filter(s => s === 'done').length;
    const pct = allFree.length > 0 ? Math.round((doneCount / allFree.length) * 100) : 0;
    const countEl = document.getElementById('done-count');
    const fillEl = document.getElementById('progress-fill');
    const pctEl = document.getElementById('progress-pct');
    if (countEl) countEl.textContent = String(doneCount);
    if (fillEl) fillEl.style.width = pct + '%';
    if (pctEl) pctEl.textContent = pct + '%';
  }

  let status = loadStatus();
  applyStatus(status);
  filterSteps();

  // ── Accordion ─────────────────────────────────────────────────────────
  document.querySelectorAll('.ck-step[data-free="true"] .ck-step-header').forEach(header => {
    header.addEventListener('click', function(e) {
      if ((e.target as HTMLElement).closest('.ck-step-check-circle')) return;
      const step = header.closest('.ck-step');
      if (!step) return;
      const isOpen = step.classList.contains('ck-open');
      document.querySelectorAll('.ck-step.ck-open').forEach(s => s.classList.remove('ck-open'));
      if (!isOpen) step.classList.add('ck-open');
    });
  });

  // ── Quick tick ────────────────────────────────────────────────────────
  document.querySelectorAll('.ck-step-check-circle').forEach(circle => {
    circle.addEventListener('click', function(e) {
      e.stopPropagation();
      const id = (circle as HTMLElement).dataset.id;
      if (!id) return;
      if (status[id] === 'done') { delete status[id]; } else { status[id] = 'done'; }
      saveStatus(status);
      applyStatus(status);
    });
  });

  // ── Status buttons ────────────────────────────────────────────────────
  document.querySelectorAll('.ck-status-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const id = (btn as HTMLElement).dataset.id;
      const st = (btn as HTMLElement).dataset.status;
      if (!id || !st) return;
      if (status[id] === st) { delete status[id]; } else { status[id] = st; }
      saveStatus(status);
      applyStatus(status);
    });
  });

  // ── Reset ─────────────────────────────────────────────────────────────
  document.getElementById('reset-btn')?.addEventListener('click', () => {
    if (confirm('Reset all progress?')) { status = {}; saveStatus(status); applyStatus(status); }
  });

  // ── State filter ──────────────────────────────────────────────────────
  document.querySelectorAll('.ck-state-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ck-state-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterSteps();
    });
  });

  // ── Situation filter ──────────────────────────────────────────────────
  document.querySelectorAll('.ck-sit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ck-sit-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterSteps();
    });
  });

  // ── Sidebar scroll spy ────────────────────────────────────────────────
  const sidebarLinks = document.querySelectorAll('.ck-sidebar-link');
  const sectionEls = document.querySelectorAll('.ck-section');
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = (e.target as HTMLElement).id;
        sidebarLinks.forEach(l => {
          const href = (l as HTMLAnchorElement).getAttribute('href');
          l.classList.toggle('active', href === '#' + id);
        });
      }
    });
  }, { threshold: 0.2, rootMargin: '-80px 0px -60% 0px' });
  sectionEls.forEach(s => obs.observe(s));
})();
</script>

</Layout>
