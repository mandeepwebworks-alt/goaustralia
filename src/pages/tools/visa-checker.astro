---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Visa Pathway Checker — Free Tool | GoAustralia.co.nz" description="Find your exact visa options for moving from New Zealand to Australia. Free, no account required. Based on Home Affairs public data.">
<style is:global>
  .checker-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: start; padding: 40px 0; }
  .results-panel { background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 8px; padding: 28px; min-height: 300px; }
  .results-placeholder { text-align: center; padding: 40px 20px; }
  .results-placeholder .ph-icon { font-size: 2.5rem; margin-bottom: 14px; }
  .results-placeholder p { font-size: 14px; color: var(--txt3); line-height: 1.6; }
  .result-visa-name { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.2rem; font-weight: 800; color: var(--navy); margin-bottom: 6px; }
  .visa-badge { display: inline-flex; align-items: center; gap: 6px; background: #d1fae5; color: var(--green-ok); font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 3px; margin-bottom: 20px; }
  .visa-badge.amber { background: var(--gold-lt); color: var(--gold); }
  .info-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .info-tile { background: var(--white); border: 1px solid var(--border-lt); border-radius: 6px; padding: 14px; }
  .info-tile .tile-icon { font-size: 1.2rem; margin-bottom: 6px; }
  .info-tile h4 { font-size: 12px; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
  .info-tile p { font-size: 11px; color: var(--txt2); line-height: 1.5; }
  .result-agent-card { background: var(--blue-tint); border: 1px solid #b8d4f0; border-radius: 6px; padding: 18px; margin-top: 16px; }
  .result-agent-card p { font-size: 13px; color: var(--navy); line-height: 1.6; }
  .result-agent-card a { color: var(--blue); font-weight: 600; text-decoration: underline; }

  @media (max-width: 860px) { .checker-layout { grid-template-columns: 1fr; } .info-tiles { grid-template-columns: 1fr; } }
</style>

<div class="page-hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">Home</a> › <a href="/tools/visa-checker">Tools</a> › Visa Checker</div>
    <h1>Visa Pathway Checker</h1>
    <p class="page-hero-sub">Find your exact visa options for moving from New Zealand to Australia — free, no account needed.</p>
  </div>
</div>

<div class="shell">
  <div class="checker-layout">

    <!-- Form -->
    <div class="tool-card">
      <div class="tool-card-title">🔍 Your Visa Options</div>

      <div class="field-row">
        <span class="field-label">Your NZ status</span>
        <select class="field-select-full" id="status">
          <option value="citizen">NZ citizen</option>
          <option value="pr">NZ permanent resident</option>
          <option value="partner">Partner of a NZ citizen</option>
          <option value="other">Skilled worker / other visa</option>
        </select>
      </div>

      <div class="field-row">
        <span class="field-label">Primary reason for moving</span>
        <select class="field-select-full" id="reason">
          <option value="work">Work & career</option>
          <option value="family">Family reunification</option>
          <option value="study">Study</option>
          <option value="lifestyle">Lifestyle / retirement</option>
        </select>
      </div>

      <div class="field-row">
        <span class="field-label">Destination state</span>
        <select class="field-select-full" id="state">
          <option>New South Wales — Sydney</option>
          <option>Victoria — Melbourne</option>
          <option>Queensland — Brisbane / Gold Coast</option>
          <option>Western Australia — Perth</option>
          <option>South Australia — Adelaide</option>
          <option>Other / undecided</option>
        </select>
      </div>

      <div class="field-row">
        <span class="field-label">When are you planning to move?</span>
        <select class="field-select-full" id="timeline">
          <option>Within 3 months</option>
          <option>3–6 months</option>
          <option>6–12 months</option>
          <option>More than 12 months away</option>
        </select>
      </div>

      <button class="tool-btn" id="check-btn">Check My Visa Options →</button>
      <div class="tool-note">Free tool · Based on Home Affairs public data · No account required</div>
    </div>

    <!-- Results -->
    <div class="results-panel" id="results-panel">
      <div class="results-placeholder" id="placeholder">
        <div class="ph-icon">🔍</div>
        <p>Fill in your details on the left<br/>and click <strong>Check My Visa Options</strong> to see your personalised pathway.</p>
      </div>
      <div id="result-content" style="display:none;"></div>
    </div>

  </div>
</div>

<!-- Alert -->
<div class="alert-band">
  <div class="shell alert-inner">
    <span>⚠️</span>
    <span><strong>General guidance only.</strong> This tool provides information based on publicly available policy. Always verify with the <a href="https://immi.homeaffairs.gov.au" target="_blank" rel="noopener">Department of Home Affairs</a> before making decisions.</span>
  </div>
</div>

<!-- FAQ -->
<section class="section section-alt">
  <div class="shell">
    <div class="faq-layout">
      <div>
        <div class="sec-eye">SCV Questions</div>
        <div class="sec-h2">About the Special Category Visa</div>
        <p style="font-size:13px;color:var(--txt2);line-height:1.65;margin-top:10px;">The SCV is one of the most misunderstood visas in Australia. Here are the most common questions.</p>
      </div>
      <div class="faq-list">
        {[
          ['What is the Special Category Visa (SCV)?', 'The SCV (subclass 444) is a temporary visa granted automatically to New Zealand citizens on arrival in Australia. It lets you live and work in Australia indefinitely — but it is NOT permanent residency and comes with some important restrictions.'],
          ['Can I access Medicare on the SCV?', 'Yes. From July 2023, most NZ citizens on the SCV can enrol in Medicare from their first day in Australia. Previously you needed to be a permanent resident. Visit a Medicare service centre with your NZ passport to enrol.'],
          ['Can the SCV lead to permanent residency?', 'Yes — from July 2023 you can apply for a Resident Return Visa (subclass 155) after meeting the residence requirement. From July 2025, time on the SCV counts towards the citizenship residence requirement (4 years).'],
          ['Can I sponsor a family member on the SCV?', 'Generally no — the SCV does not give you PR status, so you cannot sponsor family members for most visa types. You would need to become a permanent resident first.'],
        ].map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <div class="faq-ans">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<div class="cta-band">
  <div class="shell">
    <h2>Get the Full Visa & Immigration Guide</h2>
    <p>90-page guide covering your complete visa pathway, Medicare, banking and first 90 days — included with $1.99/month.</p>
    <a href="/pricing" class="cta-band-btn">Get Full Access →</a>
  </div>
</div>

<script>
const results: Record<string, { visa: string; badge: string; badgeClass: string; tiles: Array<{ icon: string; title: string; desc: string }> }> = {
  citizen: {
    visa: 'Special Category Visa — Subclass 444',
    badge: '✓ Automatically granted on arrival',
    badgeClass: '',
    tiles: [
      { icon: '✅', title: 'Live & work indefinitely', desc: 'No application needed. The SCV is issued at the Australian border when you arrive on your NZ passport.' },
      { icon: '🏥', title: 'Medicare eligible', desc: 'You can enrol in Medicare from your first day in Australia (as of July 2023). Bring your NZ passport to a Medicare office.' },
      { icon: '🏠', title: 'Path to permanent residency', desc: 'You can apply for PR after meeting the residence requirement. From July 2023, time on the SCV counts towards this.' },
      { icon: '🌏', title: 'Citizenship timeline', desc: 'From July 2025, time on the SCV counts toward Australian citizenship (4 years total residency required).' },
    ],
  },
  pr: {
    visa: 'You may already hold a permanent visa',
    badge: 'ℹ Confirm your visa subclass',
    badgeClass: 'amber',
    tiles: [
      { icon: '📋', title: 'Check your visa subclass', desc: 'NZ permanent residents may hold various visa subclasses. Log into your ImmiAccount to confirm your current visa status.' },
      { icon: '🏥', title: 'Medicare access', desc: 'Permanent residents are eligible for Medicare. Enrol at a Medicare service centre with your visa documentation.' },
      { icon: '✈️', title: 'Returning to Australia', desc: 'If you leave Australia and want to return as a PR, you may need a Resident Return Visa (subclass 155 or 157).' },
      { icon: '🌏', title: 'Citizenship pathway', desc: 'You can apply for Australian citizenship after 4 years of residence, including at least 1 year as a permanent resident.' },
    ],
  },
  partner: {
    visa: 'Partner Visa — Subclass 820 / 801',
    badge: 'Application required',
    badgeClass: 'amber',
    tiles: [
      { icon: '📝', title: 'Apply before or after arrival', desc: 'You can apply for a partner visa onshore (820/801) or offshore (309/100). The process typically takes 12–24 months.' },
      { icon: '💰', title: 'Visa fees apply', desc: 'Partner visa fees are substantial — currently AUD $8,850+. You will also need to demonstrate a genuine relationship.' },
      { icon: '🏥', title: 'Medicare access', desc: 'Limited Medicare access while on a bridging visa. Full access once granted permanent partner visa (subclass 801).' },
      { icon: '⚖️', title: 'Get migration advice', desc: 'Partner visa applications are complex. We recommend consulting a registered migration agent before applying.' },
    ],
  },
  other: {
    visa: 'Your pathway depends on your specific situation',
    badge: 'Personalised advice recommended',
    badgeClass: 'amber',
    tiles: [
      { icon: '🔍', title: 'Many pathways available', desc: 'Skilled workers may be eligible for subclass 482 (TSS), 186 (ENS), 189, or 190 depending on their occupation and employer.' },
      { icon: '📋', title: 'Skills assessment may be required', desc: 'Most skilled visas require a skills assessment from the relevant assessing authority for your occupation.' },
      { icon: '⭐', title: 'Points-based pathways', desc: 'If you have the right occupation, age, and English skills, you may qualify for a points-tested visa (subclass 189 or 190).' },
      { icon: '⚖️', title: 'Speak to a migration agent', desc: 'Skilled migration is complex. A registered migration agent can identify your best pathway and manage your application.' },
    ],
  },
};

document.getElementById('check-btn')?.addEventListener('click', () => {
  const status = (document.getElementById('status') as HTMLSelectElement).value;
  const data = results[status] || results['other'];

  const html = `
    <div class="result-visa-name">${data.visa}</div>
    <div class="visa-badge ${data.badgeClass}">${data.badge}</div>
    <div class="info-tiles">
      ${data.tiles.map(t => `
        <div class="info-tile">
          <div class="tile-icon">${t.icon}</div>
          <h4>${t.title}</h4>
          <p>${t.desc}</p>
        </div>
      `).join('')}
    </div>
    <div class="result-agent-card">
      <p>📘 <strong>Go deeper:</strong> Our <a href="/guides/masterguide">Kiwi Moving Masterguide</a> covers your visa pathway, Medicare enrolment, banking, and your first 90 days in detail — included with a <a href="/pricing">$1.99/month subscription</a>.</p>
    </div>
  `;

  const placeholder = document.getElementById('placeholder');
  const content = document.getElementById('result-content');
  if (placeholder) placeholder.style.display = 'none';
  if (content) { content.innerHTML = html; content.style.display = 'block'; }
});
</script>

</Layout>
