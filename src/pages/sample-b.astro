---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GoAustralia — Moving Guides & Visa Tools for Kiwis</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --forest:    #0F3826;
      --green:     #1B6B45;
      --accent:    #1B6B45;
      --accent-lt: #f0fdf4;
      --amber:     #D97706;
      --amber-lt:  #fef3c7;
      --surface:   #f3faf5;
      --surf2:     #f8fbf8;
      --border:    #b8d8c4;
      --border-lt: #dceee3;
      --txt:       #0e2b1c;
      --txt2:      #3d6b51;
      --txt3:      #7aab8e;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #fff; color: var(--txt); -webkit-font-smoothing: antialiased; }
    h1,h2,h3,h4 { letter-spacing: -0.025em; color: var(--forest); }
    a { text-decoration: none; color: inherit; }
    .shell { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
    .top-strip { background: var(--forest); text-align: center; padding: 9px 20px; }
    .top-strip p { font-size: 13px; color: rgba(255,255,255,0.82); }
    .top-strip a { color: #6ee7b7; text-decoration: underline; }
    .header { background: #fff; border-bottom: 1px solid var(--border-lt); position: sticky; top: 0; z-index: 100; }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
    .logo-eye { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--green); }
    .logo-name { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--forest); letter-spacing: -0.02em; }
    .nav-links { display: flex; align-items: center; gap: 1px; }
    .nav-links a { font-size: 14px; font-weight: 500; color: var(--txt); padding: 8px 13px; border-radius: 6px; transition: background 0.15s; }
    .nav-links a:hover { background: var(--accent-lt); }
    .btn-primary { background: var(--accent); color: #fff !important; font-weight: 600 !important; padding: 9px 20px !important; border-radius: 20px; margin-left: 8px; font-size: 14px !important; }
    .hero-band { background: var(--surface); border-bottom: 1px solid var(--border-lt); padding: 56px 0 52px; }
    .hero-grid { display: grid; grid-template-columns: 1fr 380px; gap: 48px; align-items: start; }
    .hero-eye { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--green); margin-bottom: 12px; }
    .hero h1 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.6rem; font-weight: 800; line-height: 1.15; color: var(--forest); margin-bottom: 18px; }
    .hero p { font-size: 1.05rem; color: var(--txt2); line-height: 1.7; margin-bottom: 14px; }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
    .btn-hero { background: var(--accent); color: #fff; font-size: 15px; font-weight: 600; padding: 13px 26px; border-radius: 6px; }
    .btn-ghost { border: 1.5px solid var(--border); color: var(--txt); font-size: 14px; font-weight: 500; padding: 12px 22px; border-radius: 6px; }
    .widget { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 24px; }
    .widget h3 { font-size: 1rem; font-weight: 700; color: var(--forest); margin-bottom: 16px; }
    .widget label { display: block; font-size: 12px; font-weight: 600; color: var(--txt2); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.07em; }
    .widget select { width: 100%; border: 1.5px solid var(--border); border-radius: 5px; padding: 10px 12px; font-size: 14px; color: var(--txt); background: #fff; margin-bottom: 14px; outline: none; font-family: inherit; }
    .widget-btn { width: 100%; background: var(--accent); color: #fff; border: none; padding: 13px; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .widget-note { font-size: 11px; color: var(--txt3); margin-top: 10px; text-align: center; }
    .stats-bar { background: var(--forest); padding: 20px 0; }
    .stats-inner { display: flex; justify-content: space-evenly; flex-wrap: wrap; }
    .stat { text-align: center; padding: 8px 20px; }
    .stat-num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.6rem; font-weight: 800; color: #fff; }
    .stat-lbl { font-size: 12px; color: rgba(255,255,255,0.55); margin-top: 3px; }
    .alert { background: var(--amber-lt); border-bottom: 2px solid #fbbf24; padding: 13px 0; }
    .alert-inner { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #78350f; }
    section { padding: 64px 0; }
    .sec-eye { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--green); margin-bottom: 10px; }
    .sec-h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--forest); margin-bottom: 14px; }
    .sec-sub { font-size: 1rem; color: var(--txt2); line-height: 1.7; max-width: 580px; margin-bottom: 40px; }
    .tools-section { background: var(--surf2); border-top: 1px solid var(--border-lt); border-bottom: 1px solid var(--border-lt); }
    .tools-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 32px; }
    .tool-card { background: #fff; border: 1px solid var(--border-lt); border-radius: 8px; padding: 22px 18px; transition: box-shadow 0.15s, transform 0.15s; }
    .tool-card:hover { box-shadow: 0 4px 16px rgba(15,56,38,0.1); transform: translateY(-2px); }
    .tool-icon { font-size: 1.8rem; margin-bottom: 12px; }
    .tool-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--forest); margin-bottom: 6px; }
    .tool-card p { font-size: 13px; color: var(--txt2); line-height: 1.5; }
    .tool-link { display: inline-block; margin-top: 12px; font-size: 12px; font-weight: 600; color: var(--accent); }
    .topic-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .pill { display: inline-flex; align-items: center; gap: 7px; background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 20px; padding: 8px 16px; font-size: 13px; font-weight: 500; color: var(--txt); transition: background 0.15s; }
    .pill:hover { background: var(--accent-lt); border-color: var(--accent); color: var(--accent); }
    .blog-section { border-top: 1px solid var(--border-lt); }
    .blog-featured { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 40px; background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 10px; overflow: hidden; }
    .blog-featured-img { background: linear-gradient(135deg, var(--forest), var(--green)); min-height: 260px; display: flex; align-items: flex-end; padding: 24px; position: relative; }
    .featured-tag { position: absolute; top: 16px; left: 16px; background: var(--amber); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 4px; }
    .blog-featured-content { padding: 28px 24px; display: flex; flex-direction: column; justify-content: center; }
    .blog-meta { font-size: 12px; color: var(--txt3); margin-bottom: 12px; }
    .blog-featured-content h2 { font-size: 1.35rem; font-weight: 700; color: var(--forest); line-height: 1.3; margin-bottom: 12px; }
    .blog-featured-content p { font-size: 14px; color: var(--txt2); line-height: 1.6; }
    .read-more { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 13px; font-weight: 600; color: var(--accent); }
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .blog-card { border: 1px solid var(--border-lt); border-radius: 8px; overflow: hidden; background: #fff; transition: box-shadow 0.15s; }
    .blog-card:hover { box-shadow: 0 4px 16px rgba(15,56,38,0.08); }
    .card-img { height: 140px; }
    .card-body { padding: 18px; }
    .card-tag { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--green); margin-bottom: 8px; }
    .card-body h3 { font-size: 0.95rem; font-weight: 700; color: var(--forest); line-height: 1.35; margin-bottom: 8px; }
    .card-meta { font-size: 12px; color: var(--txt3); }
    .guides-section { background: var(--forest); padding: 72px 0; }
    .guides-section .sec-eye { color: #6ee7b7; }
    .guides-section .sec-h2 { color: #fff; }
    .guides-section .sec-sub { color: rgba(255,255,255,0.6); }
    .guides-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .guide-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 24px; }
    .guide-card:hover { background: rgba(255,255,255,0.1); }
    .guide-price { font-size: 11px; font-weight: 700; color: #6ee7b7; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
    .guide-card h3 { font-size: 1.05rem; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 10px; }
    .guide-card p { font-size: 13px; color: rgba(255,255,255,0.55); line-height: 1.5; margin-bottom: 16px; }
    .guide-btn { display: inline-block; background: rgba(255,255,255,0.12); color: #fff; font-size: 12px; font-weight: 600; padding: 8px 16px; border-radius: 5px; border: 1px solid rgba(255,255,255,0.2); }
    .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .step { text-align: center; }
    .step-num { width: 42px; height: 42px; border-radius: 50%; background: var(--accent-lt); color: var(--accent); font-size: 1rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .step h3 { font-size: 0.95rem; font-weight: 700; color: var(--forest); margin-bottom: 8px; }
    .step p { font-size: 13px; color: var(--txt2); line-height: 1.5; }
    .subscribe-section { background: var(--accent-lt); border-top: 1px solid var(--border-lt); border-bottom: 1px solid var(--border-lt); padding: 60px 0; }
    .subscribe-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    .price-tag { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.2rem; font-weight: 900; color: var(--forest); margin: 12px 0; }
    .price-tag span { font-size: 1rem; font-weight: 500; color: var(--txt2); }
    .feature-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 20px 0; }
    .feature-list li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--txt); }
    .feature-list li::before { content: '✓'; color: var(--accent); font-weight: 700; font-size: 15px; }
    .sub-btn { display: inline-block; background: var(--accent); color: #fff; font-size: 16px; font-weight: 700; padding: 16px 36px; border-radius: 6px; }
    .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .review-card { background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 8px; padding: 24px; }
    .stars { color: var(--amber); font-size: 1rem; margin-bottom: 12px; }
    .review-card p { font-size: 14px; color: var(--txt2); line-height: 1.6; margin-bottom: 14px; }
    .reviewer { font-size: 13px; font-weight: 600; color: var(--forest); }
    .reviewer span { font-size: 12px; font-weight: 400; color: var(--txt3); }
    .faq-list { border: 1px solid var(--border-lt); border-radius: 8px; overflow: hidden; }
    details { border-bottom: 1px solid var(--border-lt); }
    details:last-child { border-bottom: none; }
    details summary { padding: 18px 22px; font-size: 15px; font-weight: 600; color: var(--forest); cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    details summary::after { content: '+'; font-size: 1.3rem; color: var(--txt3); }
    details[open] summary::after { content: '−'; }
    details .faq-body { padding: 0 22px 18px; font-size: 14px; color: var(--txt2); line-height: 1.7; }
    .cta-band { background: var(--forest); padding: 60px 0; text-align: center; }
    .cta-band h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 14px; }
    .cta-band p { color: rgba(255,255,255,0.65); margin-bottom: 28px; }
    .footer { background: #071a0f; }
    .footer-strip { border-bottom: 1px solid rgba(255,255,255,0.08); padding: 18px 0; }
    .footer-strip p { font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.6; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding: 52px 0 40px; }
    .footer-brand-eye { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #6ee7b7; }
    .footer-brand-name { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.2rem; font-weight: 800; color: #fff; margin: 4px 0 12px; }
    .footer-brand-desc { font-size: 13px; color: rgba(255,255,255,0.38); line-height: 1.6; }
    .footer-col-head { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,0.5); margin-bottom: 14px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.4); }
    .footer-links a:hover { color: rgba(255,255,255,0.75); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding: 16px 0; }
    .footer-bottom p { font-size: 11px; color: rgba(255,255,255,0.22); }
    .back-bar { background: var(--surf2); border-bottom: 1px solid var(--border-lt); padding: 10px 0; }
    .back-bar a { font-size: 13px; color: var(--txt2); display: inline-flex; align-items: center; gap: 6px; }
    @media (max-width: 900px) {
      .hero-grid, .blog-featured, .subscribe-inner { grid-template-columns: 1fr; }
      .tools-grid { grid-template-columns: repeat(2, 1fr); }
      .cards-grid, .guides-grid, .steps-grid, .reviews-grid, .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .tools-grid, .cards-grid, .guides-grid, .steps-grid, .reviews-grid, .footer-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 2rem; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>
<div class="back-bar"><div class="shell"><a href="/">← Back to design chooser</a></div></div>
<div class="top-strip"><p>Independent guide for Kiwis moving to Australia — not affiliated with the Australian Government. <a href="#">About this site</a></p></div>
<header class="header">
  <div class="shell header-inner">
    <div><div class="logo-eye">🦘 GoAustralia</div><div class="logo-name">Moving Guides for Kiwis</div></div>
    <nav class="nav-links">
      <a href="#">Visa Tools</a><a href="#">Guides</a><a href="#">Cost Calculator</a><a href="#">Suburbs</a><a href="#">Blog</a>
      <a href="#" class="btn-primary">Get Full Access</a>
    </nav>
  </div>
</header>
<section class="hero-band">
  <div class="shell">
    <div class="hero-grid">
      <div class="hero">
        <div class="hero-eye">🦘 Trusted by 12,000+ Kiwis</div>
        <h1>Your Complete Guide to Moving from New Zealand to Australia</h1>
        <p>Visa pathways, cost breakdowns, suburb guides, tax tips, and checklists — everything a Kiwi needs before and after landing in Aus.</p>
        <p>Join thousands who have used our tools and guides to make the move with confidence.</p>
        <div class="hero-btns"><a href="#" class="btn-hero">Check Your Visa Pathway →</a><a href="#" class="btn-ghost">Browse Free Guides</a></div>
      </div>
      <div class="widget">
        <h3>🔍 Find Your Visa Pathway</h3>
        <label>Current situation</label>
        <select><option>NZ citizen (Special Category)</option><option>NZ PR holder</option><option>Partner of NZ citizen</option></select>
        <label>Moving for</label>
        <select><option>Work & Career</option><option>Family reunification</option><option>Study</option></select>
        <label>Target state</label>
        <select><option>New South Wales (Sydney)</option><option>Victoria (Melbourne)</option><option>Queensland (Brisbane)</option><option>Western Australia (Perth)</option></select>
        <button class="widget-btn">Check Visa Options →</button>
        <p class="widget-note">Free tool — no signup required.</p>
      </div>
    </div>
  </div>
</section>
<div class="stats-bar"><div class="shell stats-inner">
  <div class="stat"><div class="stat-num">12,400+</div><div class="stat-lbl">Kiwis helped</div></div>
  <div class="stat"><div class="stat-num">4.9 ★</div><div class="stat-lbl">Average rating</div></div>
  <div class="stat"><div class="stat-num">3 Guides</div><div class="stat-lbl">Step-by-step PDFs</div></div>
  <div class="stat"><div class="stat-num">Updated</div><div class="stat-lbl">Weekly — 2025</div></div>
  <div class="stat"><div class="stat-num">$1.99</div><div class="stat-lbl">Full access / month</div></div>
</div></div>
<div class="alert"><div class="shell alert-inner"><span>⚠️</span><span><strong>2025 Update:</strong> Australia has expanded the Special Category Visa (SCV) pathway. <a href="#" style="color:var(--amber);text-decoration:underline;">Read the latest →</a></span></div></div>
<section class="tools-section"><div class="shell">
  <div class="sec-eye">Free Tools</div><div class="sec-h2">Plan Your Move Online</div>
  <div class="tools-grid">
    {[{icon:'🛂',title:'Visa Checker',desc:'Find your visa pathway based on your NZ status.',link:'Check now'},{icon:'💰',title:'Cost Calculator',desc:'Estimate moving costs — shipping, bond, setup, living.',link:'Calculate'},{icon:'📋',title:'Moving Checklist',desc:'70-step checklist from notice to first day in Aus.',link:'Open checklist'},{icon:'🏘️',title:'Suburb Finder',desc:'Compare suburbs by cost, commute, schools.',link:'Find suburbs'}].map(t=>(
    <div class="tool-card"><div class="tool-icon">{t.icon}</div><h3>{t.title}</h3><p>{t.desc}</p><span class="tool-link">{t.link} →</span></div>
    ))}
  </div>
</div></section>
<section><div class="shell">
  <div class="sec-eye">Browse by Topic</div><div class="sec-h2">Everything You Need to Know</div>
  <p class="sec-sub">From your first day in Aus to getting your tax sorted.</p>
  <div class="topic-pills">
    {['🛂 Visas & Pathways','💼 Jobs & Work Rights','🏠 Renting & Buying','🏥 Medicare & Health','📦 Shipping & Moving','🎓 Schools & Education','💰 Tax & Finance','🐾 Pets to Australia','🚗 Driving Licence','🏦 Banking & Super','📱 Phone & Utilities','🌏 Citizenship Path'].map(t=>(
    <span class="pill">{t}</span>
    ))}
  </div>
</div></section>
<section class="blog-section"><div class="shell">
  <div class="sec-eye">Latest from the Blog</div><div class="sec-h2">News, Guides & Real Stories</div>
  <div class="blog-featured">
    <div class="blog-featured-img"><div class="featured-tag">Featured</div><div><div style="font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:6px;">Visa Guide · 8 min read</div><div style="font-size:1.1rem;font-weight:700;color:#fff;line-height:1.35;">The Complete 2025 Guide to the Special Category Visa for Kiwis</div></div></div>
    <div class="blog-featured-content"><div class="blog-meta">May 2025 · Visa & Immigration</div><h2>The Complete 2025 Guide to the Special Category Visa for Kiwis</h2><p>Most Kiwis don't need a traditional visa to live and work in Australia — but there are important limits. This guide covers what the SCV does and doesn't give you.</p><a href="#" class="read-more">Read full guide →</a></div>
  </div>
  <div class="cards-grid">
    {[{tag:'Cost of Living',title:'Sydney vs Melbourne: Where Should a Kiwi Move in 2025?',date:'May 2025',img:'#1B6B45'},{tag:'Tax & Finance',title:'Do Kiwis Pay Tax in Australia? Your First-Year Tax Guide',date:'Apr 2025',img:'#186040'},{tag:'Renting',title:'How to Rent a Property in Australia as a New Arrival',date:'Apr 2025',img:'#1d7249'},{tag:'Jobs',title:'In-Demand Jobs for Kiwis in Australia Right Now',date:'Mar 2025',img:'#1a5c3a'},{tag:'Health',title:'How to Get Medicare as a New Zealand Citizen',date:'Mar 2025',img:'#154d31'},{tag:'Real Story',title:'"We Moved to Brisbane with $8k — Here\'s What We Wish We Knew"',date:'Feb 2025',img:'#0f3826'}].map(c=>(
    <div class="blog-card"><div class="card-img" style={`background:${c.img}`}></div><div class="card-body"><span class="card-tag">{c.tag}</span><h3>{c.title}</h3><div class="card-meta">{c.date} · 5 min read</div></div></div>
    ))}
  </div>
</div></section>
<section class="guides-section"><div class="shell">
  <div class="sec-eye">PDF Guides</div><div class="sec-h2">Guides Written by Kiwis Who've Done It</div>
  <p class="sec-sub">Downloadable step-by-step PDFs — buy once, yours forever.</p>
  <div class="guides-grid">
    {[{price:'FREE with subscription · or $19',title:'The Kiwi Moving to Australia Masterguide',desc:'90-page guide covering visa, banking, renting, Medicare, tax, schools, and your first 90 days.'},{price:'FREE with subscription · or $22',title:'Australian Tax & Finance for New Zealanders',desc:'TFN, superannuation, income tax, HECS, and how the ATO treats Kiwis differently.'},{price:'FREE with subscription · or $27',title:'Finding a Job in Australia: Kiwi Edition',desc:'Résumé differences, job boards, LinkedIn strategy, in-demand sectors, and salary benchmarks.'}].map(g=>(
    <div class="guide-card"><div class="guide-price">{g.price}</div><h3>{g.title}</h3><p>{g.desc}</p><a href="#" class="guide-btn">Preview guide →</a></div>
    ))}
  </div>
</div></section>
<section><div class="shell">
  <div style="text-align:center;margin-bottom:44px;"><div class="sec-eye" style="display:block;">How It Works</div><div class="sec-h2">Get Started in 4 Steps</div></div>
  <div class="steps-grid">
    {[{n:'1',title:'Check your visa',desc:'Use our free tool to confirm your pathway — most Kiwis qualify for the SCV automatically.'},{n:'2',title:'Plan your budget',desc:'Run the cost calculator to estimate moving, setup, and first-month living costs.'},{n:'3',title:'Read the guides',desc:'Access our PDF guides with a $1.99/month subscription — cancel anytime.'},{n:'4',title:'Join the community',desc:'Get weekly updates on policy changes and tips from Kiwis already in Aus.'}].map(s=>(
