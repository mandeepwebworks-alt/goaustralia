---
// Admin dashboard — standalone, no Layout
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — GoAustralia.co.nz</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:     #F7F3EE;
      --ink:    #1A1612;
      --ink2:   #6B6055;
      --ink3:   #A89E93;
      --green:  #1E5C38;
      --green-lt:#EBF3EF;
      --border: #E0D9D0;
      --white:  #FFFFFF;
      --red:    #DC2626;
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; min-height: 100vh; }

    /* ── LOGIN SCREEN ── */
    #login-screen {
      min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .login-box {
      background: var(--white); border: 1.5px solid var(--border); border-radius: 12px;
      padding: 40px 36px; width: 100%; max-width: 360px;
    }
    .login-logo { font-size: 15px; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 28px; color: var(--ink); }
    .login-logo span { color: var(--green); }
    .login-heading { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 6px; }
    .login-sub { font-size: 13px; color: var(--ink3); margin-bottom: 28px; }
    label { display: block; font-size: 12px; font-weight: 600; color: var(--ink2); margin-bottom: 6px; }
    .pw-input {
      width: 100%; background: var(--bg); border: 1.5px solid var(--border);
      border-radius: 6px; padding: 12px 14px; font-size: 14px; font-family: 'Inter', sans-serif;
      color: var(--ink); outline: none; transition: border-color 0.15s; margin-bottom: 12px;
    }
    .pw-input:focus { border-color: var(--green); }
    .pw-btn {
      width: 100%; background: var(--ink); color: var(--bg); border: none; border-radius: 6px;
      padding: 13px; font-size: 14px; font-weight: 700; font-family: 'Inter', sans-serif;
      cursor: pointer; transition: background 0.15s;
    }
    .pw-btn:hover { background: var(--green); }
    .pw-err { font-size: 12px; color: var(--red); margin-top: 10px; min-height: 18px; }

    /* ── DASHBOARD ── */
    #dashboard { display: none; }

    .dash-header {
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 18px 40px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .dash-logo { font-size: 14px; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); }
    .dash-logo span { color: var(--green); }
    .dash-logout {
      font-size: 12px; font-weight: 600; color: var(--ink3);
      background: none; border: 1px solid var(--border); border-radius: 5px;
      padding: 6px 14px; cursor: pointer; font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }
    .dash-logout:hover { border-color: var(--red); color: var(--red); }

    .dash-body { max-width: 900px; margin: 0 auto; padding: 40px 24px; }

    .dash-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 6px; }
    .dash-subtitle { font-size: 13px; color: var(--ink3); margin-bottom: 36px; }

    /* Stats */
    .dash-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 36px; }
    .stat-card {
      background: var(--white); border: 1px solid var(--border); border-radius: 10px;
      padding: 20px 22px;
    }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink3); margin-bottom: 8px; }
    .stat-num { font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; color: var(--ink); line-height: 1; }
    .stat-card.green .stat-num { color: var(--green); }

    /* Filter tabs */
    .dash-tabs { display: flex; gap: 6px; margin-bottom: 20px; }
    .tab-btn {
      font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600;
      padding: 7px 16px; border-radius: 5px; border: 1px solid var(--border);
      background: var(--white); color: var(--ink2); cursor: pointer; transition: all 0.12s;
    }
    .tab-btn.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .tab-btn:hover:not(.active) { border-color: var(--ink2); color: var(--ink); }

    /* Table */
    .dash-table-wrap {
      background: var(--white); border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    }
    table { width: 100%; border-collapse: collapse; }
    thead tr { border-bottom: 1px solid var(--border); }
    th {
      padding: 12px 16px; text-align: left;
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--ink3);
    }
    tbody tr { border-bottom: 1px solid var(--border); transition: background 0.1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--bg); }
    td { padding: 14px 16px; font-size: 13px; color: var(--ink2); vertical-align: middle; }
    td.email { font-weight: 600; color: var(--ink); }
    .badge {
      display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.06em; padding: 3px 9px; border-radius: 20px;
    }
    .badge.notify { background: var(--green-lt); color: var(--green); }
    .badge.domain { background: #FEF3C7; color: #92400E; }

    .empty-state {
      padding: 60px 24px; text-align: center; color: var(--ink3); font-size: 14px;
    }

    .dash-loading { padding: 60px 24px; text-align: center; color: var(--ink3); font-size: 14px; }

    .dash-error {
      background: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px;
      padding: 16px 20px; font-size: 13px; color: var(--red); margin-bottom: 24px;
    }

    @media (max-width: 640px) {
      .dash-header { padding: 16px 20px; }
      .dash-body { padding: 24px 16px; }
      .dash-stats { grid-template-columns: 1fr 1fr; }
      th:nth-child(4), td:nth-child(4) { display: none; }
    }
  </style>
</head>
<body>

  <!-- LOGIN -->
  <div id="login-screen">
    <div class="login-box">
      <div class="login-logo">GoAustralia<span>.co.nz</span></div>
      <div class="login-heading">Admin access</div>
      <p class="login-sub">Enter your password to view leads.</p>
      <label for="pw">Password</label>
      <input class="pw-input" type="password" id="pw" placeholder="••••••••••" />
      <button class="pw-btn" id="pw-btn">Sign in</button>
      <div class="pw-err" id="pw-err"></div>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="dashboard">

    <div class="dash-header">
      <div class="dash-logo">GoAustralia<span>.co.nz</span> &mdash; Leads</div>
      <button class="dash-logout" id="logout-btn">Sign out</button>
    </div>

    <div class="dash-body">
      <div class="dash-title">Lead Dashboard</div>
      <p class="dash-subtitle" id="dash-updated">Loading leads…</p>

      <div id="dash-error" class="dash-error" style="display:none;"></div>

      <div class="dash-stats">
        <div class="stat-card">
          <div class="stat-label">Total Leads</div>
          <div class="stat-num" id="stat-total">—</div>
        </div>
        <div class="stat-card green">
          <div class="stat-label">Notify Me</div>
          <div class="stat-num" id="stat-notify">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Domain Interest</div>
          <div class="stat-num" id="stat-domain">—</div>
        </div>
      </div>

      <div class="dash-tabs">
        <button class="tab-btn active" data-filter="all">All</button>
        <button class="tab-btn" data-filter="notify">Notify me</button>
        <button class="tab-btn" data-filter="domain">Domain interest</button>
      </div>

      <div class="dash-table-wrap">
        <div class="dash-loading" id="table-loading">Fetching leads…</div>
        <table id="leads-table" style="display:none;">
          <thead>
            <tr>
              <th>#</th>
              <th>Email</th>
              <th>Type</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody id="leads-tbody"></tbody>
        </table>
        <div class="empty-state" id="empty-state" style="display:none;">No leads yet.</div>
      </div>
    </div>

  </div>

  <script>
    const PASSWORD = 'Mandeep2026';
    let allLeads = [];
    let activeFilter = 'all';

    // ── AUTH ──
    const loginScreen = document.getElementById('login-screen');
    const dashboard   = document.getElementById('dashboard');

    function showDashboard() {
      loginScreen.style.display = 'none';
      dashboard.style.display   = 'block';
      loadLeads();
    }

    if (sessionStorage.getItem('ga_admin') === '1') {
      showDashboard();
    }

    document.getElementById('pw-btn').addEventListener('click', function() {
      const val = document.getElementById('pw').value;
      if (val === PASSWORD) {
        sessionStorage.setItem('ga_admin', '1');
        showDashboard();
      } else {
        document.getElementById('pw-err').textContent = 'Incorrect password.';
        document.getElementById('pw').value = '';
      }
    });
    document.getElementById('pw').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') document.getElementById('pw-btn').click();
    });

    document.getElementById('logout-btn').addEventListener('click', function() {
      sessionStorage.removeItem('ga_admin');
      location.reload();
    });

    // ── LOAD LEADS ──
    async function loadLeads() {
      try {
        const res = await fetch('/api/lead', {
          headers: { 'Authorization': 'Bearer ' + PASSWORD }
        });
        const data = await res.json();

        if (!data.ok) {
          showError(data.error || 'Failed to load leads.');
          return;
        }

        allLeads = (data.leads || []).sort((a, b) => new Date(b.date) - new Date(a.date));
        renderStats();
        renderTable();
        document.getElementById('dash-updated').textContent =
          'Last refreshed ' + new Date().toLocaleTimeString('en-NZ');
        document.getElementById('table-loading').style.display = 'none';
        document.getElementById('leads-table').style.display = 'table';
      } catch (e) {
        showError('Could not connect to the API. Make sure the KV binding is set up in Cloudflare.');
      }
    }

    function showError(msg) {
      const el = document.getElementById('dash-error');
      el.textContent = msg;
      el.style.display = 'block';
      document.getElementById('table-loading').style.display = 'none';
    }

    function renderStats() {
      const notify = allLeads.filter(l => l.type === 'notify').length;
      const domain = allLeads.filter(l => l.type === 'domain').length;
      document.getElementById('stat-total').textContent  = allLeads.length;
      document.getElementById('stat-notify').textContent = notify;
      document.getElementById('stat-domain').textContent = domain;
    }

    function renderTable() {
      const filtered = activeFilter === 'all'
        ? allLeads
        : allLeads.filter(l => l.type === activeFilter);

      const tbody = document.getElementById('leads-tbody');
      const empty = document.getElementById('empty-state');

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        document.getElementById('leads-table').style.display = 'none';
        empty.style.display = 'block';
        return;
      }

      empty.style.display = 'none';
      document.getElementById('leads-table').style.display = 'table';

      tbody.innerHTML = filtered.map((lead, i) => `
        <tr>
          <td>${filtered.length - i}</td>
          <td class="email">${escHtml(lead.email)}</td>
          <td><span class="badge ${lead.type === 'notify' ? 'notify' : 'domain'}">${lead.type === 'notify' ? 'Notify me' : 'Domain'}</span></td>
          <td>${formatDate(lead.date)}</td>
        </tr>
      `).join('');
    }

    // ── TABS ──
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        activeFilter = this.dataset.filter;
        renderTable();
      });
    });

    function formatDate(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('en-NZ', {
        day: 'numeric', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      });
    }

    function escHtml(str) {
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
  </script>

</body>
</html>
