        <div class="form-row">
          <div class="fld">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your full name" required />
          </div>
          <div class="fld">
            <label for="email">Business Email</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
        </div>
        
        <div class="form-row">
          <div class="fld">
            <label for="company">Company / Agency (Optional)</label>
            <input type="text" id="company" name="company" placeholder="e.g. Wise or Private Portfolio" />
          </div>
          <div class="fld">
            <label for="offer">Initial Offer (NZD)</label>
            <input type="text" id="offer" name="offer" placeholder="e.g. 5,000" />
          </div>
        </div>

        <div class="fld">
          <label for="message">Intended Use & Message</label>
          <textarea id="message" name="message" placeholder="Provide details on your intended usage, portfolio strategy, or terms..."></textarea>
        </div>

        <button type="submit" class="sbmt-btn">Submit Purchase Enquiry</button>
      </form>
      
      <p class="alt-contact">or contact directly via email: <a href="mailto:goaustralia.co.nz@gmail.com">goaustralia.co.nz@gmail.com</a></p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="wrap">
      <p>Listed independently. All rights reserved. Secure escrow integrations supported. &copy; 2026</p>
    </div>
  </footer>

  <script>
    // ── PAGEVIEW TRACKING ──
    fetch('/api/pageview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ referrer: document.referrer || 'direct' })
    }).catch(() => {});

    // ── INTERACTIVE MOCKUP: FX CALCULATOR ──
    const fxSendVal = document.getElementById('fx-send-val');
    const fxReceiveVal = document.getElementById('fx-receive-val');
    const rate = 0.9234;

    fxSendVal.addEventListener('input', function() {
      const val = parseFloat(fxSendVal.value) || 0;
      const converted = Math.round(val * rate);
      fxReceiveVal.value = converted.toLocaleString();
    });

    // ── INTERACTIVE MOCKUP: CHECKLIST TOGGLING ──
    const checklistProgBar = document.getElementById('checklist-prog-bar');
    const targetCheckbox = document.getElementById('target-checkbox');
    const targetLbl = document.getElementById('target-lbl');

    function toggleChecklist(el) {
      const box = el.querySelector('.chk-checkbox');
      const text = el.querySelector('span');

      if (box.classList.contains('empty')) {
        box.classList.remove('empty');
        box.textContent = '✓';
        text.style.color = 'var(--txt-base)';
        text.style.textDecoration = 'none';
      } else {
        box.classList.add('empty');
        box.textContent = '';
        text.style.color = 'var(--txt-muted)';
      }

      // Recalculate progress fill
      const total = el.parentElement.querySelectorAll('.chk-item').length;
      const checked = el.parentElement.querySelectorAll('.chk-checkbox:not(.empty)').length;
      const pct = Math.round((checked / total) * 100);
      checklistProgBar.style.width = pct + '%';
    }

    // ── INTERACTIVE MOCKUP: RELOCATION ESTIMATOR ──
    function calculateReloQuote() {
      const sizeVal = parseInt(document.getElementById('relo-size').value);
      const reloPriceLbl = document.getElementById('relo-price-lbl');
      
      let price = 6800;
      if (sizeVal === 1) price = 3200;
      else if (sizeVal === 5) price = 9800;

      reloPriceLbl.textContent = '$' + price.toLocaleString() + ' NZD';
    }

    // ── ENQUIRY FORM SUBMISSION ──
    document.getElementById('enquiry-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = this.querySelector('.sbmt-btn');
      const d = Object.fromEntries(new FormData(this));

      btn.textContent = 'Submitting Enquiry...';
      btn.disabled = true;

      try {
        await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(d)
        });
      } catch {}

      const subj = encodeURIComponent('Domain Acquisition Enquiry — goaustralia.co.nz');
      const body = encodeURIComponent(
        'Name: ' + d.name + '\n' +
        'Email: ' + d.email + '\n' +
        'Company: ' + (d.company || 'Not specified') + '\n' +
        'Offer (NZD): ' + (d.offer || 'Not specified') + '\n\n' +
        'Intended Use & Message:\n' + d.message
      );

      btn.textContent = 'Enquiry Sent ✓';
      btn.style.background = 'var(--accent-emerald)';
      setTimeout(() => {
        window.location.href = 'mailto:goaustralia.co.nz@gmail.com?subject=' + subj + '&body=' + body;
      }, 600);
    });
  </script>

</body>
</html>
