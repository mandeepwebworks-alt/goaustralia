---
// GoAustralia.co.nz — Premium Apple Light Glassmorphic Showcase
---
<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>goaustralia.co.nz — Premium Domain & Digital Relocation Asset for Sale</title>
  <meta name="description" content="Acquire goaustralia.co.nz. Exact-match digital asset for the New Zealand to Australia relocation corridor. Includes interactive solution mockups, SEO traction, and ROI calculator." />
  <link rel="canonical" href="https://goaustralia.co.nz/" />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300&display=swap" rel="stylesheet" />
  
  <style>
    /* ── APPLE GLASSMORPHIC LIGHT DESIGN SYSTEM ── */
    :root {
      --bg-base: #F5F5F7;        /* Apple's signature light gray */
      --bg-card: rgba(255, 255, 255, 0.75); /* Frosted glass card */
      --bg-raised: #FFFFFF;      /* Clean pure white for high contrast */
      --bg-border: rgba(0, 0, 0, 0.08);
      --bg-border-active: rgba(0, 0, 0, 0.15);
      
      --accent-emerald: #00875A;  /* Emerald Green (Premium corridor accent) */
      --accent-emerald-glow: rgba(0, 135, 90, 0.08);
      --accent-gold: #C59B27;     /* Warm Gold / Bronze (Representing premium asset value) */
      --accent-gold-glow: rgba(197, 155, 39, 0.08);
      
      --txt-base: #1D1D1F;        /* Apple deep charcoal black */
      --txt-muted: #86868B;       /* Apple secondary grey */
      --txt-faint: #AEAEB2;       /* Apple tertiary grey */
      
      --font-sans: 'Plus Jakarta Sans', sans-serif;
      --font-serif: 'Fraunces', serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      background-color: var(--bg-base);
      color: var(--txt-base);
      overflow-x: hidden;
      line-height: 1.5;
    }

    .wrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
    .wrap-narrow { max-width: 800px; margin: 0 auto; padding: 0 24px; }

    /* ── AMBIENT SOFT GLOW BLOBS (APPLE STYLE) ── */
    .glow-blob {
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(160px);
      z-index: 0;
      opacity: 0.12;
    }
    .glow-1 {
      top: 5%;
      left: -100px;
      background: var(--accent-emerald);
    }
    .glow-2 {
      top: 35%;
      right: -100px;
      background: var(--accent-gold);
    }
    .glow-3 {
      bottom: 15%;
      left: 15%;
      background: var(--accent-emerald);
    }

    /* ── NAVIGATION ── */
    header {
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      background: rgba(245, 245, 247, 0.75);
      border-bottom: 1px solid var(--bg-border);
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 16px 0;
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-size: 19px;
      font-weight: 800;
      color: var(--txt-base);
      text-decoration: none;
      letter-spacing: -0.04em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo span {
      background: linear-gradient(135deg, var(--accent-emerald), var(--accent-gold));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .status-badge {
      display: none;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      color: var(--accent-emerald);
      background: rgba(0, 135, 90, 0.06);
      border: 1px solid rgba(0, 135, 90, 0.15);
      padding: 4px 12px;
      border-radius: 20px;
      letter-spacing: 0.02em;
    }
    @media (min-width: 480px) {
      .status-badge { display: flex; }
    }
    .status-dot {
      width: 6px;
      height: 6px;
      background-color: var(--accent-emerald);
      border-radius: 50%;
      box-shadow: 0 0 6px var(--accent-emerald);
      animation: pulse 2.2s infinite;
    }
    .nav-cta {
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF;
      background: var(--txt-base);
      padding: 10px 20px;
      border-radius: 20px;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .nav-cta:hover {
      background: var(--accent-emerald);
      box-shadow: 0 4px 12px rgba(0, 135, 90, 0.2);
      transform: translateY(-1px);
    }

    /* ── HERO SECTION ── */
    .hero {
      position: relative;
      padding: 56px 16px 44px;
      text-align: center;
      z-index: 10;
    }
    @media (min-width: 640px) {
      .hero { padding: 88px 24px 64px; }
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-gold);
      background: rgba(197, 155, 39, 0.06);
      border: 1px solid rgba(197, 155, 39, 0.15);
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 24px;
    }
    .hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 7.5vw, 5.2rem);
      font-weight: 300;
      letter-spacing: -0.04em;
      line-height: 1.05;
      color: var(--txt-base);
      margin-bottom: 20px;
    }
    .hero h1 span {
      font-weight: 700;
      background: linear-gradient(135deg, var(--txt-base) 40%, var(--txt-muted) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero p {
      font-size: 18px;
      color: var(--txt-muted);
      line-height: 1.65;
      max-width: 680px;
      margin: 0 auto 36px;
    }
    .hero-ctas {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 12px;
    }
    @media (min-width: 480px) {
      .hero-ctas { flex-direction: row; align-items: center; gap: 16px; }
      .hero-ctas a { width: auto !important; }
    }
    .btn-primary {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      color: #FFFFFF;
      background: linear-gradient(135deg, var(--accent-emerald), #00A66E);
      padding: 14px 36px;
      border-radius: 24px;
      text-decoration: none;
      transition: all 0.25s ease;
      box-shadow: 0 4px 15px rgba(0, 135, 90, 0.15);
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      transform: translateY(-1.5px);
      box-shadow: 0 8px 22px rgba(0, 135, 90, 0.3);
    }
    .btn-secondary {
      display: inline-block;
      font-size: 14px;
      font-weight: 600;
      color: var(--txt-base);
      background: rgba(0, 0, 0, 0.03);
      border: 1px solid var(--bg-border);
      padding: 13px 32px;
      border-radius: 24px;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .btn-secondary:hover {
      background: rgba(0, 0, 0, 0.06);
      border-color: var(--bg-border-active);
    }

    /* ── METRICS STRIP ── */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 56px;
      position: relative;
      z-index: 10;
    }
    @media (min-width: 640px) {
      .metrics-grid { gap: 16px; margin-bottom: 72px; }
    }
    @media (min-width: 768px) {
      .metrics-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .metric-card {
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      background: var(--bg-card);
      border: 1px solid var(--bg-border);
      border-radius: 12px;
      padding: 24px 20px;
      text-align: center;
      transition: all 0.3s ease;
    }
    .metric-card:hover {
      border-color: var(--accent-emerald-glow);
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }
    .metric-num {
      font-family: var(--font-serif);
      font-size: 2.2rem;
      font-weight: 400;
      color: var(--accent-emerald);
      margin-bottom: 4px;
      background: linear-gradient(135deg, var(--accent-emerald), #00A66E);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .metric-label {
      font-size: 11px;
      color: var(--txt-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ── SECTION GENERALS ── */
    section {
      padding: 52px 0;
      position: relative;
      z-index: 10;
    }
    @media (min-width: 768px) {
      section { padding: 80px 0; }
    }
    .sec-header {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 40px;
    }
    @media (min-width: 640px) {
      .sec-header { margin: 0 auto 56px; }
    }
    .sec-badge {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent-emerald);
      margin-bottom: 12px;
      display: inline-block;
    }
    .sec-title {
      font-family: var(--font-serif);
      font-size: 2.3rem;
      font-weight: 400;
      letter-spacing: -0.03em;
      margin-bottom: 16px;
      color: var(--txt-base);
    }
    .sec-desc {
      font-size: 14px;
      color: var(--txt-muted);
      line-height: 1.6;
    }

    /* ── PREMIUM GLASS CARD ── */
    .glass-card {
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 16px;
      padding: 20px 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
    }
    @media (min-width: 640px) {
      .glass-card { padding: 40px; }
    }

    /* ── SEO TRACTION SECTION ── */
    .seo-summary-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }
    @media (min-width: 480px) {
      .seo-summary-cards { grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px; }
    }
    .seo-summary-card {
      background: rgba(255, 255, 255, 0.6);
      border: 1px solid var(--bg-border);
      border-radius: 8px;
      padding: 16px 20px;
      text-align: left;
    }
    .seo-sum-val {
      font-size: 20px;
      font-weight: 800;
      color: var(--txt-base);
      margin-bottom: 2px;
    }
    .seo-sum-lbl {
      font-size: 10px;
      color: var(--txt-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .seo-table-container {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--bg-border);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.4);
    }
    .seo-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    .seo-table th {
      background: rgba(0, 0, 0, 0.02);
      padding: 14px 18px;
      font-weight: 700;
      color: var(--txt-muted);
      border-bottom: 1px solid var(--bg-border);
      text-transform: uppercase;
      font-size: 9px;
      letter-spacing: 0.06em;
    }
    .seo-table td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--bg-border);
      color: var(--txt-base);
    }
    .seo-table tr:last-child td {
      border-bottom: none;
    }
    .seo-table tr:hover td {
      background: rgba(255, 255, 255, 0.3);
    }
    .keyword-badge {
      font-family: monospace;
      font-size: 12px;
      color: var(--accent-emerald);
      background: rgba(0, 135, 90, 0.05);
      border: 1px solid rgba(0, 135, 90, 0.12);
      padding: 2px 8px;
      border-radius: 4px;
    }
    .intent-tag {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      display: inline-block;
    }
    .intent-high {
      background: rgba(197, 155, 39, 0.06);
      border: 1px solid rgba(197, 155, 39, 0.15);
      color: var(--accent-gold);
    }
    .intent-medium {
      background: rgba(0, 135, 90, 0.06);
      border: 1px solid rgba(0, 135, 90, 0.15);
      color: var(--accent-emerald);
    }
    .intent-commercial {
      background: rgba(0, 113, 227, 0.06);
      border: 1px solid rgba(0, 113, 227, 0.15);
      color: #0071E3;
    }

    /* ── NEW SOLUTIONS & MOCKUPS GRID (1 mockup for every card) ── */
    .uses-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    @media (min-width: 700px) {
      .uses-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
    }
    .use-card {
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 16px;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.01);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-align: left;
    }
    @media (min-width: 640px) {
      .use-card { padding: 36px; gap: 24px; }
    }
    .use-card:hover {
      border-color: rgba(0, 135, 90, 0.2);
      transform: translateY(-2px);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.03);
    }
    .use-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }
    .use-num {
      font-size: 10px;
      font-weight: 700;
      color: var(--accent-gold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .use-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--txt-base);
      margin-bottom: 8px;
    }
    .use-desc {
      font-size: 13.5px;
      color: var(--txt-muted);
      line-height: 1.6;
      margin-bottom: 12px;
    }

    /* ── HIGH FIDELITY USE CASE MOCKUPS ── */
    .mini-mockup {
      background: #FFFFFF;
      border: 1px solid var(--bg-border);
      border-radius: 12px;
      padding: 18px;
      box-shadow: inset 0 0 12px rgba(0,0,0,0.01), 0 4px 16px rgba(0,0,0,0.02);
      overflow: hidden;
    }
    
    /* 1. FX Transfer Mockup */
    .fx-mockup-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
    }
    .fx-input-box {
      border: 1px solid var(--bg-border);
      border-radius: 8px;
      padding: 8px 12px;
      background: var(--bg-base);
    }
    .fx-lbl {
      font-size: 9px;
      color: var(--txt-muted);
      text-transform: uppercase;
      font-weight: bold;
      margin-bottom: 2px;
    }
    .fx-inp-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
    }
    .fx-inp-row input {
      width: 100%;
      border: none;
      background: none;
      font-size: 15px;
      font-weight: 700;
      color: var(--txt-base);
      outline: none;
    }
    .fx-curr-sel {
      font-size: 11px;
      font-weight: bold;
      color: var(--txt-base);
    }
    .fx-arrow {
      color: var(--accent-emerald);
      font-size: 14px;
    }
    .fx-meta-row {
      font-size: 11px;
      color: var(--txt-muted);
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
    }
    .fx-btn {
      width: 100%;
      background: var(--accent-emerald);
      color: #FFFFFF;
      border: none;
      font-size: 11px;
      font-weight: 700;
      padding: 9px;
      border-radius: 6px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* 2. Checklist SaaS Mockup */
    .chk-mockup-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: bold;
    }
    .chk-progress-bar {
      height: 6px;
      width: 80px;
      background: rgba(0,0,0,0.06);
      border-radius: 10px;
      overflow: hidden;
    }
    .chk-progress-fill {
      width: 66%;
      height: 100%;
      background: var(--accent-emerald);
      border-radius: 10px;
      transition: width 0.3s ease;
    }
    .chk-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .chk-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--txt-base);
      cursor: pointer;
      user-select: none;
    }
    .chk-checkbox {
      width: 14px;
      height: 14px;
      border-radius: 3px;
      border: 1px solid var(--accent-emerald);
      background: rgba(0, 135, 90, 0.04);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-emerald);
      font-size: 9px;
      font-weight: bold;
      flex-shrink: 0;
    }
    .chk-checkbox.empty {
      border-color: var(--txt-faint);
      background: none;
    }

    /* 3. Migrant Banking Mockup */
    .bank-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: center;
    }
    .bank-card-visual {
      background: linear-gradient(135deg, #2e2e2e 0%, #111111 100%);
      border-radius: 8px;
      padding: 12px;
      height: 84px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #FFFFFF;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      position: relative;
      overflow: hidden;
    }
    .bank-card-visual::after {
      content: '';
      position: absolute;
      width: 60px;
      height: 60px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 50%;
      top: -20px;
      right: -20px;
    }
    .bank-card-logo {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .bank-card-logo span {
      color: var(--accent-emerald);
    }
    .bank-card-chip {
      width: 14px;
      height: 10px;
      background: #D4AF37;
      border-radius: 2px;
    }
    .bank-card-num {
      font-size: 7.5px;
      font-family: monospace;
      letter-spacing: 0.1em;
    }
    .bank-status-col {
      text-align: left;
      font-size: 11px;
    }
    .bank-status-pill {
      display: inline-block;
      font-size: 8px;
      font-weight: bold;
      color: var(--accent-emerald);
      background: rgba(0,135,90,0.06);
      border: 1px solid rgba(0,135,90,0.15);
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    /* 4. Trans-Tasman Relocation Mockup */
    .relo-inputs {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 12px;
    }
    .relo-select-box {
      border: 1px solid var(--bg-border);
      border-radius: 6px;
      padding: 6px 10px;
      background: var(--bg-base);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: bold;
    }
    .relo-select-box select {
      border: none;
      background: none;
      outline: none;
      font-size: 11px;
      font-weight: bold;
      color: var(--txt-base);
      cursor: pointer;
    }
    .relo-quote-display {
      background: rgba(0, 135, 90, 0.04);
      border: 1px solid rgba(0, 135, 90, 0.15);
      border-radius: 6px;
      padding: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11.5px;
      font-weight: 700;
    }

    /* 5. Superannuation Transfer Mockup */
    .super-transfer-visual {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      margin-bottom: 8px;
    }
    .super-node {
      border: 1px solid var(--bg-border);
      border-radius: 6px;
      background: var(--bg-base);
      padding: 8px 10px;
      font-size: 10px;
      font-weight: bold;
      width: 72px;
      text-align: center;
    }
    .super-path {
      flex: 1;
      height: 2px;
      background: linear-gradient(90deg, var(--accent-emerald), var(--accent-gold));
      position: relative;
    }
    .super-path-pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
