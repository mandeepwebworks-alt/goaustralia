<!-- CLIENT JS -->
<script is:inline>
(function() {
  var heroFrom = document.getElementById('hero-from');
  var heroTo = document.getElementById('hero-to');
  var heroFromDisp = document.getElementById('hero-from-display');
  var heroToDisp = document.getElementById('hero-to-display');
  heroFrom?.addEventListener('change', function() {
    heroFromDisp.textContent = heroFrom.value;
    var f = document.querySelector('#quote-form select[name="fromCity"]');
    if (f) f.value = heroFrom.value;
  });
  heroTo?.addEventListener('change', function() {
    heroToDisp.textContent = heroTo.value;
    var f = document.querySelector('#quote-form select[name="toCity"]');
    if (f) f.value = heroTo.value;
  });

  function initSegs(id, name) {
    var c = document.getElementById(id);
    if (!c) return;
    var h = document.querySelector('input[name="' + name + '"]');
    c.querySelectorAll('.seg').forEach(function(btn) {
      btn.addEventListener('click', function() {
        c.querySelectorAll('.seg').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        if (h) h.value = btn.dataset.val;
      });
    });
  }
  initSegs('timeline-segs', 'timeline');
  initSegs('size-segs', 'homeSize');

  function updatePill() {
    var t = 0;
    document.querySelectorAll('#steppers .stepper-row').forEach(function(r) {
      t += parseInt(r.querySelector('.stepper-val').textContent) || 0;
    });
    var p = document.getElementById('items-pill');
    if (p) p.textContent = t + ' items';
  }
  document.querySelectorAll('#steppers .stepper-row').forEach(function(row) {
    var v = row.querySelector('.stepper-val');
    row.querySelector('.stepper-dec').addEventListener('click', function() {
      var n = Math.max(0, parseInt(v.textContent) - 1);
      v.textContent = n;
      updatePill();
    });
    row.querySelector('.stepper-inc').addEventListener('click', function() {
      v.textContent = parseInt(v.textContent) + 1;
      updatePill();
    });
  });

  document.querySelectorAll('#extras .extra-chip').forEach(function(c) {
    c.addEventListener('click', function() { c.classList.toggle('active'); });
  });

  document.querySelectorAll('#faq-list .faq-item').forEach(function(item) {
    var trigger = item.querySelector('.faq-trigger');
    var body = item.querySelector('.faq-body');
    var toggle = item.querySelector('.faq-toggle');
    trigger.addEventListener('click', function() {
      var open = body.style.display !== 'none';
      body.style.display = open ? 'none' : '';
      toggle.textContent = open ? '+' : '−';
    });
  });

  var stickyCta = document.getElementById('sticky-cta');
  var quoteSection = document.getElementById('quote');
  if (stickyCta && quoteSection) {
    var obs = new IntersectionObserver(function(entries) {
      stickyCta.classList.toggle('visible', !entries[0].isIntersecting);
    }, { threshold: 0 });
    obs.observe(quoteSection);
  }

  var form = document.getElementById('quote-form');
  var successEl = document.getElementById('quote-success');
  var errorEl = document.getElementById('form-error');
  var submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async function(e) {
    e.preventDefault();
    errorEl.style.display = 'none';
    var fd = new FormData(form);
    if (fd.get('website')) return;

    var name = (fd.get('name') || '').trim();
    var email = (fd.get('email') || '').trim();
    if (!name) { showErr('Please enter your name.'); return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('Please enter a valid email.'); return; }

    var items = {};
    document.querySelectorAll('#steppers .stepper-row').forEach(function(r) {
      items[r.dataset.key] = parseInt(r.querySelector('.stepper-val').textContent) || 0;
    });
    var extras = {};
    document.querySelectorAll('#extras .extra-chip').forEach(function(c) {
      extras[c.dataset.key] = c.classList.contains('active');
    });

    var payload = {
      name: name, email: email,
      phone: fd.get('phone') || '',
      fromCity: fd.get('fromCity'),
      toCity: fd.get('toCity'),
      timeline: fd.get('timeline'),
      homeSize: fd.get('homeSize'),
      items: items, extras: extras
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      var res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error('err');
      var totalItems = Object.values(items).reduce(function(a, b) { return a + b; }, 0);
      var firstName = name.split(' ')[0];
      document.getElementById('success-name').textContent = firstName;
      document.getElementById('success-detail').innerHTML =
        'We’ve got your ' + payload.fromCity + ' → ' + payload.toCity + ' move with ' + totalItems + ' items. Up to 3 verified movers will email quotes to <strong style="color:var(--ink)">' + email + '</strong> within 24 hours.';
      form.style.display = 'none';
      successEl.style.display = 'flex';
    } catch(err) {
      showErr('Something went wrong. Please try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Get my free quotes →';
    }
  });

  function showErr(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
  }

  document.getElementById('edit-btn')?.addEventListener('click', function() {
    successEl.style.display = 'none';
    form.style.display = '';
  });
})();
</script>

</Base>
