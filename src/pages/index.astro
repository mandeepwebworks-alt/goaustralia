---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="GoAustralia.co.nz — The Complete Guide to Moving from NZ to Australia"
  description="Step-by-step guides, visa tools, cost calculators and suburb research for New Zealanders moving to Australia."
>
<style is:global>

/* ── HERO ──────────────────────────────────────────── */
.h-hero { background: var(--dark); padding: 80px 0 72px; }
.h-hero-inner { max-width: 760px; }
.h-label {
  font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
  color: var(--amber); text-transform: uppercase; letter-spacing: 0.12em;
  margin-bottom: 28px; display: block;
}
.h-headline {
  font-family: 'Playfair Display', serif; font-size: clamp(2.6rem, 5vw, 4rem);
  font-weight: 800; color: var(--white); line-height: 1.06;
  letter-spacing: -0.025em; margin-bottom: 22px;
}
.h-headline em { font-style: italic; color: #4B5563; }
.h-lead {
  font-family: 'Inter', sans-serif; font-size: 1.05rem; color: #64748B;
  line-height: 1.78; max-width: 540px; margin-bottom: 40px;
}
.h-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-bottom: 60px; }
.h-cta {
  background: var(--white); color: var(--ink);
  font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700;
  padding: 13px 28px; border-radius: 4px; display: inline-block; transition: background 0.12s;
}
.h-cta:hover { background: #F1F5F9; }
.h-link {
  font-family: 'Inter', sans-serif; font-size: 13px; color: #64748B;
  text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #334155;
}
.h-link:hover { color: #94A3B8; }
.h-bar { border-top: 1px solid var(--dark-bd); padding-top: 28px; display: flex; gap: 48px; }
.h-stat strong {
  font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--white); display: block; margin-bottom: 3px;
}
.h-stat span { font-family: 'Inter', sans-serif; font-size: 11px; color: #475569; }

/* ── GUIDES — editorial list ────────────────────────── */
.h-guides { padding: 80px 0; background: var(--white); }
.h-guides-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); margin-bottom: 12px; }
.h-guides-title { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: var(--ink); margin-bottom: 36px; }
.h-guide-row {
  display: flex; align-items: baseline; gap: 20px;
  padding: 28px 0; border-top: 1px solid var(--border);
}
.h-guide-row:last-of-type { border-bottom: 1px solid var(--border); }
.h-guide-num { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; color: var(--ink4); letter-spacing: 0.06em; flex-shrink: 0; width: 24px; }
.h-guide-content { flex: 1; min-width: 0; }
.h-guide-name { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
.h-guide-desc { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.5; }
.h-guide-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.h-guide-pages { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); }
.h-guide-price { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--ink); }
.h-guide-cta { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: var(--amber); }
.h-guides-footer { margin-top: 28px; display: flex; align-items: center; justify-content: space-between; }
.h-guides-footer p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); }
.h-guides-footer a { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; color: var(--white); background: var(--ink); padding: 11px 24px; border-radius: 4px; transition: background 0.12s; }
.h-guides-footer a:hover { background: var(--dark2); }

/* ── NUMBERS — dark social proof ───────────────────── */
.h-numbers { background: var(--dark); padding: 80px 0; }
.h-numbers-statement {
  font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700; color: var(--white); line-height: 1.2; max-width: 680px; margin-bottom: 56px;
}
.h-numbers-statement em { font-style: italic; color: var(--amber); }
.h-numbers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--dark-bd); padding-top: 40px; }
.h-number-item { padding-right: 40px; }
.h-number-item + .h-number-item { padding-left: 40px; padding-right: 40px; border-left: 1px solid var(--dark-bd); }
.h-number-item:last-child { padding-right: 0; }
.h-number-val { font-family: 'Playfair Display', serif; font-size: 2.8rem; font-weight: 700; color: var(--white); line-height: 1; margin-bottom: 10px; }
.h-number-label { font-family: 'Inter', sans-serif; font-size: 13px; color: #64748B; line-height: 1.55; }

/* ── WHAT CATCHES KIWIS OUT ─────────────────────────── */
.h-problems { padding: 80px 0; background: var(--surface); }
.h-problems-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.h-problems-left h2 { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: var(--ink); margin-bottom: 8px; line-height: 1.2; }
.h-problems-left p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.7; margin-bottom: 28px; }
.h-mistake { padding: 18px 0; border-top: 1px solid var(--border); }
.h-mistake:last-child { border-bottom: 1px solid var(--border); }
.h-mistake h3 { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
.h-mistake p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.65; }
.h-problems-right { position: sticky; top: 76px; }
.h-problems-right h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; line-height: 1.25; }
.h-problems-right > p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.7; margin-bottom: 24px; }
.h-covered-list { list-style: none; display: flex; flex-direction: column; gap: 0; margin-bottom: 28px; }
.h-covered-list li { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink2); padding: 10px 0; border-bottom: 1px solid var(--border); display: flex; gap: 10px; line-height: 1.45; }
.h-covered-list li::before { content: '→'; color: var(--amber); flex-shrink: 0; }
.h-cta-block a { display: block; background: var(--amber); color: var(--white); text-align: center; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; padding: 13px; border-radius: 4px; transition: background 0.12s; margin-bottom: 8px; }
.h-cta-block a:hover { background: var(--amber-dk); }
.h-cta-block p { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); text-align: center; }

/* ── FREE TOOLS ─────────────────────────────────────── */
.h-tools { padding: 80px 0; background: var(--white); border-top: 1px solid var(--border); }
.h-tools-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 40px; }
.h-tools-header h2 { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: var(--ink); }
.h-tools-header span { font-family: 'Inter', sans-serif; font-size: 12px; color: var(--ink4); }
.h-tools-row { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.h-tool { padding: 28px 24px 28px 0; border-right: 1px solid var(--border); display: block; transition: background 0.12s; }
.h-tool:last-child { border-right: none; padding-right: 0; }
.h-tool:first-child { padding-left: 0; }
.h-tool:hover { }
.h-tool-cat { font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); margin-bottom: 10px; }
.h-tool h3 { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 7px; }
.h-tool p { font-family: 'Inter', sans-serif; font-size: 12px; color: var(--ink3); line-height: 1.6; margin-bottom: 14px; }
.h-tool-link { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: var(--ink2); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--border); }
.h-tool-link:hover { color: var(--amber); text-decoration-color: var(--amber); }

/* ── BLOG ───────────────────────────────────────────── */
.h-blog { padding: 80px 0; background: var(--surface); border-top: 1px solid var(--border); }
.h-blog-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 36px; }
.h-blog-header h2 { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 700; color: var(--ink); }
.h-blog-header a { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); text-decoration: underline; text-underline-offset: 3px; }
.h-blog-feature { border-top: 3px solid var(--amber); padding-top: 24px; margin-bottom: 36px; display: block; }
.h-blog-feature:hover .h-blog-feat-title { color: var(--amber); }
.h-blog-feat-cat { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--amber); margin-bottom: 10px; }
.h-blog-feat-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--ink); line-height: 1.2; margin-bottom: 10px; transition: color 0.12s; }
.h-blog-feat-desc { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.7; max-width: 600px; margin-bottom: 14px; }
.h-blog-feat-meta { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); }
.h-blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--border); }
.h-blog-item { padding: 22px 24px 22px 0; border-right: 1px solid var(--border); display: block; }
.h-blog-item:last-child { border-right: none; padding-right: 0; }
.h-blog-item:hover .h-blog-item-title { color: var(--amber); }
.h-blog-item-cat { font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink4); margin-bottom: 7px; }
.h-blog-item-title { font-family: 'Playfair Display', serif; font-size: 0.95rem; font-weight: 700; color: var(--ink); line-height: 1.3; margin-bottom: 6px; transition: color 0.12s; }
.h-blog-item-meta { font-family: 'Inter', sans-serif; font-size: 10px; color: var(--ink4); }

/* ── TESTIMONIAL ─────────────────────────────────────── */
.h-testi { padding: 80px 0; background: var(--white); border-top: 1px solid var(--border); text-align: center; }
.h-testi-inner { max-width: 680px; margin: 0 auto; }
.h-testi-quote {
  font-family: 'Playfair Display', serif; font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  font-style: italic; color: var(--ink); line-height: 1.4; margin-bottom: 24px;
}
.h-testi-quote::before { content: '\201C'; }
.h-testi-quote::after  { content: '\201D'; }
.h-testi-attr { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); margin-bottom: 48px; }
.h-testi-attr strong { color: var(--ink); }
.h-testi-others { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; text-align: left; border-top: 1px solid var(--border); padding-top: 36px; }
.h-testi-other p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.65; font-style: italic; margin-bottom: 8px; }
.h-testi-other span { font-family: 'Inter', sans-serif; font-size: 12px; color: var(--ink4); }
.h-testi-other strong { color: var(--ink2); }

/* ── SUBSCRIBE ───────────────────────────────────────── */
.h-sub { background: var(--amber-lt); border-top: 1px solid var(--amber-bd); border-bottom: 1px solid var(--amber-bd); padding: 80px 0; }
.h-sub-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.h-sub-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--amber); margin-bottom: 12px; }
.h-sub-title { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: var(--ink); line-height: 1.15; margin-bottom: 6px; }
.h-sub-price { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 800; color: var(--ink); margin: 16px 0 4px; line-height: 1; }
.h-sub-price sub { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: var(--ink3); vertical-align: baseline; }
.h-sub-includes { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); margin-bottom: 24px; }
.h-sub-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.h-sub-list li { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink); display: flex; gap: 10px; }
.h-sub-list li::before { content: '✓'; color: var(--green); font-weight: 700; flex-shrink: 0; }
.h-sub-form { display: flex; flex-direction: column; gap: 10px; }
.h-sub-form input { width: 100%; border: 1.5px solid var(--border); background: var(--white); border-radius: 4px; padding: 13px 14px; font-size: 14px; font-family: 'Inter', sans-serif; color: var(--ink); outline: none; }
.h-sub-form input:focus { border-color: var(--amber); }
.h-sub-form a { display: block; background: var(--ink); color: var(--white); text-align: center; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; padding: 13px; border-radius: 4px; transition: background 0.12s; }
.h-sub-form a:hover { background: var(--dark2); }
.h-sub-note { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); text-align: center; }

/* ── RESPONSIVE ─────────────────────────────────────── */
@media (max-width: 900px) {
  .h-guide-row { flex-wrap: wrap; gap: 10px; }
  .h-guide-right { flex-direction: row; align-items: baseline; gap: 16px; }
  .h-numbers-grid { grid-template-columns: 1fr 1fr; }
  .h-number-item:last-child { grid-column: span 2; border-left: none; padding-left: 0; border-top: 1px solid var(--dark-bd); padding-top: 28px; }
  .h-problems-layout { grid-template-columns: 1fr; gap: 40px; }
  .h-problems-right { position: static; }
  .h-tools-row { grid-template-columns: 1fr 1fr; }
  .h-tool:nth-child(2) { border-right: none; padding-right: 0; }
  .h-tool:nth-child(3), .h-tool:nth-child(4) { border-top: 1px solid var(--border); padding-top: 28px; }
  .h-blog-grid { grid-template-columns: 1fr; }
  .h-blog-item { border-right: none; padding-right: 0; border-bottom: 1px solid var(--border); }
  .h-blog-item:last-child { border-bottom: none; }
  .h-testi-others { grid-template-columns: 1fr; gap: 24px; }
  .h-sub-layout { grid-template-columns: 1fr; gap: 40px; }
}
@media (max-width: 600px) {
  .h-headline { font-size: 2.4rem; }
  .h-bar { gap: 24px; flex-wrap: wrap; }
  .h-guides-footer { flex-direction: column; gap: 16px; }
  .h-tools-row { grid-template-columns: 1fr; }
  .h-tool { border-right: none; padding-right: 0; border-bottom: 1px solid var(--border); }
  .h-tool:last-child { border-bottom: none; }
}
</style>

<!-- ALERT -->
<div class="alert-band">
  <div class="shell">
    <div class="alert-inner">
      <strong>July 2025:</strong>&nbsp;Time on the Special Category Visa now counts toward the 4-year citizenship residence requirement.&nbsp;<a href="/blog/special-category-visa-guide">Read the guide →</a>
    </div>
  </div>
</div>

<!-- HERO -->
<section class="h-hero">
  <div class="shell">
    <div class="h-hero-inner">
      <span class="h-label">For New Zealanders moving to Australia</span>
      <h1 class="h-headline">Most Kiwis wing it.<br/><em>That costs them.</em></h1>
      <p class="h-lead">The SCV, tax, renting, super — Australia's system differs from New Zealand's in ways that catch even well-prepared movers off guard. Our guides cover every step, written for Kiwis.</p>
      <div class="h-actions">
        <a href="/pricing" class="h-cta">Get the guides — $1.99/month</a>
        <a href="/tools/visa-checker" class="h-link">Check your visa free →</a>
      </div>
      <div class="h-bar">
        <div class="h-stat"><strong>12,400+</strong><span>Kiwis helped since 2023</span></div>
        <div class="h-stat"><strong>232 pages</strong><span>Across 3 PDF guides</span></div>
        <div class="h-stat"><strong>Updated May 2025</strong><span>Including July 2025 changes</span></div>
      </div>
    </div>
  </div>
</section>

<!-- GUIDES — editorial list -->
<section class="h-guides">
  <div class="shell">
    <div class="h-guides-label">PDF Guides</div>
    <h2 class="h-guides-title">Three guides. Every stage of the move.</h2>

    {[
      { n:'01', title:'The Kiwi Moving to Australia Masterguide', desc:'Visa, banking, renting, Medicare and your first 90 days — in one complete guide.', pages:'90 pages', price:'$19', slug:'masterguide' },
      { n:'02', title:'Australian Tax & Finance for New Zealanders', desc:'TFN, superannuation, your first ATO return and KiwiSaver transfer.', pages:'68 pages', price:'$22', slug:'tax-finance' },
      { n:'03', title:'Finding a Job in Australia: The Kiwi Edition', desc:'CV format differences, the best job boards and salary benchmarks by city.', pages:'74 pages', price:'$27', slug:'jobs' },
    ].map(g => (
      <div class="h-guide-row reveal">
        <div class="h-guide-num">{g.n}</div>
        <div class="h-guide-content">
          <div class="h-guide-name">{g.title}</div>
          <div class="h-guide-desc">{g.desc}</div>
        </div>
        <div class="h-guide-right">
          <span class="h-guide-pages">{g.pages}</span>
          <span class="h-guide-price">{g.price}</span>
          <a href={`/guides/${g.slug}`} class="h-guide-cta">View contents →</a>
        </div>
      </div>
    ))}

    <div class="h-guides-footer">
      <p>Or get all three guides for <strong>$1.99/month</strong> — includes tools and weekly newsletter</p>
      <a href="/pricing">Start subscription →</a>
    </div>
  </div>
</section>

<!-- NUMBERS -->
<section class="h-numbers">
  <div class="shell">
    <p class="h-numbers-statement">
      Most of these problems are avoidable. Kiwis who arrive prepared
      spend less, settle faster, and <em>don't learn things the hard way.</em>
    </p>
    <div class="h-numbers-grid">
      <div class="h-number-item">
        <div class="h-number-val">47%</div>
        <p class="h-number-label">Tax withheld from your first pay if you don't have a Tax File Number. Takes 28 days — apply from NZ before you land.</p>
      </div>
      <div class="h-number-item">
        <div class="h-number-val">$6,500</div>
        <p class="h-number-label">Typical upfront cost — bond, rent in advance and setup — before your first Australian paycheque in Sydney or Melbourne.</p>
      </div>
      <div class="h-number-item">
        <div class="h-number-val">$18k+</div>
        <p class="h-number-label">Average KiwiSaver balance left behind in NZ. Most Kiwis don't know it can be transferred to Australian super under the trans-Tasman scheme.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT CATCHES KIWIS OUT -->
<section class="h-problems">
  <div class="shell">
    <div class="h-problems-layout">
      <div class="h-problems-left">
        <div class="h-guides-label" style="margin-bottom:12px;">Common mistakes</div>
        <h2>What catches Kiwis off guard</h2>
        <p>Australia's systems look familiar. They're different enough to cause real problems.</p>

        {[
          { h: 'Not getting a TFN before landing', p: 'Without a Tax File Number, employers withhold 47% from your pay. You can apply online from NZ — but most Kiwis don\'t know this.' },
          { h: 'Assuming the SCV gives full rights', p: "The Special Category Visa doesn't let you sponsor family members, access most Centrelink payments, or apply for citizenship directly." },
          { h: 'Renting without a local rental history', p: 'Most Kiwis get rejected on arrival. A specific approach to presenting NZ rental history dramatically improves your chances.' },
          { h: 'Leaving KiwiSaver behind', p: 'You can transfer KiwiSaver to Australian super under the trans-Tasman portability scheme. Most Kiwis never do.' },
        ].map(m => (
          <div class="h-mistake reveal">
            <h3>{m.h}</h3>
            <p>{m.p}</p>
          </div>
        ))}
      </div>

      <div class="h-problems-right">
        <h3>All of this is covered in the guides</h3>
        <p>Step by step, in plain language. Written for New Zealanders, not generic expats.</p>
        <ul class="h-covered-list">
          <li>TFN application from NZ — with exact form references</li>
          <li>Citizenship timeline under the July 2025 changes</li>
          <li>Rental application template for Kiwis without local history</li>
          <li>KiwiSaver transfer — forms, timing, fund selection</li>
          <li>Move cost calculator — your real upfront number</li>
        </ul>
        <div class="h-cta-block">
          <a href="/pricing">Get all 3 guides — $1.99/month</a>
          <p>Or buy individually · Cancel anytime · Instant PDF</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FREE TOOLS -->
<section class="h-tools">
  <div class="shell">
    <div class="h-tools-header">
      <h2>Free tools — no signup required</h2>
      <span>Four tools to start planning before you subscribe</span>
    </div>
    <div class="h-tools-row">
      {[
        { cat:'Visa', title:'Visa Pathway Checker', desc:'Which visa applies to your situation — citizen, partner, employer-sponsored or other.', link:'Check your pathway', href:'/tools/visa-checker' },
        { cat:'Finance', title:'Move Cost Calculator', desc:'Estimate flights, shipping, bond and first-month rent — with NZD totals.', link:'Estimate costs', href:'/tools/cost-calculator' },
        { cat:'Research', title:'Suburb Finder', desc:'Compare 200+ suburbs across Sydney, Melbourne and Brisbane by rent and lifestyle.', link:'Browse suburbs', href:'/tools/suburb-finder' },
        { cat:'Planning', title:'Moving Checklist', desc:'70 steps from "decide to move" to "first tax return filed." Saves automatically.', link:'Open checklist', href:'/tools/checklist' },
      ].map(t => (
        <a href={t.href} class="h-tool reveal">
          <div class="h-tool-cat">{t.cat}</div>
          <h3>{t.title}</h3>
