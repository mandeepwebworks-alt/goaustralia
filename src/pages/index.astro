---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="GoAustralia.co.nz — The Complete Guide to Moving from NZ to Australia"
  description="Step-by-step guides, visa tools, cost calculators and suburb research for New Zealanders moving to Australia. Trusted by Kiwis since 2023."
>
<style is:global>

/* ──────────────────────────────────────────────────────
   HERO
────────────────────────────────────────────────────── */
.hp-hero { background: var(--dark); padding: 0; }
.hp-hero-wrap { display: grid; grid-template-columns: 1fr 380px; }
.hp-hero-copy { padding: 84px 52px 84px 0; display: flex; flex-direction: column; justify-content: center; }
.hp-hero-tag {
  display: inline-block;
  font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber);
  border: 1px solid rgba(194,87,10,0.3); background: rgba(194,87,10,0.07);
  padding: 5px 12px; border-radius: 2px; margin-bottom: 24px;
}
.hp-hero-h1 {
  font-family: 'Playfair Display', serif; font-size: 3.2rem; font-weight: 800;
  color: var(--white); line-height: 1.08; letter-spacing: -0.02em; margin-bottom: 22px;
}
.hp-hero-h1 em { font-style: italic; color: #475569; }
.hp-hero-lead {
  font-family: 'Inter', sans-serif; font-size: 0.975rem;
  color: #64748B; line-height: 1.8; margin-bottom: 36px; max-width: 400px;
}
.hp-hero-btns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 48px; }
.hp-hero-btn-p {
  background: var(--white); color: var(--ink);
  font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700;
  padding: 13px 28px; border-radius: 4px; display: inline-block; transition: background 0.12s;
}
.hp-hero-btn-p:hover { background: #F1F5F9; }
.hp-hero-btn-s {
  font-family: 'Inter', sans-serif; font-size: 13px; color: #475569;
  border-bottom: 1px solid #334155; padding-bottom: 2px;
}
.hp-hero-btn-s:hover { color: #94A3B8; border-color: #475569; }
.hp-hero-foot { border-top: 1px solid #1E293B; padding-top: 28px; display: flex; gap: 32px; }
.hp-hero-stat strong {
  font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--white);
  display: block; margin-bottom: 2px;
}
.hp-hero-stat span { font-family: 'Inter', sans-serif; font-size: 11px; color: #475569; }

/* Hero right panel */
.hp-hero-panel { background: #080E1C; border-left: 1px solid #1A2540; padding: 0; display: flex; flex-direction: column; }
.hp-panel-head {
  padding: 20px 24px; border-bottom: 1px solid #1A2540;
  font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.16em; color: #2D3A56;
}
.hp-guide-row { padding: 18px 24px; border-bottom: 1px solid #1A2540; }
.hp-guide-row-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.hp-guide-spine { width: 3px; height: 14px; border-radius: 1px; flex-shrink: 0; }
.hp-guide-name {
  font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #C8D0E0; flex: 1;
}
.hp-guide-pages { font-family: 'Inter', sans-serif; font-size: 10px; color: #2D3A56; white-space: nowrap; }
.hp-guide-topics { padding-left: 13px; display: flex; flex-direction: column; gap: 3px; }
.hp-guide-topics li {
  font-family: 'Inter', sans-serif; font-size: 11px; color: #3B4D70;
  list-style: none; line-height: 1.45;
}
.hp-guide-topics li::before { content: '—  '; color: #253047; }
.hp-panel-cta { padding: 20px 24px; margin-top: auto; border-top: 1px solid #1A2540; }
.hp-panel-price {
  font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700;
  color: var(--white); margin-bottom: 3px; line-height: 1;
}
.hp-panel-price span { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 400; color: #3B4D70; }
.hp-panel-note { font-family: 'Inter', sans-serif; font-size: 10px; color: #3B4D70; margin-bottom: 12px; }
.hp-panel-btn {
  display: block; background: var(--amber); color: var(--white); text-align: center;
  font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
  padding: 11px; border-radius: 3px; transition: background 0.12s;
}
.hp-panel-btn:hover { background: var(--amber-dk); }

/* ──────────────────────────────────────────────────────
   STATS STRIP
────────────────────────────────────────────────────── */
.hp-stats { background: #111827; border-top: 1px solid #1E293B; border-bottom: 1px solid #1E293B; }
.hp-stats-inner { display: grid; grid-template-columns: repeat(4, 1fr); }
.hp-stat-item { padding: 18px 24px; border-right: 1px solid #1E293B; display: flex; flex-direction: column; gap: 3px; }
.hp-stat-item:last-child { border-right: none; }
.hp-stat-item strong {
  font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--white);
}
.hp-stat-item span { font-family: 'Inter', sans-serif; font-size: 11px; color: #475569; }

/* ──────────────────────────────────────────────────────
   GUIDES (white bg — the product)
────────────────────────────────────────────────────── */
.hp-guides { padding: 88px 0; background: var(--white); border-bottom: 1px solid var(--border); }
.hp-section-hd { margin-bottom: 40px; }
.hp-eyebrow { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber); margin-bottom: 10px; }
.hp-h2 { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: var(--ink); line-height: 1.15; }
.hp-h2-sub { font-family: 'Inter', sans-serif; font-size: 0.975rem; color: var(--ink3); margin-top: 8px; max-width: 480px; line-height: 1.6; }
.hp-guides-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 24px; }
.hp-gcard {
  border-radius: 6px; overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  transition: box-shadow 0.15s, transform 0.15s;
}
.hp-gcard:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.1); transform: translateY(-2px); }
.hp-gcard-cover { padding: 26px 22px 20px; min-height: 180px; display: flex; flex-direction: column; position: relative; }
.hp-gcard-badge {
  display: inline-block; align-self: flex-start;
  font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.8);
  padding: 3px 9px; border-radius: 2px; margin-bottom: auto;
}
.hp-gcard-title {
  font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700;
  color: var(--white); line-height: 1.25; margin-top: 14px;
}
.hp-gcard-price-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 14px; padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.12);
}
.hp-gcard-pages { font-family: 'Inter', sans-serif; font-size: 10px; color: rgba(255,255,255,0.35); }
.hp-gcard-price { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--white); }
.hp-gcard-body { padding: 18px 22px; border-top: 1px solid var(--border); background: #FAFBFC; }
.hp-chapters { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.hp-chapters li {
  font-family: 'Inter', sans-serif; font-size: 12px; color: var(--ink2);
  display: flex; gap: 10px; line-height: 1.4;
}
.hp-chapters li::before { content: '→'; color: var(--amber); flex-shrink: 0; font-size: 11px; margin-top: 1px; }
.hp-gcard-link { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: var(--amber); }
.hp-guides-bundle {
  background: var(--dark); border-radius: 6px; padding: 20px 26px;
  display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
}
.hp-guides-bundle p { font-family: 'Inter', sans-serif; font-size: 13px; color: #94A3B8; }
.hp-guides-bundle strong { color: var(--white); font-size: 15px; }
.hp-guides-bundle a {
  background: var(--amber); color: var(--white); flex-shrink: 0;
  font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
  padding: 11px 24px; border-radius: 4px; white-space: nowrap; transition: background 0.12s;
}
.hp-guides-bundle a:hover { background: var(--amber-dk); }

/* ──────────────────────────────────────────────────────
   PROBLEMS (surface bg)
────────────────────────────────────────────────────── */
.hp-problems { padding: 88px 0; background: var(--surface); border-bottom: 1px solid var(--border); }
.hp-problems-layout { display: grid; grid-template-columns: 1fr 340px; gap: 64px; align-items: start; }
.hp-mistake { display: flex; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--border); }
.hp-mistake:first-child { padding-top: 0; }
.hp-mistake:last-child { border-bottom: none; padding-bottom: 0; }
.hp-mistake-n {
  font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 700;
  color: var(--amber); line-height: 1; flex-shrink: 0; width: 40px; opacity: 0.25;
}
.hp-mistake h3 { font-family: 'Playfair Display', serif; font-size: 0.975rem; font-weight: 700; color: var(--ink); margin-bottom: 5px; line-height: 1.3; }
.hp-mistake p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.68; }
.hp-cta-panel {
  background: var(--dark); border-radius: 6px; padding: 32px;
  position: sticky; top: 76px;
}
.hp-cta-panel-tag { font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--amber); margin-bottom: 14px; }
.hp-cta-panel h3 { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--white); line-height: 1.25; margin-bottom: 10px; }
.hp-cta-panel > p { font-family: 'Inter', sans-serif; font-size: 13px; color: #64748B; line-height: 1.7; margin-bottom: 18px; }
.hp-cta-list { list-style: none; margin-bottom: 22px; display: flex; flex-direction: column; gap: 8px; }
.hp-cta-list li { font-family: 'Inter', sans-serif; font-size: 12.5px; color: #94A3B8; display: flex; gap: 9px; line-height: 1.5; }
.hp-cta-list li::before { content: '→'; color: var(--amber); flex-shrink: 0; margin-top: 1px; }
.hp-cta-btn {
  display: block; background: var(--amber); color: var(--white); text-align: center;
  font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700;
  padding: 13px; border-radius: 4px; transition: background 0.12s; margin-bottom: 8px;
}
.hp-cta-btn:hover { background: var(--amber-dk); }
.hp-cta-note { font-family: 'Inter', sans-serif; font-size: 10px; color: #334155; text-align: center; }

/* ──────────────────────────────────────────────────────
   FREE TOOLS (white bg)
────────────────────────────────────────────────────── */
.hp-tools { padding: 88px 0; background: var(--white); border-bottom: 1px solid var(--border); }
.hp-tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 36px; }
.hp-tool {
  border: 1.5px solid var(--border); border-radius: 6px; padding: 26px 24px;
  display: block; transition: border-color 0.12s, box-shadow 0.12s;
  border-top: 3px solid var(--border);
}
.hp-tool:hover { border-color: var(--amber); border-top-color: var(--amber); box-shadow: 0 4px 18px rgba(194,87,10,0.08); }
.hp-tool-num { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: var(--amber); opacity: 0.35; line-height: 1; margin-bottom: 14px; }
.hp-tool-cat { font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.13em; color: var(--amber); margin-bottom: 7px; }
.hp-tool h3 { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 7px; }
.hp-tool p { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.6; margin-bottom: 14px; }
.hp-tool-link { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: var(--ink2); }
.hp-tool-free { display: inline-block; background: var(--green-lt); color: var(--green); font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; padding: 2px 7px; border-radius: 2px; margin-left: 8px; vertical-align: middle; }

/* ──────────────────────────────────────────────────────
   BLOG (surface)
────────────────────────────────────────────────────── */
.hp-blog { padding: 88px 0; background: var(--surface); border-bottom: 1px solid var(--border); }
.hp-blog-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 36px; }
.hp-blog-feat {
  background: var(--white); border: 1px solid var(--border); border-radius: 6px;
  overflow: hidden; display: flex; flex-direction: column;
  transition: box-shadow 0.15s;
}
.hp-blog-feat:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.07); }
.hp-blog-feat-band { height: 5px; background: linear-gradient(90deg,#00205C,#005EA5); }
.hp-blog-feat-body { padding: 28px; flex: 1; display: flex; flex-direction: column; }
.hp-bfeat-tag { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--amber); margin-bottom: 12px; }
.hp-bfeat-title { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--ink); line-height: 1.25; margin-bottom: 12px; }
.hp-bfeat-desc { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); line-height: 1.7; flex: 1; }
.hp-bfeat-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }
.hp-bfeat-meta { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); }
.hp-bfeat-read { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: var(--amber); }
.hp-blog-sidebar { display: flex; flex-direction: column; gap: 0; }
.hp-blog-item {
  background: var(--white); border: 1px solid var(--border); border-radius: 0;
  padding: 18px 18px 18px 0; display: grid; grid-template-columns: 3px 1fr;
  gap: 15px; transition: background 0.12s;
  border-bottom: none; margin-bottom: -1px;
}
.hp-blog-item:first-child { border-radius: 6px 6px 0 0; }
.hp-blog-item:last-child { border-radius: 0 0 6px 6px; border-bottom: 1px solid var(--border); margin-bottom: 0; }
.hp-blog-item:hover { background: #FAFBFC; }
.hp-blog-bar { border-radius: 1px; }
.hp-blog-item-cat { font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink4); margin-bottom: 5px; }
.hp-blog-item-title { font-family: 'Playfair Display', serif; font-size: 0.9rem; font-weight: 700; color: var(--ink); line-height: 1.3; margin-bottom: 4px; }
.hp-blog-item-meta { font-family: 'Inter', sans-serif; font-size: 10px; color: var(--ink4); }

/* ──────────────────────────────────────────────────────
   TESTIMONIALS (white)
────────────────────────────────────────────────────── */
.hp-testi { padding: 88px 0; background: var(--white); border-bottom: 1px solid var(--border); }
.hp-testi-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; }
.hp-testi-rating { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--ink3); }
.hp-testi-rating strong { color: var(--ink); }
.hp-testi-stars { color: #D97706; letter-spacing: 2px; }
.hp-testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.hp-tcard { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 26px 24px; position: relative; }
.hp-tcard-mark {
  font-family: 'Playfair Display', serif; font-size: 4rem; line-height: 1;
  color: var(--amber); opacity: 0.15; position: absolute; top: 14px; left: 20px;
  font-style: normal; pointer-events: none;
}
.hp-tcard-stars { color: #D97706; font-size: 0.7rem; letter-spacing: 3px; margin-bottom: 12px; }
.hp-tcard-quote {
  font-family: 'Playfair Display', serif; font-size: 0.95rem; font-style: italic;
  color: var(--ink); line-height: 1.6; margin-bottom: 16px;
}
.hp-tcard-who { font-family: 'Inter', sans-serif; font-size: 12px; color: var(--ink3); }
.hp-tcard-who strong { color: var(--ink); font-weight: 600; }

/* ──────────────────────────────────────────────────────
   SUBSCRIBE (amber tint)
────────────────────────────────────────────────────── */
.hp-sub { background: var(--amber-lt); border-top: 1px solid var(--amber-bd); border-bottom: 1px solid var(--amber-bd); padding: 88px 0; }
.hp-sub-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.hp-sub-price { font-family: 'Playfair Display', serif; font-size: 2.6rem; font-weight: 800; color: var(--ink); margin: 12px 0; line-height: 1; }
.hp-sub-price sub { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: var(--ink3); vertical-align: baseline; font-style: normal; }
.hp-sub-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 22px 0; }
.hp-sub-list li { font-family: 'Inter', sans-serif; font-size: 13.5px; color: var(--ink); display: flex; gap: 10px; align-items: flex-start; }
.hp-sub-list li::before { content: '✓'; color: var(--green); font-weight: 700; flex-shrink: 0; margin-top: 1px; }
.hp-sub-card { background: var(--white); border: 1px solid var(--border); border-radius: 6px; padding: 32px; }
.hp-sub-card h3 { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; color: var(--ink); margin-bottom: 20px; }
.hp-sub-email {
  width: 100%; border: 1.5px solid var(--border); border-radius: 4px;
  padding: 12px 13px; font-size: 14px; font-family: 'Inter', sans-serif;
  outline: none; color: var(--ink); background: var(--white); margin-bottom: 10px;
  transition: border-color 0.12s;
}
.hp-sub-email:focus { border-color: var(--amber); }
.hp-sub-btn {
  display: block; width: 100%; background: var(--ink); color: var(--white);
  text-align: center; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600;
  padding: 13px; border-radius: 4px; border: none; cursor: pointer;
  transition: background 0.12s;
}
.hp-sub-btn:hover { background: var(--dark2); }
.hp-sub-small { font-family: 'Inter', sans-serif; font-size: 11px; color: var(--ink4); text-align: center; margin-top: 10px; }

/* ──────────────────────────────────────────────────────
   RESPONSIVE
────────────────────────────────────────────────────── */
@media (max-width: 1000px) {
  .hp-hero-wrap { grid-template-columns: 1fr; }
  .hp-hero-panel { display: none; }
  .hp-hero-copy { padding: 60px 0; }
  .hp-stats-inner { grid-template-columns: 1fr 1fr; }
  .hp-stat-item:nth-child(2) { border-right: none; }
  .hp-stat-item:nth-child(1), .hp-stat-item:nth-child(2) { border-bottom: 1px solid #1E293B; }
  .hp-problems-layout { grid-template-columns: 1fr; gap: 40px; }
  .hp-cta-panel { position: static; }
  .hp-guides-grid { grid-template-columns: 1fr 1fr; }
  .hp-tools-grid { grid-template-columns: 1fr; }
  .hp-blog-layout { grid-template-columns: 1fr; }
  .hp-testi-grid { grid-template-columns: 1fr 1fr; }
  .hp-sub-layout { grid-template-columns: 1fr; gap: 40px; }
}
@media (max-width: 640px) {
  .hp-hero-h1 { font-size: 2.2rem; }
  .hp-stats-inner { grid-template-columns: 1fr 1fr; }
  .hp-guides-grid { grid-template-columns: 1fr; }
  .hp-testi-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ALERT -->
<div class="alert-band">
  <div class="shell">
    <div class="alert-inner">
      <strong>July 2025 update:</strong>&nbsp;Time spent on the Special Category Visa now counts toward the 4-year Australian citizenship residence requirement.&nbsp;<a href="/blog/special-category-visa-guide">Read the full guide →</a>
    </div>
  </div>
</div>

<!-- HERO -->
<section class="hp-hero">
  <div class="shell">
    <div class="hp-hero-wrap">

      <div class="hp-hero-copy">
        <span class="hp-hero-tag">For New Zealanders moving to Australia</span>
        <h1 class="hp-hero-h1">Most Kiwis wing it.<br/><em>That costs them.</em></h1>
        <p class="hp-hero-lead">The SCV, tax, renting, super — Australia's system differs from New Zealand's in ways that catch even well-prepared movers off guard. Our guides cover every step, written for Kiwis.</p>
        <div class="hp-hero-btns">
          <a href="/pricing" class="hp-hero-btn-p">Get the guides — $1.99/month</a>
          <a href="/tools/visa-checker" class="hp-hero-btn-s">Check your visa free</a>
        </div>
        <div class="hp-hero-foot">
          <div class="hp-hero-stat">
            <strong>12,400+</strong>
            <span>Kiwis helped since 2023</span>
          </div>
          <div class="hp-hero-stat">
            <strong>232 pages</strong>
            <span>Across 3 PDF guides</span>
          </div>
          <div class="hp-hero-stat">
            <strong>May 2025</strong>
            <span>Last updated</span>
          </div>
        </div>
      </div>

      <div class="hp-hero-panel">
        <div class="hp-panel-head">Included with subscription</div>

        <div class="hp-guide-row">
          <div class="hp-guide-row-header">
            <div class="hp-guide-spine" style="background:linear-gradient(180deg,#1a5fa8,#0a3d6b);"></div>
            <div class="hp-guide-name">The Kiwi Masterguide</div>
            <div class="hp-guide-pages">90 pages</div>
          </div>
          <ul class="hp-guide-topics">
            <li>Special Category Visa — full explainer</li>
            <li>Banking & renting before you land</li>
            <li>TFN and Medicare from day one</li>
            <li>First 90 days checklist</li>
          </ul>
        </div>

