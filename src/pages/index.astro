---
import Base from '../layouts/Base.astro';

const faqItems = [
  { q: 'Is GoAustralia a moving company?', a: 'No. We\'re an independent comparison service. We match you with up to 3 verified trans-Tasman moving companies who quote on your exact load. You choose the one that suits you best — there\'s no obligation.' },
  { q: 'How much does it cost to use GoAustralia?', a: 'Nothing — it\'s completely free for you. Movers pay us a referral fee when they win your business, so there\'s no cost on your side, ever.' },
  { q: 'How long until I get my quotes?', a: 'Most people receive up to 3 quotes within 24 hours. Occasionally it takes a little longer during peak moving season (November–February).' },
  { q: 'What if I\'m not ready to move yet?', a: 'No worries — select "Just researching" as your timeline. You\'ll still get ballpark quotes so you can budget ahead of time. There\'s no commitment.' },
  { q: 'Can I ship my car or pets?', a: 'Yes. Several of our partner movers handle vehicle transport. For pets, we can refer you to specialist pet relocation services who handle quarantine and paperwork.' },
  { q: 'Is my personal information safe?', a: 'Absolutely. We only share your details with the movers matched to your route. We never sell your data to third parties, and you can request deletion at any time.' },
  { q: 'How much does it cost to move from NZ to Australia?', a: 'Shipping costs vary by volume: boxes-only moves start around $800–$2,000 NZD, a 1–2 bedroom shared container runs $2,500–$5,000, and a full 3–4 bedroom house costs $6,000–$15,000+. Add flights, temporary accommodation, and bond — most people budget $10,000–$25,000 total. Get exact quotes for your load on our free comparison tool.' },
  { q: 'What can\'t I ship to Australia?', a: 'Australia has strict biosecurity laws. You cannot ship fresh food, plants, seeds, untreated timber, or certain animal products. Wooden furniture may need fumigation. Your mover handles customs paperwork, but declare everything — fines for undeclared items are steep.' },
  { q: 'Do I need a visa to move to Australia from New Zealand?', a: 'No. New Zealand citizens automatically receive a Special Category Visa (subclass 444) on arrival, which lets you live, work, and study in Australia indefinitely. Just bring your valid NZ passport.' },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---
<Base
  title="Moving to Australia from NZ? Get Free Quotes — GoAustralia"
  description="Moving to Australia from NZ? Compare verified trans-Tasman movers and get up to 3 free quotes. Free, no-obligation moving quotes for Kiwis relocating across the Tasman."
  structuredData={faqJsonLd}
>

<!-- HERO A — Split -->
<section style="position:relative;background:linear-gradient(180deg,#FFFDF8 0%,#fff 70%);border-bottom:1px solid rgba(22,20,18,.07)">
  <div class="shell" style="padding-top:clamp(36px,5vw,68px);padding-bottom:clamp(56px,7vw,90px);display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:clamp(36px,5vw,72px);align-items:center">
    <div style="animation:fadeUp .6s ease both">
      <div class="chip" style="margin-bottom:24px">
        <span class="chip-dot"></span>
        NZ &rarr; AU &middot; Trans-Tasman moving, sorted
      </div>
      <h1 class="display display-xl" style="margin-bottom:22px">Moving to Australia?<br>Get it sorted in <span class="highlight">one go</span>.</h1>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.55;color:var(--body);max-width:480px;margin:0 0 30px">Tell us what you're moving and we'll match you with verified trans-Tasman movers. Compare real quotes side by side &mdash; free, with zero obligation.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:34px">
        <a href="#quote" class="btn btn-dark">Get my free quotes &rarr;</a>
        <a href="#how" class="btn btn-outline" style="font-weight:600">How it works</a>
      </div>
      <div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:9px">
          <span style="color:var(--amber);font-size:18px;letter-spacing:1px">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span style="font-size:14px;color:var(--body)"><strong style="color:var(--ink)">4.9/5</strong> &middot; 2,300+ reviews</span>
        </div>
        <span style="width:1px;height:18px;background:rgba(22,20,18,.15)"></span>
        <span style="font-size:14px;color:var(--body)"><strong style="color:var(--ink)">12,000+</strong> Kiwis relocated</span>
      </div>
    </div>

    <!-- Mini quote card -->
    <div style="animation:fadeUp .7s ease both;animation-delay:.08s;background:#fff;border:1px solid rgba(22,20,18,.1);border-radius:24px;padding:26px;box-shadow:0 24px 60px -28px rgba(22,20,18,.28)">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <span style="font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:-.01em">Start your free quote</span>
        <span style="font-size:12px;font-weight:700;color:var(--green);background:rgba(22,163,74,.1);padding:5px 10px;border-radius:var(--r-pill)">Free</span>
      </div>
      <!-- Route graphic -->
      <div style="display:flex;align-items:center;gap:12px;background:var(--cream);border:1px solid var(--hairline);border-radius:16px;padding:14px 16px;margin-bottom:18px">
        <div style="text-align:center">
          <div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em">From</div>
          <div style="font-weight:700;font-size:15px" id="hero-from-display">Auckland</div>
        </div>
        <div style="flex:1;position:relative;height:2px;background:repeating-linear-gradient(90deg,rgba(22,20,18,.25) 0 6px,transparent 6px 12px)">
          <span style="position:absolute;right:-2px;top:50%;transform:translateY(-50%);width:9px;height:9px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 4px rgba(255,176,32,.25)"></span>
        </div>
        <div style="text-align:center">
          <div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em">To</div>
          <div style="font-weight:700;font-size:15px" id="hero-to-display">Sydney</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
        <label>
          <span class="field-label">Leaving from</span>
          <select class="field-select" id="hero-from">
            <option>Auckland</option><option>Wellington</option><option>Christchurch</option><option>Hamilton</option><option>Tauranga</option><option>Dunedin</option><option>Other</option>
          </select>
        </label>
        <label>
          <span class="field-label">Moving to</span>
          <select class="field-select" id="hero-to">
            <option>Sydney</option><option>Melbourne</option><option>Brisbane</option><option>Gold Coast</option><option>Perth</option><option>Adelaide</option><option>Other</option>
          </select>
        </label>
      </div>
      <a href="#quote" id="hero-continue" style="display:flex;align-items:center;justify-content:center;gap:9px;background:var(--amber);color:var(--ink);font-weight:700;font-size:16px;padding:15px;border-radius:14px;text-decoration:none;margin-top:4px;transition:all .2s">Continue &rarr;</a>
      <p style="text-align:center;font-size:12.5px;color:var(--muted);margin:14px 0 0">No spam &middot; No obligation &middot; Always free</p>
    </div>
  </div>
</section>

<!-- VALUE BAR -->
<section style="background:var(--ink);color:#fff">
  <div class="shell" style="padding:22px 0;display:flex;align-items:center;justify-content:center;gap:clamp(24px,5vw,56px);flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:10px">
      <span style="color:var(--amber);font-weight:800;font-size:18px">&#10003;</span>
      <span style="font-size:14px;font-weight:600;color:var(--on-dark)">100% free for you</span>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="color:var(--amber);font-weight:800;font-size:18px">&#10003;</span>
      <span style="font-size:14px;font-weight:600;color:var(--on-dark)">No obligation</span>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="color:var(--amber);font-weight:800;font-size:18px">&#10003;</span>
      <span style="font-size:14px;font-weight:600;color:var(--on-dark)">Compare multiple movers</span>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="color:var(--amber);font-weight:800;font-size:18px">&#10003;</span>
      <span style="font-size:14px;font-weight:600;color:var(--on-dark)">Verified NZ &amp; AU companies</span>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how" class="section">
  <div class="shell">
    <div style="max-width:620px;margin-bottom:52px">
      <div class="eyebrow">How it works</div>
      <h2 class="display display-lg" style="margin-bottom:14px">Three steps to a sorted move</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--body)">No phone tag, no chasing quotes. Do it once and let the movers come to you.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
      <div class="card">
        <div class="step-num">1</div>
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:21px;margin:0 0 10px;letter-spacing:-.01em">Tell us about your move</h3>
        <p style="font-size:15.5px;line-height:1.55;color:var(--body);margin:0">Your cities, your timeline, and exactly what's coming &mdash; beds, sofas, the lot. Takes about a minute.</p>
      </div>
      <div class="card">
        <div class="step-num">2</div>
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:21px;margin:0 0 10px;letter-spacing:-.01em">Get matched with movers</h3>
        <p style="font-size:15.5px;line-height:1.55;color:var(--body);margin:0">We pass your details to up to 3 verified trans-Tasman specialists who actually service your route.</p>
      </div>
      <div class="card">
        <div class="step-num">3</div>
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:21px;margin:0 0 10px;letter-spacing:-.01em">Compare &amp; book</h3>
        <p style="font-size:15.5px;line-height:1.55;color:var(--body);margin:0">Quotes land in your inbox within 24 hours. Compare on price and service, then book with confidence.</p>
      </div>
    </div>
  </div>
</section>

<!-- QUOTE FORM -->
<section id="quote" style="padding:clamp(20px,3vw,40px) var(--pad-x) clamp(64px,8vw,110px);background:linear-gradient(180deg,#fff 0%,#FFFDF8 100%)">
  <div style="max-width:var(--max-w-form);margin:0 auto;background:#fff;border:1px solid rgba(22,20,18,.1);border-radius:var(--r-panel);box-shadow:0 40px 90px -50px rgba(22,20,18,.4);overflow:hidden;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
    <!-- Left rail -->
    <div style="background:var(--ink);color:#fff;padding:clamp(34px,4vw,52px)">
      <div style="display:inline-flex;align-items:center;gap:9px;background:rgba(255,176,32,.16);color:var(--amber);border-radius:var(--r-pill);padding:6px 14px;font-size:13px;font-weight:700;margin-bottom:26px">Free quote request</div>
      <h2 class="display display-md" style="color:#fff;margin-bottom:18px">Tell us what you're moving</h2>
      <p style="font-size:16px;line-height:1.6;color:var(--on-dark);margin:0 0 34px">The more detail you give, the sharper your quotes. Tap the steppers to add what's coming with you.</p>
      <div style="display:flex;flex-direction:column;gap:18px">
        <div style="display:flex;align-items:center;gap:13px">
          <span style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);display:grid;place-items:center;color:var(--amber);font-weight:800">&#10003;</span>
          <span style="font-size:15px;color:#e7e3da">Up to 3 verified movers, one form</span>
        </div>
        <div style="display:flex;align-items:center;gap:13px">
          <span style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);display:grid;place-items:center;color:var(--amber);font-weight:800">&#10003;</span>
          <span style="font-size:15px;color:#e7e3da">Quotes within 24 hours</span>
        </div>
        <div style="display:flex;align-items:center;gap:13px">
          <span style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);display:grid;place-items:center;color:var(--amber);font-weight:800">&#10003;</span>
          <span style="font-size:15px;color:#e7e3da">Free &mdash; you're never charged</span>
        </div>
      </div>
      <div style="margin-top:38px;padding-top:26px;border-top:1px solid rgba(255,255,255,.12);display:flex;align-items:center;gap:14px">
        <span style="color:var(--amber);font-size:17px;letter-spacing:1px">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span style="font-size:14px;color:var(--on-dark)">Rated 4.9/5 by 2,300+ Kiwi movers</span>
      </div>
    </div>

    <!-- Right form -->
    <div style="padding:clamp(30px,3.5vw,46px)" id="quote-container">
      <form id="quote-form">
        <!-- 1. Route -->
        <div style="margin-bottom:26px">
          <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--ink);margin-bottom:14px;display:flex;align-items:center;gap:8px">
            <span style="width:22px;height:22px;border-radius:6px;background:var(--amber);color:var(--ink);display:grid;place-items:center;font-size:12px;font-weight:800">1</span>
            Where are you moving?
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <label>
              <span class="field-label">From (NZ)</span>
              <select class="field-select" name="fromCity">
                <option>Auckland</option><option>Wellington</option><option>Christchurch</option><option>Hamilton</option><option>Tauranga</option><option>Dunedin</option><option>Other</option>
              </select>
            </label>
            <label>
              <span class="field-label">To (AU)</span>
              <select class="field-select" name="toCity">
                <option>Sydney</option><option>Melbourne</option><option>Brisbane</option><option>Gold Coast</option><option>Perth</option><option>Adelaide</option><option>Other</option>
              </select>
            </label>
          </div>
        </div>
        <!-- Timeline -->
        <div style="margin-bottom:26px">
          <div class="field-label" style="margin-bottom:10px">When are you moving?</div>
          <div style="display:flex;gap:9px;flex-wrap:wrap" id="timeline-segs">
            <button type="button" class="seg" data-val="ASAP">ASAP</button>
            <button type="button" class="seg active" data-val="1–3 months">1–3 months</button>
            <button type="button" class="seg" data-val="3–6 months">3–6 months</button>
            <button type="button" class="seg" data-val="Just researching">Just researching</button>
          </div>
          <input type="hidden" name="timeline" value="1–3 months" />
        </div>
        <!-- 2. Home size -->
        <div style="margin-bottom:28px">
          <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--ink);margin-bottom:12px;display:flex;align-items:center;gap:8px">
            <span style="width:22px;height:22px;border-radius:6px;background:var(--amber);color:var(--ink);display:grid;place-items:center;font-size:12px;font-weight:800">2</span>
            What size is your home?
          </div>
          <div style="display:flex;gap:9px;flex-wrap:wrap" id="size-segs">
            <button type="button" class="seg" data-val="Studio">Studio</button>
            <button type="button" class="seg" data-val="1 bed">1 bed</button>
            <button type="button" class="seg active" data-val="2 bed">2 bed</button>
            <button type="button" class="seg" data-val="3 bed">3 bed</button>
            <button type="button" class="seg" data-val="4+ bed">4+ bed</button>
          </div>
          <input type="hidden" name="homeSize" value="2 bed" />
        </div>
        <!-- 3. Items -->
        <div style="margin-bottom:28px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
            <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--ink);display:flex;align-items:center;gap:8px">
              <span style="width:22px;height:22px;border-radius:6px;background:var(--amber);color:var(--ink);display:grid;place-items:center;font-size:12px;font-weight:800">3</span>
              What are you bringing?
            </div>
            <span style="font-size:13px;font-weight:600;color:var(--amber-deep);background:var(--amber-bg);padding:5px 11px;border-radius:var(--r-pill)" id="items-pill">24 items</span>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px" id="steppers">
            <div class="stepper-row" data-key="beds">
              <span class="stepper-label">Beds</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">2</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="sofas">
              <span class="stepper-label">Sofas / couches</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">1</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="wardrobes">
              <span class="stepper-label">Wardrobes / drawers</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">2</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="fridges">
              <span class="stepper-label">Fridges / freezers</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">1</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="washers">
              <span class="stepper-label">Washers / dryers</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">1</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="tables">
              <span class="stepper-label">Tables / desks</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">2</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
            <div class="stepper-row" data-key="boxes">
              <span class="stepper-label">Boxes (estimate)</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn stepper-dec">&minus;</button>
                <span class="stepper-val">15</span>
                <button type="button" class="stepper-btn stepper-inc">+</button>
              </div>
            </div>
          </div>
        </div>
        <!-- Extras -->
        <div style="margin-bottom:30px">
          <div class="field-label" style="margin-bottom:11px">Anything extra? (optional)</div>
          <div style="display:flex;gap:9px;flex-wrap:wrap" id="extras">
            <button type="button" class="extra-chip" data-key="packing">Packing service</button>
            <button type="button" class="extra-chip" data-key="storage">Storage needed</button>
            <button type="button" class="extra-chip" data-key="piano">Piano / large item</button>
            <button type="button" class="extra-chip" data-key="car">Car / motorbike</button>
          </div>
        </div>
        <!-- 4. Contact -->
        <div style="margin-bottom:24px">
          <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--ink);margin-bottom:12px;display:flex;align-items:center;gap:8px">
            <span style="width:22px;height:22px;border-radius:6px;background:var(--amber);color:var(--ink);display:grid;place-items:center;font-size:12px;font-weight:800">4</span>
            Where do we send your quotes?
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
            <input class="field-input" name="name" placeholder="Full name" required />
            <input class="field-input" name="email" type="email" placeholder="Email address" required />
          </div>
          <input class="field-input" name="phone" placeholder="Phone (optional)" />
        </div>
        <input type="text" name="website" style="position:absolute;left:-9999px;opacity:0" tabindex="-1" autocomplete="off" />
        <div id="form-error" style="display:none;background:#FEF2F2;border:1px solid #EF4444;border-radius:var(--r-input);padding:12px 16px;margin-bottom:16px;font-size:14px;color:#B91C1C"></div>
        <button type="submit" class="btn btn-amber btn-block" style="font-size:17px;padding:17px;border-radius:14px;font-weight:800" id="submit-btn">Get my free quotes &rarr;</button>
        <p style="text-align:center;font-size:12.5px;color:var(--muted);margin:14px 0 0">By submitting you agree to be contacted by matched movers. No spam, ever.</p>
      </form>

      <!-- Success state -->
      <div id="quote-success" style="display:none;height:100%;flex-direction:column;justify-content:center;text-align:center;align-items:center;padding:20px 0;animation:fadeUp .5s ease both">
        <div style="width:68px;height:68px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-size:34px;margin-bottom:22px">&#10003;</div>
        <h3 style="font-family:var(--font-display);font-weight:800;font-size:28px;letter-spacing:-.02em;margin:0 0 12px">You're all set, <span id="success-name"></span></h3>
        <p style="font-size:16px;line-height:1.6;color:var(--body);max-width:380px;margin:0 0 8px" id="success-detail"></p>
        <p style="font-size:14px;color:var(--muted);margin:18px 0 24px">Keep an eye on your inbox &mdash; and check spam, just in case.</p>
        <button type="button" class="btn btn-outline btn-sm" id="edit-btn">Edit my request</button>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" style="padding:clamp(64px,8vw,110px) var(--pad-x);background:var(--ink);color:#fff">
  <div class="shell">
    <div style="max-width:640px;margin-bottom:52px">
      <div class="eyebrow eyebrow-amber">What movers can do</div>
      <h2 class="display display-lg" style="color:#fff;margin-bottom:14px">Every kind of trans-Tasman move</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--on-dark)">From a few boxes to a full four-bedroom house, our partners cover the lot.</p>
