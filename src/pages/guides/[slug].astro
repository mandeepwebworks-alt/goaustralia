---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'masterguide' } },
    { params: { slug: 'tax-finance' } },
    { params: { slug: 'jobs' } },
  ];
}

const guides: Record<string, {
  title: string; subtitle: string; tag: string; price: string; pages: number;
  cover: string; updated: string; desc: string;
  chapters: Array<{ num: string; title: string; topics: string[] }>;
}> = {
  masterguide: {
    title: 'The Kiwi Moving to Australia Masterguide',
    subtitle: 'Everything you need to know before and after you land',
    tag: 'Most Popular', price: '$19', pages: 90, updated: 'May 2025',
    cover: 'linear-gradient(160deg,#00205C,#005EA5)',
    desc: 'The most comprehensive guide for New Zealanders moving to Australia. Covers every stage from your visa decision through to your first 90 days in Aus.',
    chapters: [
      { num: '01', title: 'Your Visa — The Special Category Visa Explained', topics: ['What the SCV does and doesn\'t give you', 'Medicare eligibility from July 2023', 'Pathway from SCV to permanent residency', 'Citizenship timeline (updated July 2025)'] },
      { num: '02', title: 'Banking Before You Land', topics: ['Opening an Australian bank account from NZ', 'Which banks are best for Kiwis', 'Transferring money (Wise vs bank transfer)', 'Setting up direct debits for rent & bills'] },
      { num: '03', title: 'Finding a Place to Live', topics: ['Renting without a local rental history', 'Realestate.com.au & Domain.com.au walkthrough', 'What to check at a rental inspection', 'Bond, rent in advance and moving in'] },
      { num: '04', title: 'Tax File Number & Medicare', topics: ['Getting your TFN before you land', 'Medicare enrolment step-by-step', 'Bulk billing and GP access', 'Pharmaceutical benefits and prescriptions'] },
      { num: '05', title: 'Your First 90 Days Checklist', topics: ['Week 1 essentials', 'Month 1 admin', 'Setting up superannuation', 'Schools (if moving with kids)'] },
    ],
  },
  'tax-finance': {
    title: 'Australian Tax & Finance for New Zealanders',
    subtitle: 'TFN, super, income tax and how the ATO treats Kiwis',
    tag: 'Essential', price: '$22', pages: 68, updated: 'May 2025',
    cover: 'linear-gradient(160deg,#0f2b1f,#1B7A3E)',
    desc: 'A complete guide to the Australian tax system for New Zealanders — written in plain English with step-by-step instructions for every form and process.',
    chapters: [
      { num: '01', title: 'Tax File Number (TFN)', topics: ['Applying for your TFN online', 'What to do if you forgot to get one before landing', 'How employers use your TFN', 'When your TFN arrives (timing)'] },
      { num: '02', title: 'Superannuation from Day One', topics: ['What super is and how much employers contribute (11% in 2025)', 'Choosing a super fund', 'Keeping track of multiple super accounts', 'KiwiSaver vs super — what to do with your KiwiSaver'] },
      { num: '03', title: 'Income Tax in Australia', topics: ['Australian tax rates vs NZ rates', 'Resident vs non-resident tax rates for Kiwis', 'Tax offsets available to you', 'Tax on your NZ income while in Aus'] },
      { num: '04', title: 'Your First Australian Tax Return', topics: ['Lodging via myTax (free, online)', 'Deductions you can claim', 'Deadline (October 31)', 'Getting a tax agent vs doing it yourself'] },
      { num: '05', title: 'HECS/HELP Debt & KiwiSaver', topics: ['Do you have to repay HECS in Australia?', 'Repayment thresholds', 'KiwiSaver — transfer or keep?', 'Trans-Tasman super portability scheme'] },
    ],
  },
  jobs: {
    title: 'Finding a Job in Australia: The Kiwi Edition',
    subtitle: 'CV strategy, job boards, LinkedIn and salary benchmarks',
    tag: 'New', price: '$27', pages: 74, updated: 'April 2025',
    cover: 'linear-gradient(160deg,#1a1a3d,#3730a3)',
    desc: 'A practical job-hunting guide written specifically for Kiwis entering the Australian job market — covering everything from CV differences to salary negotiation.',
    chapters: [
      { num: '01', title: 'NZ vs Australian CVs & Résumés', topics: ['Key format differences', 'What Australian employers look for', 'How to position your NZ experience', 'Cover letter expectations in Australia'] },
      { num: '02', title: 'The Best Job Boards for Kiwis', topics: ['Seek.com.au — Australia\'s #1 job board', 'LinkedIn — how Kiwis are found', 'Industry-specific boards', 'Recruitment agencies that specialise in Kiwis'] },
      { num: '03', title: 'In-Demand Sectors in 2025', topics: ['Healthcare & nursing (highest demand)', 'Construction & trades', 'Tech & software engineering', 'Finance & accounting', 'Hospitality'] },
      { num: '04', title: 'Salary Benchmarks by City', topics: ['Median salaries by sector in Sydney, Melbourne, Brisbane', 'Cost of living adjusted salary comparison', 'When to negotiate (and how)', 'Contract vs permanent pros & cons'] },
      { num: '05', title: 'LinkedIn for the Australian Market', topics: ['Profile optimisation for AU recruiters', 'Australian networking culture', 'Connections before you land', 'Reaching out to Kiwi networks in Aus'] },
    ],
  },
};

const { slug } = Astro.params;
const guide = guides[slug!];
---
<Layout title={`${guide.title} | GoAustralia.co.nz`} description={guide.desc}>
<style is:global>
  .guide-detail-grid { display: grid; grid-template-columns: 1fr 320px; gap: 36px; align-items: start; padding: 44px 0; }
  .guide-cover-large { height: 260px; border-radius: 8px; display: flex; align-items: flex-end; padding: 24px; margin-bottom: 28px; position: relative; }
  .guide-cover-badge { position: absolute; top: 16px; left: 16px; background: var(--blue); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 2px; }
  .guide-cover-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.3rem; font-weight: 800; color: #fff; line-height: 1.25; }
  .guide-desc { font-size: 1rem; color: var(--txt2); line-height: 1.75; margin-bottom: 28px; }
  .chapter { border: 1px solid var(--border-lt); border-radius: 6px; margin-bottom: 12px; overflow: hidden; }
  .chapter summary { font-size: 14px; font-weight: 700; color: var(--navy); padding: 16px 18px; background: var(--white); }
  .chapter summary span { font-size: 10px; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.07em; margin-right: 8px; }
  .chapter .faq-ans { background: var(--surf2); }
  .chapter .faq-ans ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .chapter .faq-ans ul li { font-size: 13px; color: var(--txt2); display: flex; align-items: center; gap: 8px; }
  .chapter .faq-ans ul li::before { content: '→'; color: var(--blue); font-weight: 700; }

  /* Sidebar */
  .guide-sidebar { position: sticky; top: 80px; }
  .purchase-card { background: var(--white); border: 1.5px solid var(--navy); border-radius: 8px; padding: 24px; }
  .purchase-price { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 900; color: var(--navy); margin-bottom: 4px; }
  .purchase-sub { font-size: 12px; color: var(--txt3); margin-bottom: 18px; }
  .purchase-btn { display: block; background: var(--blue); color: #fff; text-align: center; font-size: 15px; font-weight: 700; padding: 13px; border-radius: 4px; transition: background 0.12s; margin-bottom: 10px; }
  .purchase-btn:hover { background: #004a85; }
  .purchase-divider { text-align: center; font-size: 12px; color: var(--txt3); margin: 14px 0; position: relative; }
  .purchase-divider::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border-lt); }
  .purchase-divider span { position: relative; background: var(--white); padding: 0 10px; }
  .sub-alt-btn { display: block; background: var(--navy); color: #fff; text-align: center; font-size: 14px; font-weight: 700; padding: 12px; border-radius: 4px; transition: background 0.12s; }
  .sub-alt-btn:hover { background: #001545; }
  .sub-alt-note { font-size: 11px; color: var(--txt3); text-align: center; margin-top: 8px; }
  .guide-meta-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
  .guide-meta-chip { background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 3px; padding: 5px 10px; font-size: 12px; font-weight: 600; color: var(--txt2); }

  @media (max-width: 860px) { .guide-detail-grid { grid-template-columns: 1fr; } .guide-sidebar { position: static; } }
</style>

<div class="page-hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">Home</a> › <a href="/guides">Guides</a> › {guide.title}</div>
    <h1>{guide.title}</h1>
    <p class="page-hero-sub">{guide.subtitle}</p>
  </div>
</div>

<div class="shell">
  <div class="guide-detail-grid">

    <!-- Main content -->
    <div>
      <div class="guide-cover-large" style={`background:${guide.cover};`}>
        <div class="guide-cover-badge">{guide.tag}</div>
        <div class="guide-cover-title">{guide.title}</div>
      </div>

      <div class="guide-meta-row">
        <span class="guide-meta-chip">📄 {guide.pages} pages</span>
        <span class="guide-meta-chip">🗓 Updated {guide.updated}</span>
        <span class="guide-meta-chip">📥 Instant PDF download</span>
        <span class="guide-meta-chip">🔄 Free updates included</span>
      </div>

      <p class="guide-desc" style="margin-top:20px;">{guide.desc}</p>

      <div class="sec-eye" style="margin-bottom:14px;">What's Inside</div>
      {guide.chapters.map(ch => (
        <details class="chapter" open={ch.num === '01'}>
          <summary><span>{ch.num}</span>{ch.title}</summary>
          <div class="faq-ans">
            <ul>
              {ch.topics.map(t => <li>{t}</li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>

    <!-- Sidebar -->
    <div class="guide-sidebar">
      <div class="purchase-card">
        <div class="purchase-price">{guide.price}</div>
        <div class="purchase-sub">One-time purchase · Instant download · Free updates</div>
        <a href="/signup" class="purchase-btn">Buy This Guide →</a>
        <div style="font-size:11px;color:var(--txt3);text-align:center;">Secure checkout via Stripe</div>
        <div class="purchase-divider"><span>or</span></div>
        <a href="/signup" class="sub-alt-btn">Get All 3 Guides — $1.99/month</a>
        <div class="sub-alt-note">Includes this guide + Tax & Finance + Jobs guide.<br/>Cancel anytime.</div>
      </div>

      <div style="margin-top:16px;background:var(--surf2);border:1px solid var(--border-lt);border-radius:6px;padding:18px;">
        <div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:10px;">Also included with subscription</div>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:7px;">
          {['Visa Pathway Checker','Cost Calculator','Moving Checklist (70 steps)','Suburb Finder','Weekly Newsletter'].map(f => (
            <li style="font-size:12px;color:var(--txt2);display:flex;align-items:center;gap:7px;"><span style="color:var(--green-ok);font-weight:700;">✓</span>{f}</li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</div>

<div class="cta-band">
  <div class="shell">
    <h2>Get All 3 Guides for $1.99/month</h2>
    <p>Or buy this guide individually for {guide.price} — instant PDF download.</p>
    <a href="/signup" class="cta-band-btn">Start Subscription →</a>
  </div>
</div>

</Layout>
