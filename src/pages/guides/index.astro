---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="PDF Guides — Moving from NZ to Australia | GoAustralia.co.nz" description="Step-by-step PDF guides for New Zealanders moving to Australia. Buy once or get all 3 free with $1.99/month.">
<style is:global>
  .guides-page-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .guide-page-card { background: var(--white); border: 1.5px solid var(--border); border-radius: 8px; overflow: hidden; transition: box-shadow 0.15s, border-color 0.15s; }
  .guide-page-card:hover { box-shadow: 0 6px 24px rgba(0,32,92,0.1); border-color: var(--blue); }
  .guide-cover { height: 200px; display: flex; align-items: flex-end; padding: 20px; position: relative; }
  .guide-badge { position: absolute; top: 14px; left: 14px; background: var(--blue); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; padding: 4px 10px; border-radius: 2px; }
  .guide-page-body { padding: 24px; }
  .guide-pages-tag { font-size: 10px; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
  .guide-page-card h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--navy); line-height: 1.25; margin-bottom: 10px; }
  .guide-page-card p { font-size: 13px; color: var(--txt2); line-height: 1.6; margin-bottom: 18px; }
  .guide-contents { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
  .guide-contents li { font-size: 12px; color: var(--txt2); display: flex; align-items: center; gap: 7px; }
  .guide-contents li::before { content: '→'; color: var(--blue); font-weight: 700; }
  .guide-price-row { display: flex; align-items: center; justify-content: space-between; padding-top: 16px; border-top: 1px solid var(--border-lt); }
  .guide-price-tag { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.1rem; font-weight: 900; color: var(--navy); }
  .guide-price-sub { font-size: 11px; color: var(--txt3); margin-top: 2px; }
  .guide-buy-btn { background: var(--blue); color: #fff; font-size: 13px; font-weight: 700; padding: 9px 18px; border-radius: 4px; transition: background 0.12s; white-space: nowrap; }
  .guide-buy-btn:hover { background: #004a85; }
  .bundle-banner { background: var(--navy); border-radius: 8px; padding: 32px 36px; display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 40px; }
  .bundle-banner-text h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.3rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
  .bundle-banner-text p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.6; }
  .bundle-banner-cta { flex-shrink: 0; }
  .bundle-btn { display: block; background: #fff; color: var(--navy); font-size: 14px; font-weight: 800; padding: 13px 28px; border-radius: 4px; white-space: nowrap; transition: background 0.12s; text-align: center; }
  .bundle-btn:hover { background: var(--blue-tint); }
  .bundle-price { font-size: 11px; color: rgba(255,255,255,0.45); text-align: center; margin-top: 6px; }
  @media (max-width: 900px) {
    .guides-page-grid { grid-template-columns: 1fr 1fr; }
    .bundle-banner { flex-direction: column; text-align: center; }
  }
  @media (max-width: 600px) {
    .guides-page-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="page-hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">Home</a> › Guides</div>
    <h1>PDF Guides for Kiwis Moving to Australia</h1>
    <p class="page-hero-sub">Step-by-step guides written by New Zealanders who've made the move. Buy once or get all 3 free with a $1.99/month subscription.</p>
  </div>
</div>

<section class="section">
  <div class="shell">

    <div class="guides-page-grid">
      {[
        {
          title: 'The Kiwi Moving to Australia Masterguide',
          tag: '90 pages · Updated May 2025',
          desc: 'The complete guide to moving from NZ to Australia — from visa to your first 90 days.',
          contents: ['Special Category Visa explained', 'Banking & TFN setup', 'Renting as a new arrival', 'Medicare enrolment steps', 'Your first 90 days checklist'],
          price: '$19', sub: 'or free with subscription',
          badge: 'Most Popular',
          cover: 'linear-gradient(160deg,#00205C,#005EA5)',
          slug: 'masterguide',
        },
        {
          title: 'Australian Tax & Finance for New Zealanders',
          tag: '68 pages · Updated May 2025',
          desc: 'TFN, superannuation, income tax, HECS and how the ATO treats Kiwis — in plain English.',
          contents: ['Getting your Tax File Number', 'Superannuation from day one', 'Income tax for Kiwis', 'KiwiSaver & super transfer', 'First tax return walkthrough'],
          price: '$22', sub: 'or free with subscription',
          badge: 'Essential',
          cover: 'linear-gradient(160deg,#0f2b1f,#1B7A3E)',
          slug: 'tax-finance',
        },
        {
          title: 'Finding a Job in Australia: The Kiwi Edition',
          tag: '74 pages · Updated April 2025',
          desc: 'CV differences, job boards, LinkedIn strategy, in-demand sectors and salary benchmarks by city.',
          contents: ['AU vs NZ résumé differences', 'Best job boards for Kiwis', 'LinkedIn profile for AU market', 'In-demand sectors in 2025', 'Salary benchmarks by city'],
          price: '$27', sub: 'or free with subscription',
          badge: 'New',
          cover: 'linear-gradient(160deg,#1a1a3d,#3730a3)',
          slug: 'jobs',
        },
      ].map(g => (
        <div class="guide-page-card reveal">
          <div class="guide-cover" style={`background:${g.cover};`}>
            <div class="guide-badge">{g.badge}</div>
            <div style="font-size:1rem;font-weight:700;color:#fff;line-height:1.3;">{g.title}</div>
          </div>
          <div class="guide-page-body">
            <div class="guide-pages-tag">{g.tag}</div>
            <h2>{g.title}</h2>
            <p>{g.desc}</p>
            <ul class="guide-contents">
              {g.contents.map(c => <li>{c}</li>)}
            </ul>
            <div class="guide-price-row">
              <div>
                <div class="guide-price-tag">{g.price}</div>
                <div class="guide-price-sub">{g.sub}</div>
              </div>
              <a href={`/guides/${g.slug}`} class="guide-buy-btn">Preview & Buy →</a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bundle banner -->
    <div class="bundle-banner">
      <div class="bundle-banner-text">
        <h3>Get All 3 Guides + Every Tool — $1.99/month</h3>
        <p>Full access to all 3 PDF guides (valued at $68), the visa checker, cost calculator, suburb finder, moving checklist and weekly newsletter. Cancel anytime.</p>
      </div>
      <div class="bundle-banner-cta">
        <a href="/signup" class="bundle-btn">Start for $1.99/month →</a>
        <div class="bundle-price">Cancel anytime · No lock-in</div>
      </div>
    </div>

  </div>
</section>

<!-- Reviews -->
<section class="section section-alt">
  <div class="shell">
    <div class="sec-eye">Reviews</div>
    <div class="sec-h2">What Kiwis Are Saying</div>
    <div class="reviews-grid" style="margin-top:28px;">
      {[
        { text:'"The masterguide was the single most useful thing I read before moving. Every question I had was answered, and some I didn\'t even know to ask."', name:'Liam H.', loc:'Hamilton → Sydney' },
        { text:'"The tax guide paid for itself on day one. I had no idea I needed to set up superannuation separately — the step-by-step walkthrough was exactly what I needed."', name:'Aroha T.', loc:'Christchurch → Melbourne' },
        { text:'"I used the jobs guide to rewrite my CV before I even landed. Had three interviews in my first week."', name:'Mark P.', loc:'Auckland → Brisbane' },
      ].map(r => (
        <div class="review reveal">
          <div class="stars">★★★★★</div>
          <p>{r.text}</p>
          <div class="reviewer">{r.name} <span>· {r.loc}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="cta-band">
  <div class="shell">
    <h2>Ready to Get Started?</h2>
    <p>Join 12,400+ Kiwis who've used GoAustralia to plan their Australian move.</p>
    <a href="/signup" class="cta-band-btn">Get All 3 Guides — $1.99/month →</a>
  </div>
</div>

</Layout>
