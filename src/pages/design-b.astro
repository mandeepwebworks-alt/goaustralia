---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Design B — Clean & Modern | GoAustralia</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #fff; color: #1a1a2e; }

    /* Top bar */
    .top-bar { background: #005EA2; padding: 8px 32px; font-size: 13px; color: rgba(255,255,255,0.85); display:flex; justify-content:space-between; align-items:center; }
    .top-bar a { color:#73B3E7; text-decoration:none; }

    /* Nav */
    nav { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 0 32px; display:flex; align-items:center; justify-content:space-between; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .logo { color:#005EA2; font-size:1.4rem; font-weight:800; padding:16px 0; display:flex; align-items:center; gap:10px; text-decoration:none; }
    .logo em { color:#2D8653; font-style:normal; }
    .nav-links { display:flex; gap:0; }
    .nav-links a { color:#334155; text-decoration:none; font-size:0.9rem; padding:20px 14px; display:block; transition:color 0.15s; border-bottom:3px solid transparent; }
    .nav-links a:hover { color:#005EA2; border-bottom-color:#005EA2; }
    .nav-cta { background:#005EA2; color:#fff !important; font-weight:700; border-radius:6px; margin:10px 0 10px 12px; padding:10px 20px !important; border-bottom:none !important; }
    .nav-cta:hover { background:#004d8f !important; }

    /* Hero */
    .hero { background: linear-gradient(180deg, #EFF6FF 0%, #fff 100%); padding:72px 32px 56px; border-bottom:1px solid #e2e8f0; }
    .hero-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1.2fr 1fr; gap:56px; align-items:center; }
    .hero-eyebrow { color:#2D8653; font-size:13px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .hero h1 { font-size:2.8rem; font-weight:800; line-height:1.2; color:#0f172a; margin-bottom:18px; }
    .hero h1 span { color:#005EA2; }
    .hero p { font-size:1.05rem; line-height:1.8; color:#475569; margin-bottom:32px; }
    .hero-btns { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
    .btn-primary { background:#005EA2; color:#fff; font-weight:700; padding:14px 28px; border-radius:8px; text-decoration:none; font-size:1rem; transition:background 0.15s; }
    .btn-primary:hover { background:#004d8f; }
    .btn-text { color:#005EA2; font-weight:600; text-decoration:none; font-size:0.95rem; display:flex; align-items:center; gap:6px; }
    .btn-text:hover { color:#2D8653; }
    .hero-note { font-size:12px; color:#94a3b8; margin-top:12px; }

    /* Widget */
    .widget { background:#fff; border-radius:12px; padding:28px; border:1px solid #e2e8f0; box-shadow:0 4px 24px rgba(0,0,0,0.08); }
    .widget-title { font-size:14px; font-weight:700; color:#0f172a; margin-bottom:18px; display:flex; align-items:center; gap:8px; }
    .widget label { font-size:13px; color:#64748b; display:block; margin-bottom:6px; }
    .widget select, .widget input { width:100%; padding:10px 12px; border-radius:8px; border:1.5px solid #e2e8f0; font-size:14px; color:#0f172a; margin-bottom:14px; background:#f8fafc; }
    .widget select:focus, .widget input:focus { outline:none; border-color:#005EA2; background:#fff; }
    .widget button { width:100%; background:#005EA2; color:#fff; font-weight:700; padding:13px; border-radius:8px; border:none; font-size:1rem; cursor:pointer; }
    .widget button:hover { background:#004d8f; }
    .widget-footer { text-align:center; font-size:12px; color:#94a3b8; margin-top:12px; }

    /* Alert bar */
    .alert { background:#EFF6FF; border-left:4px solid #005EA2; padding:14px 32px; }
    .alert-inner { max-width:1100px; margin:0 auto; display:flex; align-items:center; gap:12px; font-size:14px; color:#1e40af; }

    /* Features */
    .section { padding:64px 32px; max-width:1100px; margin:0 auto; }
    .section-tag { display:inline-block; background:#EFF6FF; color:#005EA2; font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:4px 12px; border-radius:4px; margin-bottom:12px; }
    .section h2 { font-size:2rem; font-weight:800; color:#0f172a; margin-bottom:8px; }
    .section-sub { color:#64748b; font-size:1rem; max-width:560px; margin-bottom:40px; line-height:1.7; }
    .features { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:24px; }
    .feature { padding:24px; border-radius:10px; border:1.5px solid #e2e8f0; transition:all 0.2s; }
    .feature:hover { border-color:#005EA2; box-shadow:0 4px 20px rgba(0,94,162,0.1); }
    .feature-icon { width:48px; height:48px; border-radius:10px; background:#EFF6FF; display:flex; align-items:center; justify-content:center; font-size:1.5rem; margin-bottom:16px; }
    .feature h3 { font-size:1rem; font-weight:700; color:#0f172a; margin-bottom:8px; }
    .feature p { font-size:0.88rem; color:#64748b; line-height:1.6; }
    .feature-link { display:inline-flex; align-items:center; gap:4px; color:#005EA2; font-size:0.88rem; font-weight:600; text-decoration:none; margin-top:12px; }

    /* Guides */
    .guides-wrap { background:#F8FAFC; border-top:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0; padding:64px 32px; }
    .guides-inner { max-width:1100px; margin:0 auto; }
    .guide-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:20px; margin-top:40px; }
    .guide-card { background:#fff; border-radius:12px; padding:28px; border:1px solid #e2e8f0; transition:all 0.2s; }
    .guide-card:hover { box-shadow:0 8px 32px rgba(0,94,162,0.1); border-color:#73B3E7; }
    .guide-type { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#2D8653; background:#dcfce7; padding:4px 10px; border-radius:4px; margin-bottom:14px; }
    .guide-card h3 { font-size:1.05rem; font-weight:700; color:#0f172a; margin-bottom:8px; }
    .guide-card p { font-size:0.88rem; color:#64748b; line-height:1.6; margin-bottom:20px; }
    .guide-meta { display:flex; align-items:center; justify-content:space-between; }
    .guide-price { font-size:1.3rem; font-weight:800; color:#005EA2; }
    .btn-buy { background:#005EA2; color:#fff; font-weight:700; padding:10px 20px; border-radius:6px; text-decoration:none; font-size:0.9rem; }
    .btn-buy:hover { background:#004d8f; }

    /* Steps */
    .steps { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:0; margin-top:40px; position:relative; }
    .step { padding:24px; text-align:center; position:relative; }
    .step-num { width:40px; height:40px; border-radius:50%; background:#005EA2; color:#fff; font-weight:800; font-size:1rem; display:flex; align-items:center; justify-content:center; margin:0 auto 14px; }
    .step h3 { font-size:0.95rem; font-weight:700; color:#0f172a; margin-bottom:6px; }
    .step p { font-size:0.84rem; color:#64748b; }

    /* Testimonial */
    .testi-wrap { background:#005EA2; padding:48px 32px; }
    .testi-inner { max-width:800px; margin:0 auto; text-align:center; }
    .stars { color:#FFD100; font-size:1.4rem; margin-bottom:16px; letter-spacing:2px; }
    .testi-text { font-size:1.2rem; color:#fff; line-height:1.8; margin-bottom:20px; font-style:italic; }
    .testi-author { color:#73B3E7; font-size:0.9rem; }

    /* Stats */
    .stats { padding:40px 32px; background:#0f172a; }
    .stats-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:24px; text-align:center; }
    .stat-num { font-size:2rem; font-weight:800; color:#005EA2; }
    .stat-label { color:#94a3b8; font-size:0.85rem; margin-top:4px; }

    /* Footer */
    footer { background:#fff; border-top:1px solid #e2e8f0; padding:40px 32px; color:#64748b; font-size:0.85rem; }
    .footer-inner { max-width:1100px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { color:#94a3b8; text-decoration:none; }
    .footer-links a:hover { color:#005EA2; }

    .back-bar { background:#005EA2; padding:8px 32px; font-size:13px; color:#fff; display:flex; align-items:center; gap:8px; }
    .back-bar a { color:#73B3E7; text-decoration:none; font-weight:700; }
  </style>
</head>
<body>

  <div class="back-bar">
    ← <a href="/">Back to design chooser</a> &nbsp;|&nbsp; <strong>Design B — Clean & Modern</strong>
  </div>

  <div class="top-bar">
    <span>🇦🇺 Independent guide to Australia for New Zealanders</span>
    <span><a href="#">Login</a> &nbsp;·&nbsp; <a href="#">Subscribe</a></span>
  </div>

  <nav>
    <a href="#" class="logo">🦘 Go<em>Australia</em></a>
    <div class="nav-links">
      <a href="#">Visa Checker</a>
      <a href="#">Cost Calculator</a>
      <a href="#">Guides</a>
      <a href="#">Checklist</a>
      <a href="#" class="nav-cta">Get Full Access</a>
    </div>
  </nav>

  <div class="alert">
    <div class="alert-inner">
      📢 <strong>2026 update:</strong> New pathways to Australian PR for NZ citizens are now available. <a href="#" style="color:#005EA2; font-weight:600;">Read what changed →</a>
    </div>
  </div>

  <div class="hero">
    <div class="hero-inner">
      <div>
        <div class="hero-eyebrow">🇦🇺 Moving to Australia</div>
        <h1>Your move to <span>Australia</span>, made simple</h1>
        <p>Trusted visa information, plain-English guides, and real tools for New Zealanders ready to make the move. No lawyers. No confusion.</p>
        <div class="hero-btns">
          <a href="#" class="btn-primary">Check My Visa Options</a>
          <a href="#" class="btn-text">Browse free guides →</a>
        </div>
        <p class="hero-note">✓ Based on official DIBP rules &nbsp; ✓ Updated weekly &nbsp; ✓ 12,400+ NZers helped</p>
      </div>
      <div class="widget">
        <div class="widget-title">🛂 Quick Visa Check</div>
        <label>Your citizenship status</label>
        <select>
          <option>New Zealand Citizen</option>
          <option>NZ Permanent Resident</option>
          <option>Other</option>
        </select>
        <label>Purpose of move</label>
        <select>
          <option>Work & Live</option>
          <option>Study</option>
          <option>Joining partner/family</option>
          <option>Retiring</option>
        </select>
        <label>Target city</label>
        <select>
          <option>Sydney</option>
          <option>Melbourne</option>
          <option>Brisbane</option>
          <option>Perth</option>
          <option>Not sure yet</option>
        </select>
        <button>Show My Options →</button>
        <div class="widget-footer">Free · No signup required</div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-tag">Free Tools</div>
    <h2>Plan your move for free</h2>
    <p class="section-sub">Our tools cover everything from visa eligibility to cost of living. Upgrade for the full PDF guides.</p>
    <div class="features">
      <div class="feature">
        <div class="feature-icon">🛂</div>
        <h3>Visa Eligibility Checker</h3>
        <p>NZ citizens get automatic entry under the Special Category Visa. Find your path to PR.</p>
        <a href="#" class="feature-link">Check now →</a>
      </div>
      <div class="feature">
        <div class="feature-icon">💰</div>
        <h3>Cost of Living Calculator</h3>
        <p>See how far your salary goes in Sydney vs Melbourne vs Brisbane. Side-by-side comparison.</p>
        <a href="#" class="feature-link">Calculate →</a>
      </div>
      <div class="feature">
        <div class="feature-icon">📋</div>
        <h3>Document Checklist</h3>
        <p>Never miss a document. Tailored list based on your visa type, family situation, and city.</p>
        <a href="#" class="feature-link">Get list →</a>
      </div>
      <div class="feature">
        <div class="feature-icon">🏠</div>
        <h3>Suburb Finder</h3>
        <p>Find NZ-friendly suburbs in each city. Ranked by rental cost, commute time, and community.</p>
        <a href="#" class="feature-link">Find suburbs →</a>
      </div>
    </div>
  </div>

  <div class="guides-wrap">
    <div class="guides-inner">
      <div class="section-tag">Paid Guides</div>
      <h2>Step-by-step PDF guides</h2>
      <p class="section-sub">Written by NZers who've made the move. Download and keep forever.</p>
      <div class="guide-grid">
        <div class="guide-card">
          <div class="guide-type">📘 Complete Guide</div>
          <h3>Moving to Australia — The Complete Guide</h3>
          <p>From handing in your NZ notice through to opening an Aussie bank account. 68 pages, fully updated 2026.</p>
          <div class="guide-meta">
            <div class="guide-price">$27 <span style="font-size:0.8rem; color:#94a3b8; font-weight:400;">NZD</span></div>
            <a href="#" class="btn-buy">Download →</a>
          </div>
        </div>
        <div class="guide-card">
          <div class="guide-type">🛂 Visa Guide</div>
          <h3>Australian Visa Guide for NZ Citizens</h3>
          <p>SCV, 189, 190, 491 and partner visas explained in plain English. With real examples and timelines.</p>
          <div class="guide-meta">
            <div class="guide-price">$27 <span style="font-size:0.8rem; color:#94a3b8; font-weight:400;">NZD</span></div>
            <a href="#" class="btn-buy">Download →</a>
          </div>
        </div>
        <div class="guide-card">
          <div class="guide-type">💼 Jobs Guide</div>
          <h3>Getting a Job in Australia</h3>
          <p>Resume tips, salary negotiation, working rights. Everything an NZ job seeker needs to land work fast.</p>
          <div class="guide-meta">
            <div class="guide-price">$19 <span style="font-size:0.8rem; color:#94a3b8; font-weight:400;">NZD</span></div>
            <a href="#" class="btn-buy">Download →</a>
          </div>
        </div>
      </div>
      <div style="margin-top:24px; background:#EFF6FF; border-radius:12px; padding:24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; border:1.5px solid #73B3E7;">
        <div>
          <div style="font-weight:800; font-size:1.05rem; color:#0f172a;">🎁 Bundle — All 3 Guides</div>
          <div style="color:#64748b; font-size:0.9rem; margin-top:4px;">Get all three PDF guides and save $16</div>
        </div>
        <div style="display:flex; align-items:center; gap:20px;">
          <div style="text-decoration:line-through; color:#94a3b8;">$73</div>
          <div style="font-size:1.8rem; font-weight:800; color:#005EA2;">$57 NZD</div>
          <a href="#" class="btn-buy" style="background:#2D8653;">Get Bundle →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="testi-wrap">
    <div class="testi-inner">
      <div class="stars">★★★★★</div>
      <div class="testi-text">"Saved me hours of googling. The visa guide alone was worth it — I had no idea about the PR pathways available to NZers. Moved to Melbourne 3 months ago and everything went smoothly."</div>
      <div class="testi-author">— Sarah M., Auckland → Melbourne, 2025</div>
    </div>
  </div>

  <div class="stats">
    <div class="stats-inner">
      <div><div class="stat-num">12,400+</div><div class="stat-label">NZers helped</div></div>
      <div><div class="stat-num">4.9/5</div><div class="stat-label">Average rating</div></div>
      <div><div class="stat-num">3</div><div class="stat-label">PDF guides</div></div>
      <div><div class="stat-num">Weekly</div><div class="stat-label">Content updates</div></div>
    </div>
  </div>

  <footer>
    <div class="footer-inner">
      <div>
        <div style="font-size:1rem; font-weight:700; color:#0f172a; margin-bottom:4px;">🦘 GoAustralia.co.nz</div>
        <div>Independent guide. Not affiliated with the Australian Government or DIBP.</div>
      </div>
      <div class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Contact</a>
        <a href="#">Refunds</a>
      </div>
    </div>
  </footer>

</body>
</html>
