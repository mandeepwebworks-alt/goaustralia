            <td>Tax &amp; Finance Guide PDF</td>
            <td><span class="check-no">–</span></td>
            <td><span class="check-yes">✓</span> Included</td>
          </tr>
          <tr>
            <td>Australian Jobs Guide PDF</td>
            <td><span class="check-no">–</span></td>
            <td><span class="check-yes">✓</span> Included</td>
          </tr>
          <tr>
            <td>Suburb Finder</td>
            <td><span class="check-no">–</span></td>
            <td><span class="check-yes">✓</span> All suburbs</td>
          </tr>
          <tr>
            <td>Account &amp; saved progress</td>
            <td><span class="check-no">–</span></td>
            <td><span class="check-yes">✓</span> Synced to your account</td>
