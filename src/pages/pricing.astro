            <td><span class="check-yes">✓</span></td>
          </tr>
          <tr>
            <td>Move Cost Calculator</td>
            <td><span class="check-yes">✓</span></td>
            <td><span class="check-yes">✓</span></td>
          </tr>
          <tr>
            <td>Blog articles</td>
            <td><span class="check-yes">✓</span> All</td>
            <td><span class="check-yes">✓</span> All</td>
          </tr>
          <tr>
            <td>Moving Checklist</td>
            <td>First 10 steps</td>
            <td><span class="check-yes">✓</span> All 70 steps</td>
          </tr>
          <tr>
            <td>State-specific checklists</td>
            <td><span class="check-no">–</span></td>
            <td><span class="check-yes">✓</span> NSW, VIC, QLD, WA, SA</td>
