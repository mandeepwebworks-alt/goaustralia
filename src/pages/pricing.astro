---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pricing — Full Access $24.99 NZD | GoAustralia.co.nz" description="One-time payment. Get the full 70-step moving checklist, all 3 PDF guides, and every tool Kiwis need to move to Australia. No subscription, no lock-in.">
<style is:global>
  /* ── PRICING CARDS ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 44px;
  }
  .price-card {
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .price-card.featured {
    border-color: var(--amber);
    border-width: 2px;
    box-shadow: 0 4px 24px rgba(0,105,143,0.10);
  }
  .price-badge {
    display: inline-block;
    background: var(--amber);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: 3px;
    margin-bottom: 16px;
  }
  .price-tier {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink4);
    margin-bottom: 8px;
  }
  .price-amount {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 4px;
  }
  .price-amount sup {
    font-size: 1.1rem;
    font-weight: 700;
    vertical-align: top;
    line-height: 1.4;
  }
  .price-cadence {
    font-size: 12px;
    color: var(--ink4);
    margin-bottom: 16px;
  }
  .price-desc {
    font-size: 13px;
    color: var(--ink3);
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }
  .price-includes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }
  .price-includes li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    color: var(--ink);
    line-height: 1.4;
  }
  .price-includes li::before {
    content: '✓';
    color: #16A34A;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .price-includes li.dim {
    color: var(--ink4);
  }
  .price-includes li.dim::before {
    color: var(--border);
    content: '–';
    font-weight: 400;
  }
  .price-note {
    font-size: 11px;
    color: var(--ink4);
    text-align: center;
    margin-top: 10px;
  }
  .price-strike {
    text-decoration: line-through;
    color: var(--ink4);
    font-size: 1rem;
    font-weight: 400;
    margin-left: 6px;
    font-family: 'Inter', sans-serif;
  }

  /* ── COMPARISON TABLE ── */
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-top: 32px;
  }
  .compare-table thead tr {
    background: var(--dark);
    color: #fff;
  }
  .compare-table thead th {
    padding: 14px 18px;
    text-align: left;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .compare-table thead th:not(:first-child) {
    text-align: center;
  }
  .compare-table tbody tr {
    border-bottom: 1px solid var(--border);
  }
  .compare-table tbody tr:last-child {
    border-bottom: none;
  }
  .compare-table tbody tr:nth-child(even) {
    background: var(--surface);
  }
  .compare-table td {
    padding: 12px 18px;
    color: var(--ink3);
  }
  .compare-table td:first-child {
    color: var(--ink);
    font-weight: 500;
  }
  .compare-table td:not(:first-child) {
    text-align: center;
  }
  .check-yes {
    color: #16A34A;
    font-weight: 700;
    font-size: 15px;
  }
  .check-no {
    color: var(--border);
    font-size: 15px;
  }
  .compare-wrap {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  /* ── GUARANTEE BLOCK ── */
  .guarantee-block {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 24px 28px;
    margin-top: 32px;
  }
  .guarantee-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }
  .guarantee-block h4 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--ink);
  }
  .guarantee-block p {
    font-size: 13px;
    color: var(--ink3);
    line-height: 1.6;
    margin: 0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 600px) {
    .compare-table { font-size: 12px; }
    .compare-table td, .compare-table th { padding: 10px 12px; }
    .guarantee-block { flex-direction: column; text-align: center; }
  }
</style>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="shell">
    <div class="breadcrumb">
      <a href="/">← Home</a> / Pricing
    </div>
    <h1>Full Access — $24.99 NZD</h1>
    <p class="page-hero-sub">One payment. Everything you need to plan and complete your move to Australia. No subscription, no recurring charges.</p>
  </div>
</section>

<!-- PRICING CARDS -->
<section class="section">
  <div class="shell">
    <div style="text-align:center; margin-bottom: 8px;">
      <p class="sec-eye">Choose a plan</p>
      <h2 class="sec-h2" style="margin:0 auto;">Simple, honest pricing</h2>
      <p class="sec-sub" style="margin: 12px auto 0;">Start free. Upgrade once when you're ready to move. No hidden fees, no subscriptions.</p>
    </div>

    <div class="pricing-grid">

      <!-- FREE -->
      <div class="price-card reveal d1">
        <p class="price-tier">Free</p>
        <p class="price-amount">$0</p>
        <p class="price-cadence">forever, no credit card</p>
        <p class="price-desc">Access the first 10 steps of the checklist and our free tools. Good for early research.</p>
        <ul class="price-includes">
          <li>Visa Pathway Checker</li>
          <li>Move Cost Calculator</li>
          <li>Moving Checklist — first 10 steps</li>
          <li>All blog articles</li>
          <li class="dim">Full 70-step checklist</li>
          <li class="dim">All 3 PDF guides</li>
          <li class="dim">Suburb Finder</li>
          <li class="dim">State-specific advice</li>
        </ul>
        <a href="/tools/checklist" class="btn btn-ghost btn-block">Start free →</a>
      </div>

      <!-- FULL ACCESS (featured) -->
      <div class="price-card featured reveal d2">
        <div class="price-badge">Best value</div>
        <p class="price-tier">Full Access</p>
        <p class="price-amount"><sup>$</sup>24.99 <span class="price-strike">$49</span></p>
        <p class="price-cadence">one-time payment · NZD · yours forever</p>
        <p class="price-desc">The complete Kiwi moving toolkit — every step, every guide, every tool. Pay once, use it throughout your entire move.</p>
        <ul class="price-includes">
          <li>Full 70-step interactive checklist</li>
          <li>State-specific checklists (NSW, VIC, QLD, WA, SA)</li>
          <li>Kiwi Masterguide PDF</li>
          <li>Tax &amp; Finance Guide PDF</li>
          <li>Australian Jobs Guide PDF</li>
          <li>Suburb Finder — all suburbs</li>
          <li>Checklist saved to your account</li>
          <li>Free updates — content updated regularly</li>
        </ul>
        <a href="/signup" class="btn btn-primary btn-block btn-lg">Get Full Access — $24.99 →</a>
        <p class="price-note">Secured by Stripe · One-time charge · No subscription</p>
      </div>

      <!-- GUIDES ONLY -->
      <div class="price-card reveal d3">
        <p class="price-tier">Guides Only</p>
        <p class="price-amount" style="font-size:1.35rem; padding-top: 4px;">$19 – $27</p>
        <p class="price-cadence">one-time purchase per guide · NZD</p>
        <p class="price-desc">Just need one specific guide? Buy it individually. Keep the PDF forever.</p>
        <ul class="price-includes">
          <li>Kiwi Masterguide — $27 NZD</li>
          <li>Tax &amp; Finance Guide — $22 NZD</li>
          <li>Australian Jobs Guide — $19 NZD</li>
          <li>Instant PDF download</li>
          <li>Yours to keep, no expiry</li>
          <li class="dim">Full interactive checklist</li>
          <li class="dim">State-specific content</li>
          <li class="dim">Suburb Finder</li>
        </ul>
        <a href="/guides" class="btn btn-ghost btn-block">Browse guides →</a>
        <p class="price-note">One-off payment · No recurring charges</p>
      </div>

    </div>

    <!-- GUARANTEE -->
    <div class="guarantee-block reveal">
      <div class="guarantee-icon">🛡</div>
      <div>
        <h4>30-day money-back guarantee</h4>
        <p>If the checklist and guides don't help you plan your move, email us within 30 days for a full refund. No questions asked. We're confident you'll find it invaluable.</p>
      </div>
    </div>

  </div>
</section>

