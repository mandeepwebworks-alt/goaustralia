---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Direction 3 — Dark Product | GoAustralia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; background: #0c0c0e; color: #fff; -webkit-font-smoothing: antialiased; }
    a { text-decoration: none; color: inherit; }
    .shell { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

    .back-bar { background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.06); padding: 9px 32px; font-size: 13px; }
    .back-bar a { color: rgba(255,255,255,0.35); display: inline-flex; align-items: center; gap: 5px; }
    .back-bar a:hover { color: rgba(255,255,255,0.7); }

    /* NAV */
    nav { border-bottom: 1px solid rgba(255,255,255,0.06); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; }
    .logo { font-size: 0.95rem; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 8px; }
    .logo-mark { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(135deg, #22d3ee, #818cf8); flex-shrink: 0; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a { font-size: 13px; color: rgba(255,255,255,0.4); }
    .nav-links a:hover { color: rgba(255,255,255,0.8); }
    .nav-right { display: flex; align-items: center; gap: 12px; }
    .nav-sign { font-size: 13px; color: rgba(255,255,255,0.4); }
    .nav-cta { background: #fff; color: #0c0c0e; font-size: 13px; font-weight: 600; padding: 7px 16px; border-radius: 6px; }

    /* HERO */
    .hero { padding: 80px 0 0; text-align: center; }
    .hero-kicker { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 4px; padding: 5px 12px; font-size: 11px; color: rgba(255,255,255,0.45); margin-bottom: 28px; letter-spacing: 0.04em; }
    .hero h1 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 3.4rem; font-weight: 800; color: #fff; line-height: 1.05; letter-spacing: -0.04em; max-width: 640px; margin: 0 auto 18px; }
    .hero h1 em { color: #22d3ee; font-style: normal; }
    .hero p { font-size: 1rem; color: rgba(255,255,255,0.4); line-height: 1.7; max-width: 460px; margin: 0 auto 32px; font-weight: 300; }
    .hero-btns { display: flex; justify-content: center; gap: 10px; margin-bottom: 64px; }
    .btn1 { background: #22d3ee; color: #0c0c0e; font-size: 14px; font-weight: 600; padding: 12px 26px; border-radius: 6px; }
    .btn2 { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.65); font-size: 14px; padding: 12px 24px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08); }

    /* PRODUCT MOCKUP */
    .mockup-wrap { max-width: 900px; margin: 0 auto; position: relative; }
    .mockup-glow { position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 600px; height: 200px; background: radial-gradient(ellipse, rgba(34,211,238,0.08) 0%, transparent 70%); pointer-events: none; }
    .mockup { background: #111113; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px 10px 0 0; overflow: hidden; }
    .mockup-bar { background: #161618; border-bottom: 1px solid rgba(255,255,255,0.06); padding: 10px 16px; display: flex; align-items: center; gap: 8px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .mockup-title { font-size: 11px; color: rgba(255,255,255,0.2); margin-left: 10px; }
    .mockup-body { display: grid; grid-template-columns: 200px 1fr; min-height: 300px; }

    /* sidebar */
    .m-sidebar { background: #0e0e10; border-right: 1px solid rgba(255,255,255,0.05); padding: 14px 10px; }
    .m-section { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.18); padding: 10px 10px 4px; }
    .m-item { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 5px; font-size: 12px; color: rgba(255,255,255,0.32); margin-bottom: 1px; }
    .m-item.active { background: rgba(34,211,238,0.08); color: #22d3ee; }
    .m-item-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

    /* main */
    .m-main { padding: 20px 24px; }
    .m-topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .m-title { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.8); }
    .m-badge { background: rgba(34,211,238,0.1); border: 1px solid rgba(34,211,238,0.2); color: #22d3ee; font-size: 10px; padding: 3px 9px; border-radius: 4px; font-weight: 600; }
    .m-progress-row { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .m-progress-bar-wrap { flex: 1; height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; }
    .m-progress-bar { height: 4px; background: #22d3ee; border-radius: 2px; width: 45%; }
    .m-progress-text { font-size: 11px; color: rgba(255,255,255,0.25); }

    .checklist { display: flex; flex-direction: column; }
    .check { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .check:last-child { border-bottom: none; }
    .check-box { width: 16px; height: 16px; border-radius: 4px; border: 1.5px solid rgba(255,255,255,0.14); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .check-box.done { background: #22d3ee; border-color: #22d3ee; }
    .check-box.done::after { content: '✓'; font-size: 9px; color: #0c0c0e; font-weight: 700; }
    .check-text { font-size: 12px; color: rgba(255,255,255,0.5); flex: 1; }
    .check-text.done { text-decoration: line-through; color: rgba(255,255,255,0.18); }
    .check-week { font-size: 10px; color: rgba(255,255,255,0.18); flex-shrink: 0; }

    /* STATS */
    .stats { border-top: 1px solid rgba(255,255,255,0.06); padding: 20px 0; }
    .stats-inner { display: flex; justify-content: center; gap: 56px; }
    .stat strong { display: block; font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
    .stat span { font-size: 11px; color: rgba(255,255,255,0.3); }

    /* FEATURES */
    .features { padding: 72px 0; }
    .features-inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden; }
    .feat { background: #0c0c0e; padding: 28px 24px; }
    .feat-icon { font-size: 1.3rem; margin-bottom: 14px; }
    .feat h3 { font-size: 0.95rem; font-weight: 600; color: rgba(255,255,255,0.85); margin-bottom: 8px; }
    .feat p { font-size: 13px; color: rgba(255,255,255,0.3); line-height: 1.6; }

    /* SUBSCRIBE */
    .subscribe { border-top: 1px solid rgba(255,255,255,0.06); padding: 72px 0; text-align: center; }
    .subscribe h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 12px; letter-spacing: -0.03em; }
    .subscribe p { color: rgba(255,255,255,0.4); font-size: 0.95rem; margin-bottom: 10px; font-weight: 300; }
    .sub-price { font-size: 2.2rem; font-weight: 700; color: #22d3ee; margin-bottom: 28px; }
    .sub-price span { font-size: 1rem; font-weight: 300; color: rgba(255,255,255,0.3); }
    .sub-btn { display: inline-block; background: #fff; color: #0c0c0e; font-size: 15px; font-weight: 700; padding: 14px 36px; border-radius: 8px; }
    .sub-note { font-size: 12px; color: rgba(255,255,255,0.25); margin-top: 12px; }

    /* FOOTER */
    footer { border-top: 1px solid rgba(255,255,255,0.06); padding: 48px 0; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
    .footer-logo { font-size: 1rem; font-weight: 600; color: rgba(255,255,255,0.7); margin-bottom: 8px; }
    .footer-desc { font-size: 12px; color: rgba(255,255,255,0.2); line-height: 1.6; }
    .footer-col h4 { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.25); margin-bottom: 14px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-col a { font-size: 13px; color: rgba(255,255,255,0.3); }
    .footer-col a:hover { color: rgba(255,255,255,0.65); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.05); padding-top: 20px; }
    .footer-bottom p { font-size: 11px; color: rgba(255,255,255,0.15); }

    @media (max-width: 700px) {
      .hero h1 { font-size: 2.2rem; }
      .mockup-body { grid-template-columns: 1fr; }
      .m-sidebar { display: none; }
      .features-inner { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="back-bar"><a href="/designs">← Back to all designs</a></div>

<nav><div class="shell nav-inner">
  <div class="logo"><div class="logo-mark"></div>GoAustralia</div>
  <div class="nav-links"><a href="#">Visa Tools</a><a href="#">Guides</a><a href="#">Suburb Map</a><a href="#">Blog</a></div>
  <div class="nav-right"><a href="#" class="nav-sign">Sign in</a><a href="#" class="nav-cta">Get access</a></div>
</div></nav>

<section class="hero">
  <div class="shell">
    <div class="hero-kicker">Updated weekly · 12,400+ Kiwis helped</div>
    <h1>Move to Aus.<br/><em>Sorted.</em></h1>
    <p>Every visa, cost calculator, suburb guide, and checklist a Kiwi needs — in one clean tool.</p>
    <div class="hero-btns">
      <a href="#" class="btn1">Get full access →</a>
      <a href="#" class="btn2">See free tools</a>
    </div>

    <div class="mockup-wrap">
      <div class="mockup-glow"></div>
      <div class="mockup">
        <div class="mockup-bar">
          <div class="dot" style="background:#ff5f57;"></div>
          <div class="dot" style="background:#febc2e;"></div>
          <div class="dot" style="background:#28c840;"></div>
          <div class="mockup-title">GoAustralia — Moving Checklist</div>
        </div>
        <div class="mockup-body">
          <div class="m-sidebar">
            <div class="m-section">Tools</div>
            <div class="m-item active"><div class="m-item-dot"></div>Moving Checklist</div>
            <div class="m-item"><div class="m-item-dot"></div>Visa Checker</div>
            <div class="m-item"><div class="m-item-dot"></div>Cost Calculator</div>
            <div class="m-item"><div class="m-item-dot"></div>Suburb Finder</div>
            <div class="m-section">Guides</div>
            <div class="m-item"><div class="m-item-dot"></div>Masterguide PDF</div>
            <div class="m-item"><div class="m-item-dot"></div>Tax & Finance</div>
            <div class="m-item"><div class="m-item-dot"></div>Finding a Job</div>
          </div>
          <div class="m-main">
            <div class="m-topbar">
              <div class="m-title">Your Moving Checklist</div>
              <div class="m-badge">45% complete</div>
            </div>
            <div class="m-progress-row">
              <div class="m-progress-bar-wrap"><div class="m-progress-bar"></div></div>
              <div class="m-progress-text">32 of 70 tasks</div>
            </div>
            <div class="checklist">
              <div class="check"><div class="check-box done"></div><span class="check-text done">Get NZ police clearance certificate</span><span class="check-week">Done</span></div>
              <div class="check"><div class="check-box done"></div><span class="check-text done">Book removal company / shipping</span><span class="check-week">Done</span></div>
              <div class="check"><div class="check-box done"></div><span class="check-text done">Confirm Australian short-stay accommodation</span><span class="check-week">Done</span></div>
              <div class="check"><div class="check-box"></div><span class="check-text">Apply for Australian Tax File Number (TFN)</span><span class="check-week">Week 1</span></div>
              <div class="check"><div class="check-box"></div><span class="check-text">Open Australian bank account (before arrival)</span><span class="check-week">Week 1</span></div>
              <div class="check"><div class="check-box"></div><span class="check-text">Enrol in Medicare at Services Australia</span><span class="check-week">Week 1</span></div>
              <div class="check"><div class="check-box"></div><span class="check-text">Transfer NZ drivers licence to Australian licence</span><span class="check-week">Month 1</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="stats">
  <div class="shell stats-inner">
    <div class="stat"><strong>12,400+</strong><span>Kiwis helped</span></div>
    <div class="stat"><strong>4.9 / 5</strong><span>Average rating</span></div>
    <div class="stat"><strong>70 steps</strong><span>Moving checklist</span></div>
    <div class="stat"><strong>$1.99</strong><span>Full access / month</span></div>
  </div>
</section>

<section class="features">
  <div class="shell">
    <div class="features-inner">
      {[
        {icon:'🛂', title:'Visa Checker', desc:'Confirm your pathway in seconds — NZ citizen, PR, partner, or skilled. Based on public DIBP data.'},
        {icon:'💰', title:'Cost Calculator', desc:'Full moving cost estimate including shipping, bond, setup, and first month of living expenses.'},
        {icon:'🏘️', title:'Suburb Finder', desc:'Compare 200+ suburbs across Sydney, Melbourne, Brisbane, and Perth on cost, commute, and schools.'},
      ].map(f=>(
        <div class="feat"><div class="feat-icon">{f.icon}</div><h3>{f.title}</h3><p>{f.desc}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="subscribe">
  <div class="shell">
    <h2>Everything you need to move with confidence.</h2>
    <p>All tools. All guides. Weekly policy updates.</p>
    <div class="sub-price">$1.99 <span>/ month NZD</span></div>
    <a href="#" class="sub-btn">Get full access →</a>
    <div class="sub-note">Cancel anytime · Secure payment via Stripe</div>
  </div>
</section>

<footer><div class="shell">
  <div class="footer-grid">
    <div>
      <div class="footer-logo">🦘 GoAustralia</div>
      <div class="footer-desc">Independent resource for New Zealanders moving to Australia. Not affiliated with any government.</div>
    </div>
    <div class="footer-col"><h4>Tools</h4><ul>{['Visa Checker','Cost Calculator','Checklist','Suburb Finder'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
    <div class="footer-col"><h4>Guides</h4><ul>{['All Guides','Tax & Finance','Renting','Jobs'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
    <div class="footer-col"><h4>Site</h4><ul>{['About','Pricing','Privacy','Contact'].map(l=><li><a href="#">{l}</a></li>)}</ul></div>
  </div>
  <div class="footer-bottom"><p>© 2025 GoAustralia.co.nz — Independent, not part of any government.</p></div>
</div></footer>

</body>
</html>
