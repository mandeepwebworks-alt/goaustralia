---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { slug:'special-category-visa-guide', tag:'Visa & Immigration', title:'The Complete 2025 Guide to the Special Category Visa for Kiwis', date:'May 2025', read:'10 min', img:'#00205C', featured:true },
  { slug:'sydney-vs-melbourne', tag:'Cost of Living', title:'Sydney vs Melbourne: Where Should a Kiwi Move in 2025?', date:'May 2025', read:'7 min', img:'#1a3d5c', featured:false },
  { slug:'kiwi-tax-australia', tag:'Tax & Finance', title:'Do Kiwis Pay Tax in Australia? Your First-Year Guide', date:'Apr 2025', read:'8 min', img:'#0f2b1f', featured:false },
  { slug:'renting-australia-guide', tag:'Renting', title:'How to Rent a Property in Australia as a New Arrival', date:'Apr 2025', read:'6 min', img:'#2d1a0a', featured:false },
  { slug:'in-demand-jobs-australia', tag:'Jobs', title:'In-Demand Roles for Kiwis in Australia Right Now', date:'Apr 2025', read:'5 min', img:'#1a1a3d', featured:false },
  { slug:'medicare-enrolment-guide', tag:'Medicare', title:'How to Enrol in Medicare as a New Zealand Citizen', date:'Mar 2025', read:'5 min', img:'#0f2040', featured:false },
  { slug:'medicare-2025-update', tag:'Policy Update', title:'Medicare Access for Kiwis — What Changed in 2025', date:'Mar 2025', read:'4 min', img:'#1B7A3E', featured:false },
  { slug:'brisbane-real-story', tag:'Real Story', title:'"We Moved to Brisbane with $8k — Here\'s What We Wish We Knew"', date:'Feb 2025', read:'8 min', img:'#2d0a0a', featured:false },
  { slug:'kiwisaver-australia', tag:'Finance', title:'What Happens to Your KiwiSaver When You Move to Australia?', date:'Feb 2025', read:'6 min', img:'#1a2a0a', featured:false },
];

const featured = posts.find(p => p.featured)!;
const rest = posts.filter(p => !p.featured);
---
<Layout title="Blog — Moving Guides & News for Kiwis | GoAustralia.co.nz" description="News, guides and real stories for New Zealanders moving to Australia. Updated regularly.">
<style is:global>
  .blog-featured-strip { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--border-lt); border-radius: 8px; overflow: hidden; margin-bottom: 40px; }
  .bfs-img { min-height: 300px; display: flex; align-items: flex-end; padding: 24px; position: relative; }
  .bfs-feat-tag { position: absolute; top: 14px; left: 14px; background: var(--blue); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 2px; }
  .bfs-content { background: var(--surf2); padding: 30px 28px; display: flex; flex-direction: column; justify-content: center; }
  .bfs-cat { font-size: 10px; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .bfs-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.3rem; font-weight: 800; color: var(--navy); line-height: 1.25; margin-bottom: 10px; }
  .bfs-meta { font-size: 12px; color: var(--txt3); margin-bottom: 16px; }
  .bfs-desc { font-size: 14px; color: var(--txt2); line-height: 1.65; }
  .bfs-link { display: inline-flex; align-items: center; gap: 5px; margin-top: 16px; font-size: 13px; font-weight: 600; color: var(--blue); }
  .category-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  @media (max-width: 860px) { .blog-featured-strip { grid-template-columns: 1fr; } }
</style>

<div class="page-hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">Home</a> › Blog</div>
    <h1>Moving to Australia — News & Guides</h1>
    <p class="page-hero-sub">Policy updates, step-by-step guides and real stories from Kiwis who've made the move.</p>
  </div>
</div>

<section class="section">
  <div class="shell">

    <!-- Featured -->
    <div class="blog-featured-strip">
      <div class="bfs-img" style={`background:${featured.img};`}>
        <div class="bfs-feat-tag">Featured</div>
        <div style="font-size:1rem;font-weight:700;color:#fff;line-height:1.3;">{featured.title}</div>
      </div>
      <div class="bfs-content">
        <div class="bfs-cat">{featured.tag}</div>
        <div class="bfs-title">{featured.title}</div>
        <div class="bfs-meta">{featured.date} · {featured.read} read</div>
        <p class="bfs-desc">Most NZ citizens don't need a traditional visa — but the Special Category Visa has limits that most people don't discover until they need Medicare or try to sponsor a family member.</p>
        <a href={`/blog/${featured.slug}`} class="bfs-link">Read full guide →</a>
      </div>
    </div>

    <!-- Filter pills -->
    <div class="category-filter">
      {['All','Visa & Immigration','Tax & Finance','Renting','Jobs','Medicare','Policy Update','Real Story','Finance'].map(c => (
        <span class="pill" style={c === 'All' ? 'background:var(--navy);color:#fff;border-color:var(--navy);' : ''}>{c}</span>
      ))}
    </div>

    <!-- Grid -->
    <div class="blog-grid">
      {rest.map(p => (
        <a href={`/blog/${p.slug}`} class="blog-card reveal">
          <div class="blog-img" style={`background:${p.img};`}></div>
          <div class="blog-body">
            <span class="blog-tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <div class="blog-meta">{p.date} · {p.read} read</div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<!-- Subscribe nudge -->
<section class="subscribe-section">
  <div class="shell subscribe-grid">
    <div>
      <div class="sec-eye">Stay Updated</div>
      <div class="sec-h2">Weekly Updates for Kiwis in Aus</div>
      <p class="sec-sub">Policy changes, cost of living updates and tips from Kiwis already in Australia — every week, no spam.</p>
      <ul class="feature-list">
        <li>Policy & visa changes explained in plain English</li>
        <li>Rental market updates by city</li>
        <li>Real stories and tips from the community</li>
        <li>Exclusive subscriber Q&As</li>
      </ul>
    </div>
    <div>
      <div class="sub-form-card">
        <div class="sub-form-title">Get the weekly update</div>
        <input type="email" placeholder="Your email address" class="sub-input" />
        <a href="/signup" class="sub-btn">Subscribe — $1.99/month →</a>
        <div class="sub-terms">Includes all guides & tools · Cancel anytime</div>
      </div>
    </div>
  </div>
</section>

</Layout>
