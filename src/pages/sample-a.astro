---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GoAustralia — Moving Guides & Visa Tools for Kiwis</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --brand:     #00205C;
      --blue:      #005EA5;
      --accent:    #005EA5;
      --accent-lt: #E8F1FB;
      --surface:   #F0F4F8;
      --surf2:     #F8F9FA;
      --bg:        #FFFFFF;
      --border:    #C8D3DC;
      --border-lt: #E4EBF2;
      --txt:       #1D1D1D;
      --txt2:      #525252;
      --txt3:      #888888;
      --gold:      #C9860A;
      --gold-lt:   #FEF5E0;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #fff; color: var(--txt); -webkit-font-smoothing: antialiased; }
    h1,h2,h3,h4 { letter-spacing: -0.025em; color: var(--brand); }
    a { text-decoration: none; color: inherit; }
    .shell { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
    .narrow { max-width: 760px; margin: 0 auto; padding: 0 28px; }

    /* ── TOP STRIP ── */
    .top-strip { background: var(--brand); text-align: center; padding: 9px 20px; }
    .top-strip p { font-size: 13px; color: rgba(255,255,255,0.82); }
    .top-strip a { color: #93c5fd; text-decoration: underline; }

    /* ── HEADER ── */
    .header { background: #fff; border-bottom: 1px solid var(--border-lt); position: sticky; top: 0; z-index: 100; }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
    .logo { display: flex; flex-direction: column; gap: 1px; }
    .logo-eye { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--blue); }
    .logo-name { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--brand); letter-spacing: -0.02em; }
    .nav-links { display: flex; align-items: center; gap: 1px; }
    .nav-links a { font-size: 14px; font-weight: 500; color: var(--txt); padding: 8px 13px; border-radius: 6px; transition: background 0.15s; }
    .nav-links a:hover { background: var(--surf2); }
    .btn-primary { background: var(--accent); color: #fff !important; font-weight: 600 !important; padding: 9px 20px !important; border-radius: 20px; margin-left: 8px; transition: background 0.15s !important; font-size: 14px !important; }
    .btn-primary:hover { background: #004a85 !important; }

    /* ── HERO BAND ── */
    .hero-band { background: var(--surface); border-bottom: 1px solid var(--border-lt); padding: 56px 0 52px; }
    .hero-grid { display: grid; grid-template-columns: 1fr 380px; gap: 48px; align-items: start; }
    .hero-eye { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--blue); margin-bottom: 12px; }
    .hero h1 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.6rem; font-weight: 800; line-height: 1.15; color: var(--brand); margin-bottom: 18px; }
    .hero p { font-size: 1.05rem; color: var(--txt2); line-height: 1.7; margin-bottom: 14px; }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
    .btn-hero { background: var(--accent); color: #fff; font-size: 15px; font-weight: 600; padding: 13px 26px; border-radius: 6px; transition: background 0.15s; }
    .btn-hero:hover { background: #004a85; }
    .btn-ghost { border: 1.5px solid var(--border); color: var(--txt); font-size: 14px; font-weight: 500; padding: 12px 22px; border-radius: 6px; transition: background 0.15s; }
    .btn-ghost:hover { background: var(--surf2); }

    /* ── VISA WIDGET ── */
    .widget { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 24px; }
    .widget h3 { font-size: 1rem; font-weight: 700; color: var(--brand); margin-bottom: 16px; }
    .widget label { display: block; font-size: 12px; font-weight: 600; color: var(--txt2); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.07em; }
    .widget select, .widget input { width: 100%; border: 1.5px solid var(--border); border-radius: 5px; padding: 10px 12px; font-size: 14px; color: var(--txt); background: #fff; margin-bottom: 14px; outline: none; font-family: inherit; }
    .widget select:focus, .widget input:focus { border-color: var(--accent); }
    .widget-btn { width: 100%; background: var(--accent); color: #fff; border: none; padding: 13px; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background 0.15s; font-family: inherit; }
    .widget-btn:hover { background: #004a85; }
    .widget-note { font-size: 11px; color: var(--txt3); margin-top: 10px; text-align: center; line-height: 1.5; }

    /* ── STATS BAR ── */
    .stats-bar { background: var(--brand); padding: 20px 0; }
    .stats-inner { display: flex; gap: 0; justify-content: space-evenly; flex-wrap: wrap; }
    .stat { text-align: center; padding: 8px 20px; }
    .stat-num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.6rem; font-weight: 800; color: #fff; }
    .stat-lbl { font-size: 12px; color: rgba(255,255,255,0.55); margin-top: 3px; }

    /* ── ALERT ── */
    .alert { background: var(--gold-lt); border-bottom: 2px solid #fbbf24; padding: 13px 0; }
    .alert-inner { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #78350f; }
    .alert-inner strong { font-weight: 700; }

    /* ── SECTION BASE ── */
    section { padding: 64px 0; }
    .sec-eye { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--blue); margin-bottom: 10px; }
    .sec-h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--brand); margin-bottom: 14px; }
    .sec-sub { font-size: 1rem; color: var(--txt2); line-height: 1.7; max-width: 580px; margin-bottom: 40px; }

    /* ── TOOLS GRID ── */
    .tools-section { background: var(--surf2); border-top: 1px solid var(--border-lt); border-bottom: 1px solid var(--border-lt); }
    .tools-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .tool-card { background: #fff; border: 1px solid var(--border-lt); border-radius: 8px; padding: 22px 18px; transition: box-shadow 0.15s, transform 0.15s; cursor: pointer; }
    .tool-card:hover { box-shadow: 0 4px 16px rgba(15,39,69,0.1); transform: translateY(-2px); }
    .tool-icon { font-size: 1.8rem; margin-bottom: 12px; }
    .tool-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--brand); margin-bottom: 6px; }
    .tool-card p { font-size: 13px; color: var(--txt2); line-height: 1.5; }
    .tool-link { display: inline-block; margin-top: 12px; font-size: 12px; font-weight: 600; color: var(--accent); }

    /* ── TOPICS ── */
    .topic-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .pill { display: inline-flex; align-items: center; gap: 7px; background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 20px; padding: 8px 16px; font-size: 13px; font-weight: 500; color: var(--txt); transition: background 0.15s, border-color 0.15s; cursor: pointer; }
    .pill:hover { background: var(--accent-lt); border-color: var(--accent); color: var(--accent); }

    /* ── BLOG ── */
    .blog-section { border-top: 1px solid var(--border-lt); }
    .blog-featured { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch; margin-bottom: 40px; background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 10px; overflow: hidden; }
    .blog-featured-img { background: linear-gradient(135deg, var(--brand), var(--blue)); min-height: 260px; display: flex; align-items: flex-end; padding: 24px; position: relative; }
    .featured-tag { position: absolute; top: 16px; left: 16px; background: var(--accent); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 10px; border-radius: 4px; }
    .blog-featured-content { padding: 28px 24px; display: flex; flex-direction: column; justify-content: center; }
    .blog-meta { font-size: 12px; color: var(--txt3); margin-bottom: 12px; }
    .blog-featured-content h2 { font-size: 1.35rem; font-weight: 700; color: var(--brand); line-height: 1.3; margin-bottom: 12px; }
    .blog-featured-content p { font-size: 14px; color: var(--txt2); line-height: 1.6; }
    .read-more { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 13px; font-weight: 600; color: var(--accent); }
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .blog-card { border: 1px solid var(--border-lt); border-radius: 8px; overflow: hidden; background: #fff; transition: box-shadow 0.15s; cursor: pointer; }
    .blog-card:hover { box-shadow: 0 4px 16px rgba(15,39,69,0.08); }
    .card-img { height: 140px; }
    .card-body { padding: 18px; }
    .card-tag { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--blue); margin-bottom: 8px; }
    .card-body h3 { font-size: 0.95rem; font-weight: 700; color: var(--brand); line-height: 1.35; margin-bottom: 8px; }
    .card-meta { font-size: 12px; color: var(--txt3); }

    /* ── GUIDES ── */
    .guides-section { background: var(--brand); padding: 72px 0; }
    .guides-section .sec-eye { color: #93c5fd; }
    .guides-section .sec-h2 { color: #fff; }
    .guides-section .sec-sub { color: rgba(255,255,255,0.6); }
    .guides-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .guide-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 24px; transition: background 0.15s; cursor: pointer; }
    .guide-card:hover { background: rgba(255,255,255,0.1); }
    .guide-price { font-size: 11px; font-weight: 700; color: #93c5fd; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
    .guide-card h3 { font-size: 1.05rem; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 10px; }
    .guide-card p { font-size: 13px; color: rgba(255,255,255,0.55); line-height: 1.5; margin-bottom: 16px; }
    .guide-btn { display: inline-block; background: rgba(255,255,255,0.12); color: #fff; font-size: 12px; font-weight: 600; padding: 8px 16px; border-radius: 5px; border: 1px solid rgba(255,255,255,0.2); transition: background 0.15s; }
    .guide-btn:hover { background: rgba(255,255,255,0.2); }

    /* ── HOW IT WORKS ── */
    .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .step { text-align: center; }
    .step-num { width: 42px; height: 42px; border-radius: 50%; background: var(--accent-lt); color: var(--accent); font-size: 1rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .step h3 { font-size: 0.95rem; font-weight: 700; color: var(--brand); margin-bottom: 8px; }
    .step p { font-size: 13px; color: var(--txt2); line-height: 1.5; }

    /* ── SUBSCRIBE ── */
    .subscribe-section { background: var(--accent-lt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 60px 0; }
    .subscribe-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    .price-tag { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.2rem; font-weight: 900; color: var(--brand); margin: 12px 0; }
    .price-tag span { font-size: 1rem; font-weight: 500; color: var(--txt2); }
    .feature-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 20px 0; }
    .feature-list li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--txt); }
    .feature-list li::before { content: '✓'; color: var(--accent); font-weight: 700; font-size: 15px; }
    .sub-btn { display: inline-block; background: var(--accent); color: #fff; font-size: 16px; font-weight: 700; padding: 16px 36px; border-radius: 6px; transition: background 0.15s; }
    .sub-btn:hover { background: #004a85; }

    /* ── REVIEWS ── */
    .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .review-card { background: var(--surf2); border: 1px solid var(--border-lt); border-radius: 8px; padding: 24px; }
    .stars { color: #f59e0b; font-size: 1rem; margin-bottom: 12px; }
    .review-card p { font-size: 14px; color: var(--txt2); line-height: 1.6; margin-bottom: 14px; }
    .reviewer { font-size: 13px; font-weight: 600; color: var(--brand); }
    .reviewer span { font-size: 12px; font-weight: 400; color: var(--txt3); }

    /* ── FAQ ── */
    .faq-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--border-lt); border-radius: 8px; overflow: hidden; }
    details { border-bottom: 1px solid var(--border-lt); }
    details:last-child { border-bottom: none; }
    details summary { padding: 18px 22px; font-size: 15px; font-weight: 600; color: var(--brand); cursor: pointer; display: flex; justify-content: space-between; align-items: center; user-select: none; }
    details summary::after { content: '+'; font-size: 1.3rem; color: var(--txt3); }
    details[open] summary::after { content: '−'; }
    details .faq-body { padding: 0 22px 18px; font-size: 14px; color: var(--txt2); line-height: 1.7; }

    /* ── CTA BAND ── */
    .cta-band { background: var(--brand); padding: 60px 0; text-align: center; }
    .cta-band h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 14px; }
    .cta-band p { color: rgba(255,255,255,0.65); font-size: 1rem; margin-bottom: 28px; }
    .cta-band .sub-btn { background: #fff; color: var(--brand); }
    .cta-band .sub-btn:hover { background: var(--accent-lt); }

    /* ── FOOTER ── */
    .footer { background: #0f1c2b; }
    .footer-strip { border-bottom: 1px solid rgba(255,255,255,0.08); padding: 18px 0; }
    .footer-strip p { font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.6; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding: 52px 0 40px; }
    .footer-brand-eye { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #5ce0d0; }
    .footer-brand-name { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.2rem; font-weight: 800; color: #fff; margin: 4px 0 12px; }
    .footer-brand-desc { font-size: 13px; color: rgba(255,255,255,0.38); line-height: 1.6; }
    .footer-col-head { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,0.5); margin-bottom: 14px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.4); transition: color 0.15s; }
    .footer-links a:hover { color: rgba(255,255,255,0.75); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding: 16px 0; }
    .footer-bottom p { font-size: 11px; color: rgba(255,255,255,0.22); }

    /* ── BACK BAR ── */
    .back-bar { background: var(--surf2); border-bottom: 1px solid var(--border-lt); padding: 10px 0; }
    .back-bar a { font-size: 13px; color: var(--txt2); display: inline-flex; align-items: center; gap: 6px; }
    .back-bar a:hover { color: var(--accent); }

    @media (max-width: 900px) {
      .hero-grid, .blog-featured, .subscribe-inner { grid-template-columns: 1fr; }
      .tools-grid { grid-template-columns: repeat(2, 1fr); }
      .cards-grid, .guides-grid, .steps-grid, .reviews-grid { grid-template-columns: 1fr 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .tools-grid, .cards-grid, .guides-grid, .steps-grid, .reviews-grid, .footer-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 2rem; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<!-- Back -->
<div class="back-bar">
  <div class="shell"><a href="/">← Back to design chooser</a></div>
</div>

<!-- Top Strip -->
<div class="top-strip">
  <p>Independent guide for Kiwis moving to Australia — not affiliated with the Australian Government. <a href="#">About this site</a></p>
</div>

<!-- Header -->
<header class="header">
  <div class="shell header-inner">
    <div class="logo">
      <span class="logo-eye">🦘 GoAustralia</span>
      <span class="logo-name">Moving Guides for Kiwis</span>
    </div>
    <nav class="nav-links">
      <a href="#">Visa Tools</a>
      <a href="#">Guides</a>
      <a href="#">Cost Calculator</a>
      <a href="#">Suburbs</a>
      <a href="#">Blog</a>
      <a href="#" class="btn-primary">Get Full Access</a>
    </nav>
  </div>
</header>

<!-- Hero Band -->
<section class="hero-band">
  <div class="shell">
    <div class="hero-grid">
      <div class="hero">
        <div class="hero-eye">🦘 Trusted by 12,000+ Kiwis</div>
        <h1>Your Complete Guide to Moving from New Zealand to Australia</h1>
        <p>Visa pathways, cost breakdowns, suburb guides, tax tips, and checklists — everything a Kiwi needs before and after landing in Aus.</p>
        <p>Join thousands who have used our tools and guides to make the move with confidence.</p>
        <div class="hero-btns">
          <a href="#" class="btn-hero">Check Your Visa Pathway →</a>
          <a href="#" class="btn-ghost">Browse Free Guides</a>
        </div>
      </div>
      <!-- Visa Widget -->
      <div class="widget reveal d2">
        <h3>🔍 Find Your Visa Pathway</h3>
        <label>Current situation</label>
        <select>
          <option>NZ citizen (Special Category)</option>
          <option>NZ PR holder</option>
          <option>Partner of NZ citizen</option>
          <option>Skilled worker</option>
        </select>
        <label>Moving for</label>
        <select>
          <option>Work & Career</option>
          <option>Family reunification</option>
          <option>Study</option>
          <option>Retirement</option>
        </select>
        <label>Target state</label>
        <select>
          <option>New South Wales (Sydney)</option>
          <option>Victoria (Melbourne)</option>
          <option>Queensland (Brisbane)</option>
          <option>Western Australia (Perth)</option>
          <option>South Australia (Adelaide)</option>
        </select>
        <button class="widget-btn">Check Visa Options →</button>
        <p class="widget-note">Free tool — no signup required. Based on public DIBP information.</p>
      </div>
    </div>
  </div>
</section>

<!-- Stats Bar -->
<div class="stats-bar">
  <div class="shell stats-inner">
    <div class="stat"><div class="stat-num">12,400+</div><div class="stat-lbl">Kiwis helped</div></div>
    <div class="stat"><div class="stat-num">4.9 ★</div><div class="stat-lbl">Average rating</div></div>
    <div class="stat"><div class="stat-num">3 Guides</div><div class="stat-lbl">Step-by-step PDFs</div></div>
    <div class="stat"><div class="stat-num">Updated</div><div class="stat-lbl">Weekly — 2025</div></div>
    <div class="stat"><div class="stat-num">$1.99</div><div class="stat-lbl">Full access / month</div></div>
  </div>
</div>

<!-- Alert Banner -->
<div class="alert">
  <div class="shell alert-inner">
    <span>⚠️</span>
    <span><strong>2025 Update:</strong> Australia has expanded the Special Category Visa (SCV) pathway — Kiwis may now qualify for Medicare sooner. <a href="#" style="color:var(--gold);text-decoration:underline;">Read the latest changes →</a></span>
  </div>
</div>

<!-- Free Tools -->
<section class="tools-section">
  <div class="shell">
    <div class="sec-eye">Free Tools</div>
    <div class="sec-h2">Plan Your Move Online</div>
    <div class="tools-grid" style="margin-top:32px;">
      {[
        { icon:'🛂', title:'Visa Checker', desc:'Find your visa pathway based on your NZ status and situation.', link:'Check now' },
        { icon:'💰', title:'Cost Calculator', desc:'Estimate your moving costs — shipping, bond, setup, and living.', link:'Calculate' },
        { icon:'📋', title:'Moving Checklist', desc:'70-step checklist from notice to first day in Aus. Trackable online.', link:'Open checklist' },
        { icon:'🏘️', title:'Suburb Finder', desc:'Compare suburbs by cost, commute, schools, and Kiwi community.', link:'Find suburbs' },
      ].map(t => (
        <div class="tool-card reveal">
          <div class="tool-icon">{t.icon}</div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
          <span class="tool-link">{t.link} →</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Explore Topics -->
<section>
  <div class="shell">
    <div class="sec-eye">Browse by Topic</div>
    <div class="sec-h2">Everything You Need to Know</div>
    <p class="sec-sub">From your first day in Aus to getting your tax sorted — find guides on every aspect of the move.</p>
    <div class="topic-pills">
      {['🛂 Visas & Pathways','💼 Jobs & Work Rights','🏠 Renting & Buying','🏥 Medicare & Health',
        '📦 Shipping & Moving','🎓 Schools & Education','💰 Tax & Finance','🐾 Pets to Australia',
        '🚗 Driving Licence','🏦 Banking & Super','📱 Phone & Utilities','🌏 Citizenship Path'].map(t => (
        <span class="pill">{t}</span>
      ))}
    </div>
  </div>
</section>

<!-- Blog -->
<section class="blog-section">
  <div class="shell">
    <div class="sec-eye">Latest from the Blog</div>
    <div class="sec-h2">News, Guides & Real Stories</div>

    <!-- Featured -->
    <div class="blog-featured reveal">
      <div class="blog-featured-img" style="background:linear-gradient(135deg,#00205C,#005EA5);">
        <div class="featured-tag">Featured</div>
        <div>
          <div style="font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:6px;">Visa Guide · 8 min read</div>
