---
import Base from '../layouts/Base.astro';
---
<Base
  title="Moving to Australia Guides — Free Resources for Kiwis | GoAustralia"
  description="Free guides and resources for New Zealanders moving to Australia. Checklists, cost breakdowns, visa info, city comparisons, and everything you need to plan your trans-Tasman move."
>

  <section class="page-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="/">Home</a> / Guides</div>
      <h1>Moving to Australia — Free Guides</h1>
      <p class="page-hero-sub">Everything Kiwis need to know about moving across the Tasman. Practical, no-nonsense guides written for New Zealanders.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="guide-grid">
        <a href="/moving-checklist" class="guide-card">
          <div class="guide-card-img" style="font-size:52px;color:var(--amber)">&#9776;</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">Essential Guide</span>
            <h3 class="guide-card-title">Moving to Australia from NZ — Complete Checklist</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 12 min read</p>
          </div>
        </a>
        <a href="/moving-costs" class="guide-card">
          <div class="guide-card-img" style="font-size:44px;color:var(--amber);font-family:var(--font-display);font-weight:800">$</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">Cost Guide</span>
            <h3 class="guide-card-title">How Much Does It Cost to Move from NZ to Australia?</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 10 min read</p>
          </div>
        </a>
        <a href="/shipping-to-australia-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:44px;color:var(--amber)">&#128674;</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">Shipping Guide</span>
            <h3 class="guide-card-title">Shipping to Australia from NZ — How It Works</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 10 min read</p>
          </div>
        </a>
        <a href="/sydney-vs-melbourne-vs-brisbane" class="guide-card">
          <div class="guide-card-img" style="font-size:44px;color:var(--amber);font-family:var(--font-display);font-weight:800">vs</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Sydney vs Melbourne vs Brisbane — Which City?</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 8 min read</p>
          </div>
        </a>
        <a href="/moving-to-sydney-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:36px;color:var(--amber);font-family:var(--font-display);font-weight:800">SYD</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Moving to Sydney from NZ — Complete Guide</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 9 min read</p>
          </div>
        </a>
        <a href="/moving-to-melbourne-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:36px;color:var(--amber);font-family:var(--font-display);font-weight:800">MEL</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Moving to Melbourne from NZ — Complete Guide</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 9 min read</p>
          </div>
        </a>
        <a href="/moving-to-brisbane-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:36px;color:var(--amber);font-family:var(--font-display);font-weight:800">BNE</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Moving to Brisbane from NZ — Complete Guide</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 9 min read</p>
          </div>
        </a>
        <a href="/moving-to-gold-coast-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:36px;color:var(--amber);font-family:var(--font-display);font-weight:800">GC</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Moving to the Gold Coast from NZ</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 8 min read</p>
          </div>
        </a>
        <a href="/moving-to-perth-from-nz" class="guide-card">
          <div class="guide-card-img" style="font-size:36px;color:var(--amber);font-family:var(--font-display);font-weight:800">PER</div>
          <div class="guide-card-body">
            <span class="guide-card-tag">City Guide</span>
            <h3 class="guide-card-title">Moving to Perth from NZ — Complete Guide</h3>
            <p class="guide-card-meta">Updated June 2026 &middot; 8 min read</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section style="padding:clamp(56px,7vw,96px) var(--pad-x)">
    <div style="max-width:1080px;margin:0 auto;background:var(--amber);border-radius:var(--r-panel);padding:clamp(40px,5vw,68px);text-align:center;overflow:hidden">
      <h2 class="display" style="font-size:clamp(30px,4.6vw,52px);letter-spacing:-.03em;margin-bottom:16px;color:var(--ink)">Ready to make your move?</h2>
      <p style="font-size:clamp(17px,2vw,20px);line-height:1.5;color:#4a3a12;max-width:520px;margin:0 auto 30px">Get free quotes from verified NZ to Australia movers.</p>
      <a href="/get-quotes" class="btn btn-dark btn-lg">Get Free Quotes &rarr;</a>
    </div>
  </section>

</Base>
